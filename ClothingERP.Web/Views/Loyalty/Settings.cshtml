@model ClothingERP.Application.DTOs.LoyaltySettingsDto
@{
    ViewData["Title"] = "Loyalty Program Settings";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-gem me-2 text-primary"></i>Loyalty Program Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Loyalty Settings</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-sliders me-2 text-primary"></i>Configuration</span>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="isEnabledDisplay"
                    @(Model.IsEnabled ? "checked" : "") disabled />
                    <label class="form-check-label small" for="isEnabledDisplay">
                        @(Model.IsEnabled ? "Enabled" : "Disabled")
                    </label>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Settings" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsEnabled" id="IsEnabled" />
                        <label class="form-check-label fw-semibold" for="IsEnabled">
                            Loyalty Program Active
                        </label>
                        <div class="text-muted small">যখন off থাকবে, কেউ points earn/redeem করতে পারবে না।</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Points Earned per $1 Spent</label>
                            <div class="input-group">
                                <input asp-for="PointsPerDollarSpent" class="form-control" type="number" step="0.1" min="0" />
                                <span class="input-group-text bg-light">points / $</span>
                            </div>
                            <small class="text-muted">যেমন: 1 দিলে $1 খরচে 1 point পাবে</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Point Value (Redemption Rate)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="PointValueInDollars" class="form-control" type="number" step="0.001" min="0" />
                                <span class="input-group-text bg-light">/ point</span>
                            </div>
                            <small class="text-muted">যেমন: 0.01 দিলে 100 points = $1.00 discount</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Minimum Points to Redeem</label>
                            <input asp-for="MinPointsToRedeem" class="form-control" type="number" min="0" />
                            <small class="text-muted">এই সংখ্যার কম points থাকলে redeem করতে পারবে না</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Birthday Bonus Points</label>
                            <input asp-for="BirthdayBonusPoints" class="form-control" type="number" min="0" />
                            <small class="text-muted">প্রতি জন্মদিনে স্বয়ংক্রিয় বোনাস</small>
                        </div>
                    </div>

                    <!-- Live Preview -->
                    <div class="mt-4 p-3 rounded" style="background:var(--clz-cream);border:1px solid var(--border);">
                        <div class="fw-semibold small mb-2"><i class="bi bi-eye me-1"></i>Preview</div>
                        <div class="small text-muted" id="previewText">
                            $100 কেনাকাটায় <span class="fw-bold text-dark">@((int)(100 * Model.PointsPerDollarSpent))</span> points পাবে,
                            যার মূল্য <span class="fw-bold" style="color:var(--clz-gold-deep);">$@((100 * Model.PointsPerDollarSpent * Model.PointValueInDollars).ToString("N2"))</span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save Settings
                    </button>
                </form>
            </div>
        </div>

        <!-- Birthday Bonus Manual Trigger -->
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold"><i class="bi bi-cake2 me-2 text-primary"></i>Birthday Bonuses</div>
                    <div class="text-muted small">আজকের জন্মদিনের customer দের bonus points দিন</div>
                </div>
                <button class="btn btn-outline-primary" onclick="runBirthdayBonus()">
                    <i class="bi bi-gift me-1"></i>Run Now
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tok = () => $('[name=__RequestVerificationToken]').val();

        function runBirthdayBonus() {
            $.post('/Loyalty/RunBirthdayBonus', { __RequestVerificationToken: tok() }, d => {
                if (d.success) toastr.success(d.message);
                else toastr.error(d.message);
            });
        }

        // Live preview update
        $('#PointsPerDollarSpent, #PointValueInDollars').on('input', function() {
            const pps = parseFloat($('#PointsPerDollarSpent').val()) || 0;
            const pv  = parseFloat($('#PointValueInDollars').val()) || 0;
            const points = Math.floor(100 * pps);
            const value   = (100 * pps * pv).toFixed(2);
            $('#previewText').html(`$100 কেনাকাটায় <span class="fw-bold text-dark">${points}</span> points পাবে, যার মূল্য <span class="fw-bold" style="color:var(--clz-gold-deep);">$${value}</span>`);
        });
    </script>
}