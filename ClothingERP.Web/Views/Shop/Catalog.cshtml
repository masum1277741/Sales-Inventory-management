@model PagedResultDto<StorefrontProductDto>
@{
    Layout = "_ShopLayout"; ViewData["Title"] = "Shop All"; var filter = (ProductFilterDto)ViewBag.Filter;
}

<script>window.__rates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Rates));</script>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="serif fw-bold mb-0">Shop All</h2>
        <select class="form-select form-select-sm" style="width:200px;" onchange="location.href='?sortBy='+this.value">
            <option value="Newest">Newest First</option>
            <option value="PriceLowHigh">Price: Low to High</option>
            <option value="PriceHighLow">Price: High to Low</option>
        </select>
    </div>

    <div class="row g-4">
        @foreach (var p in Model.Items)
        {
            <div class="col-6 col-md-3">
                <a href="/Shop/Product/@p.ProductId" class="text-decoration-none text-dark">
                    <div class="ratio ratio-1x1 mb-2" style="background:#f7f5f1;border-radius:8px;overflow:hidden;">
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@p.ImagePath" class="w-100 h-100" style="object-fit:cover;" />
                        }
                        else
                        {

                            <div class="d-flex align-items-center justify-content-center h-100"><i class="bi bi-image text-muted" style="font-size:2rem;"></i></div>
                        }
                        @if (!p.InStock)
                        {
                            <span class="badge bg-dark position-absolute top-0 end-0 m-2">Sold Out</span>
                        }
                    </div>
                    <div class="small text-muted">@p.CategoryName</div>
                    <div class="fw-semibold">@p.Name</div>
                    <div class="fw-bold price-display" data-usd="@p.MinPriceUSD">$@p.MinPriceUSD.ToString("N2")</div>
                </a>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5 d-flex justify-content-center">
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="?page=@i">@i</a></li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.price-display').forEach(el => {
        el.textContent = fmtPrice(parseFloat(el.dataset.usd));
        });
    </script>
}