@model IEnumerable<CustomerLedgerDto>
@{
    ViewData["Title"] = "Customer Ledger";
    var customer = (CustomerDto)ViewBag.Customer;
    var items = Model.ToList();
    decimal totalDebit = (decimal)(ViewBag.TotalDebit ?? 0m);
    decimal totalCredit = (decimal)(ViewBag.TotalCredit ?? 0m);
    decimal balance = (decimal)(ViewBag.Balance ?? 0m);
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Ledger — @customer.Name</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
                <li class="breadcrumb-item active">Ledger</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success btn-sm" onclick="openPaymentModal()">
            <i class="bi bi-cash me-1"></i>Receive Payment
        </button>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="mx-auto mb-2" style="width:56px;height:56px;border-radius:50%;background:#ede9fe;display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:700;color:#4c1d95;">
                @customer.Name[0].ToString().ToUpper()
            </div>
            <h6 class="fw-bold mb-0">@customer.Name</h6>
            <small class="text-muted">@(customer.PhoneNumber ?? "—")</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card h-100">
            <div class="text-muted small mb-1">Total Debit (Sales)</div>
            <h4 class="fw-bold mb-0" style="color:#7f1d1d;">$@totalDebit.ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card h-100">
            <div class="text-muted small mb-1">Total Credit (Received)</div>
            <h4 class="fw-bold mb-0" style="color:#065f46;">$@totalCredit.ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card h-100 border-start border-3 @(balance > 0 ? "border-danger" : "border-success")">
            <div class="text-muted small mb-1">Current Due</div>
            <h4 class="fw-bold mb-0" style="color:@(balance > 0 ? "#7f1d1d" : "#065f46");">
                $@balance.ToString("N2")
            </h4>
        </div>
    </div>
</div>

<!-- Date Filter -->
<form asp-action="Ledger" asp-route-id="@customer.Id" method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3 d-flex gap-2 align-items-center flex-wrap">
        <i class="bi bi-calendar-range text-muted"></i>
        <input type="date" name="from" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.FromDate" />
        <span class="text-muted small">to</span>
        <input type="date" name="to" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.ToDate" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Filter</button>
        <a asp-action="Ledger" asp-route-id="@customer.Id" class="btn btn-sm btn-light border">Reset</a>
        <span class="ms-auto text-muted small">@items.Count entries</span>
    </div>
</form>

<!-- Ledger Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="ledgerTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="50">#</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Reference</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end pe-4">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var entry in items)
                    {
                        var (cls, lbl) = entry.EntryType switch
                        {
                            "Invoice" => ("bg-danger", "Invoice"),
                            "Payment" => ("bg-success", "Payment"),
                            "Return" => ("bg-info", "Return"),
                            _ => ("bg-secondary", "—")
                        };
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td class="small">
                                @entry.EntryDate.ToString("dd MMM yyyy")
                                <div class="text-muted" style="font-size:.7rem;">@entry.EntryDate.ToString("HH:mm")</div>
                            </td>
                            <td><span class="badge @cls px-2">@lbl</span></td>
                            <td class="small">@(entry.Description ?? "—")</td>
                            <td><code class="small">@(entry.ReferenceNumber ?? "—")</code></td>
                            <td class="text-end fw-semibold" style="color:#7f1d1d;">@(entry.Debit > 0 ? "$" + entry.Debit.ToString("N2") : "—")</td>
                            <td class="text-end fw-semibold" style="color:#065f46;">@(entry.Credit > 0 ? "$" + entry.Credit.ToString("N2") : "—")</td>
                            <td class="text-end fw-bold pe-4" style="color:@(entry.Balance > 0 ? "#7f1d1d" : "#065f46");">
                                $@entry.Balance.ToString("N2")
                            </td>
                        </tr>
                    }

                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x d-block mb-2 fs-2"></i>No ledger entries found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="payModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-cash me-2 text-success"></i>Receive Payment</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">$</span>
                        <input type="number" class="form-control" id="pmAmt" value="@balance.ToString("F2")" min="0.01" step="0.01" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <input type="text" class="form-control" id="pmDesc" value="Cash payment received" />
                </div>
                <div>
                    <label class="form-label fw-semibold">Reference</label>
                    <input type="text" class="form-control" id="pmRef" placeholder="Optional" />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success px-4" onclick="submitPay()">Save</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(function () { initDataTable('#ledgerTable', { order: [[1,'desc']], pageLength: 50 }); });
        const tok = () => $('[name=__RequestVerificationToken]').val();

        function openPaymentModal() { new bootstrap.Modal('#payModal').show(); }

        function submitPay() {
            $.post('/Customer/AddPayment', {
                customerId: @customer.Id, amount: parseFloat($('#pmAmt').val()),
                description: $('#pmDesc').val(), reference: $('#pmRef').val(),
                __RequestVerificationToken: tok()
            }, d => {
                if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); }
                else toastr.error(d.message);
            });
        }
    </script>
}