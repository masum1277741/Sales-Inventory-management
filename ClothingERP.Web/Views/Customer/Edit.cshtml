@model UpdateCustomerDto
@{ ViewData["Title"] = "Edit Customer"; var c = (CustomerDto)ViewBag.Customer; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit — @c.Name</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol></nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Ledger" asp-route-id="@c.Id" class="btn btn-outline-info">
            <i class="bi bi-journal-text me-1"></i>View Ledger
        </a>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row">
    <!-- Profile -->
    <div class="col-md-3 mb-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="mx-auto mb-3" style="width:80px;height:80px;border-radius:50%;background:#e8f0fe;display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:700;color:#4f7cff;">
                @c.Name[0].ToString().ToUpper()
            </div>
            <h6 class="fw-bold mb-0">@c.Name</h6>
            <p class="text-muted small mb-2">@c.GroupName</p>
            @if (c.CurrentBalance > 0)
            {
                <div class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-3 py-2">
                    Due: ৳@c.CurrentBalance.ToString("N2")
                </div>
            }
            else
            {
                <div class="badge bg-success bg-opacity-15 text-success rounded-pill px-3 py-2">No Due</div>
            }
            <hr />
            <small class="text-muted">Purchase Total<br/><strong>৳@c.TotalPurchaseAmount.ToString("N0")</strong></small>
        </div>
    </div>

    <!-- Form -->
    <div class="col-md-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-pencil me-2 text-primary"></i>Update Information</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@c.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerGroupId" class="form-label fw-semibold">Group</label>
                            <select asp-for="CustomerGroupId" class="form-select select2">
                                @foreach (var g in (IEnumerable<CustomerGroupDto>)ViewBag.Groups)
                                {
                                    @if(g.Id==Model.CustomerGroupId)
                                    {
                                        <option value="@g.Id" selected>@g.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@g.Id">@g.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NIDNumber" class="form-label fw-semibold">NID</label>
                            <input asp-for="NIDNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Profile Photo</label>
                            <input type="file" name="profileImage" class="form-control" accept="image/*" />
                            <small class="text-muted">Leave blank to keep current.</small>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">Active Account</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>$(function(){ $('select.select2').select2({ theme:'bootstrap-5', width:'100%' }); });</script>
}