@model SalesInvoiceDto
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.InvoiceNumber</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Courier New', monospace; font-size: 12px; color: #000; padding: 10px; max-width: 300px; margin: 0 auto; }
        .header { text-align: center; border-bottom: 2px dashed #000; padding-bottom: 10px; margin-bottom: 10px; }
        .header h2 { font-size: 18px; letter-spacing: 2px; }
        .header p { font-size: 11px; color: #333; }
        .info-row { display: flex; justify-content: space-between; margin-bottom: 2px; font-size: 11px; }
        .divider { border-top: 1px dashed #000; margin: 8px 0; }
        table { width: 100%; border-collapse: collapse; margin: 8px 0; }
        th, td { padding: 3px 2px; font-size: 11px; }
        th { border-bottom: 1px solid #000; font-weight: bold; }
        .text-right { text-align: right; }
        .total-row { font-weight: bold; font-size: 13px; border-top: 2px solid #000; padding-top: 4px; }
        .footer { text-align: center; border-top: 2px dashed #000; padding-top: 10px; margin-top: 10px; font-size: 10px; }
        @@media print {
            body { max-width: 100%; padding: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="text-align:center;margin-bottom:10px;">
        <button onclick="window.print()" style="padding:6px 20px;background:#4f7cff;color:#fff;border:none;border-radius:6px;cursor:pointer;">
            🖨️ Print Receipt
        </button>
        <button onclick="window.close()" style="padding:6px 20px;background:#eee;border:none;border-radius:6px;cursor:pointer;margin-left:8px;">
            Close
        </button>
    </div>

    <div class="header">
        <h2>CLOTHING ERP</h2>
        <p>Sales Invoice</p>
        <p>@DateTime.Now.ToString("dd/MM/yyyy")</p>
    </div>

    <div class="info-row"><span>Invoice:</span><span>@Model.InvoiceNumber</span></div>
    <div class="info-row"><span>Date:</span><span>@Model.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</span></div>
    <div class="info-row"><span>Customer:</span><span>@Model.CustomerName</span></div>
    @if (Model.IsCredit) { <div class="info-row"><span>Type:</span><span>CREDIT SALE</span></div> }

    <div class="divider"></div>

    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th class="text-right">Qty</th>
                <th class="text-right">Price</th>
                <th class="text-right">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName<br/><span style="font-size:10px;color:#555;">@item.SizeName / @item.ColorName</span></td>
                    <td class="text-right">@item.Quantity</td>
                    <td class="text-right">@item.UnitPrice.ToString("N0")</td>
                    <td class="text-right">@item.TotalAmount.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="divider"></div>

    <div class="info-row"><span>Sub Total:</span><span>৳@Model.SubTotal.ToString("N2")</span></div>
    @if (Model.DiscountAmount > 0) {
        <div class="info-row"><span>Discount:</span><span>-৳@Model.DiscountAmount.ToString("N2")</span></div>
    }
    @if (Model.TaxAmount > 0) {
        <div class="info-row"><span>Tax:</span><span>৳@Model.TaxAmount.ToString("N2")</span></div>
    }

    <div class="divider"></div>

    <div class="info-row total-row"><span>TOTAL:</span><span>৳@Model.TotalAmount.ToString("N2")</span></div>
    <div class="info-row"><span>Paid:</span><span>৳@Model.PaidAmount.ToString("N2")</span></div>
    @if (Model.DueAmount > 0) {
        <div class="info-row"><span>DUE:</span><span>৳@Model.DueAmount.ToString("N2")</span></div>
    }

    @if (Model.Payments.Any()) {
        <div class="divider"></div>
        @foreach (var p in Model.Payments) {
            <div class="info-row"><span>@p.PaymentMethod:</span><span>৳@p.Amount.ToString("N2")</span></div>
        }
    }

    <div class="footer">
        <p>Thank you for shopping!</p>
        <p>Visit us again.</p>
    </div>

    <script>window.onload = () => setTimeout(() => window.print(), 300);</script>
</body>
</html>