                }

                .pg-btn.active {
                    background: var(--black);
                    border-color: var(--black);
                    color: #fff;
                }

                .pg-btn:disabled {
                    opacity: .4;
                    cursor: not-allowed;
                }

            .pg-info {
                font-size: .72rem;
