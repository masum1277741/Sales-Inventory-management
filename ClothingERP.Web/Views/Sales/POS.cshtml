@{
    Layout = null;
    decimal rateBDT = (decimal)(ViewBag.RateBDT ?? 110m);
    decimal rateMVR = (decimal)(ViewBag.RateMVR ?? 15.42m);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>POS — CLOZEY ERP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
            /* ══ Variables ═══════════════════════════════════════════════════════ */
            :root {
                --hdr: 50px;
                --tabs: 54px;
                --black: #0a0a0a;
                --gold: #c9a96e;
                --gold-d: #a6845a;
                --cream: #f5f2ed;
                --border: #e8e3da;
                --card: #ffffff;
                --text: #1a1a1a;
                --muted: #6b7280;
                --success: #065f46;
                --success-bg: #d1fae5;
                --danger: #7f1d1d;
                --danger-bg: #fee2e2;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html, body {
                height: 100%;
                font-family: 'Segoe UI', sans-serif;
                background: var(--cream);
                overflow: hidden;
            }

            /* ══ POS Header ══════════════════════════════════════════════════════ */
            .pos-hdr {
                height: var(--hdr);
                background: var(--black);
                display: flex;
                align-items: center;
                padding: 0 12px;
                gap: 10px;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 200;
            }

            .pos-logo {
                height: 30px;
                filter: brightness(0) invert(1);
                opacity: .88;
                flex-shrink: 0;
            }

            .pos-search-wrap {
                flex: 1;
                max-width: 380px;
                position: relative;
            }

            .pos-search-input {
                width: 100%;
                background: rgba(255,255,255,.10);
                border: 1px solid rgba(255,255,255,.18);
                border-radius: 8px;
                color: #fff;
                padding: 6px 36px 6px 12px;
                font-size: .85rem;
                outline: none;
                transition: background .18s, border-color .18s;
            }

                .pos-search-input:focus {
                    background: rgba(255,255,255,.16);
                    border-color: var(--gold);
                }

                .pos-search-input::placeholder {
                    color: rgba(255,255,255,.4);
                }

            .pos-search-icon {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255,255,255,.4);
                font-size: .9rem;
                pointer-events: none;
            }

            .pos-hdr-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .pos-hdr-btn {
                padding: 5px 10px;
                border-radius: 6px;
                font-size: .73rem;
                font-weight: 500;
                text-decoration: none;
                transition: background .15s;
                border: 1px solid rgba(255,255,255,.18);
                color: rgba(255,255,255,.75);
                background: transparent;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 4px;
            }

                .pos-hdr-btn:hover {
                    background: rgba(255,255,255,.10);
                    color: #fff;
                }

                .pos-hdr-btn.gold {
                    background: var(--gold);
                    border-color: var(--gold);
                    color: #000;
                }

                    .pos-hdr-btn.gold:hover {
                        background: var(--gold-d);
                    }

            .pos-date {
                color: rgba(255,255,255,.5);
                font-size: .73rem;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            /* ══ Desktop 3-Column Body ═══════════════════════════════════════════ */
            .pos-body {
                position: fixed;
                top: var(--hdr);
                left: 0;
                right: 0;
                bottom: 0;
                display: flex;
                gap: 8px;
                padding: 8px;
                overflow: hidden;
            }

            /* Left — Products */
            .pos-products-panel {
                width: 300px;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            /* Center — Cart */
            .pos-cart-panel {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 6px;
                min-width: 0;
            }

            /* Right — Payment */
            .pos-payment-panel {
                width: 270px;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            /* ══ Panel Card ══════════════════════════════════════════════════════ */
            .pcard {
                background: var(--card);
                border-radius: 10px;
                border: 1px solid var(--border);
                overflow: hidden;
            }

            .pcard-hdr {
                padding: 8px 12px;
                border-bottom: 1px solid var(--border);
                font-size: .8rem;
                font-weight: 600;
                color: var(--text);
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #faf9f7;
                flex-shrink: 0;
            }

            .pcard-body {
                overflow-y: auto;
                flex: 1;
            }

                .pcard-body::-webkit-scrollbar {
                    width: 3px;
                }

                .pcard-body::-webkit-scrollbar-thumb {
                    background: var(--border);
                    border-radius: 2px;
                }

            .panel-tabs {
                display: flex;
                gap: 4px;
                padding: 0 8px;
            }

            .panel-tab {
                flex: 1;
                padding: 6px 10px;
                border-radius: 7px;
                font-size: .74rem;
                font-weight: 600;
                cursor: pointer;
                transition: all .15s;
            }

                .panel-tab.active {
                    background: var(--black) !important;
                    border-color: var(--black) !important;
                    color: #fff !important;
                }

         .panel-section {
    display: none;
    flex-direction: column;
    flex: 1;
    min-height: 0;     
    overflow: hidden;
}

.panel-section.active {
    display: flex;       /* block নয়, flex */
}

            /* ══ Product / Bundle Grid ════════════════════════════════════════════ */
            .product-grid,
            .bundle-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 6px;
                padding: 8px;
            }

            .product-card,
            .bundle-card {
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 8px;
                cursor: pointer;
                transition: all .15s;
                background: #fff;
                position: relative;
                overflow: hidden;
            }

                .product-card:hover,
                .bundle-card:hover {
                    border-color: var(--gold);
                    box-shadow: 0 2px 8px rgba(201,169,110,.2);
                    transform: translateY(-1px);
                }

                .product-card:active,
                .bundle-card:active {
                    transform: scale(.97);
                }

                .product-card.out-of-stock {
                    opacity: .5;
                    cursor: not-allowed;
                }

            .bundle-card {
                border-left: 3px solid var(--gold);
            }

                .bundle-card.out-of-stock {
                    opacity: .55;
                    cursor: not-allowed;
                }

            .pc-icon,
            .bc-icon {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: linear-gradient(135deg, var(--black), #333);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--gold);
                font-size: 1rem;
                margin-bottom: 6px;
                flex-shrink: 0;
            }

            .pc-name,
            .bc-name {
                font-size: .75rem;
                font-weight: 600;
                color: var(--text);
                line-height: 1.2;
                margin-bottom: 3px;
                overflow: hidden;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
            }

            .pc-variant,
            .bc-meta {
                font-size: .65rem;
                color: var(--muted);
                margin-bottom: 4px;
                display: flex;
                gap: 3px;
                align-items: center;
                flex-wrap: wrap;
            }

            .pc-color-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                border: 1px solid rgba(0,0,0,.15);
                flex-shrink: 0;
            }

            .pc-price,
            .bc-price {
                font-size: .8rem;
                font-weight: 700;
                color: var(--black);
                line-height: 1;
            }

            .pc-price-sub,
            .bc-price-sub {
                font-size: .62rem;
                color: var(--muted);
                margin-top: 1px;
            }

            .pc-stock,
            .bc-stock {
                position: absolute;
                top: 4px;
                right: 4px;
                font-size: .58rem;
                font-weight: 600;
                padding: 1px 5px;
                border-radius: 10px;
            }

                .pc-stock.in, .bc-stock.in {
                    background: var(--success-bg);
                    color: var(--success);
                }

                .pc-stock.out, .bc-stock.out {
                    background: var(--danger-bg);
                    color: var(--danger);
                }

            .pc-add,
            .bc-add {
                margin-top: 6px;
                width: 100%;
                padding: 4px;
                border: 1px solid var(--black);
                border-radius: 5px;
                background: var(--black);
                color: #fff;
                font-size: .7rem;
                font-weight: 600;
                cursor: pointer;
                transition: background .15s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 3px;
            }

                .pc-add:hover,
                .bc-add:hover {
                    background: var(--gold-d);
                    border-color: var(--gold-d);
                }

            .bundle-summary {
                font-size: .62rem;
                color: var(--muted);
                line-height: 1.25;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
                min-height: 2.4em;
            }

            /* ══ Pagination ══════════════════════════════════════════════════════ */
            .pos-pagination {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
                padding: 8px;
                border-top: 1px solid var(--border);
                flex-shrink: 0;
                background: #faf9f7;
            }

            .pg-btn {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: 1px solid var(--border);
                background: #fff;
                color: var(--text);
                font-size: .75rem;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all .15s;
            }

                .pg-btn:hover {
                    border-color: var(--gold);
                    color: var(--gold-d);
                }

                .pg-btn.active {
                    background: var(--black);
                    border-color: var(--black);
                    color: #fff;
                }

                .pg-btn:disabled {
                    opacity: .4;
                    cursor: not-allowed;
                }

            .pg-info {
                font-size: .72rem;
                color: var(--muted);
                padding: 0 4px;
            }

            /* ══ Cart Table ══════════════════════════════════════════════════════ */
            .cart-wrap {
                overflow-y: auto;
                flex: 1;
            }

            .cart-empty {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 30px 20px;
                color: var(--muted);
                height: 100%;
                min-height: 120px;
            }

                .cart-empty i {
                    font-size: 2.5rem;
                    margin-bottom: 8px;
                    opacity: .4;
                }

                .cart-empty p {
                    font-size: .82rem;
                    margin: 0;
                }

            .cart-table {
                width: 100%;
                border-collapse: collapse;
            }

                .cart-table th {
                    font-size: .66rem;
                    text-transform: uppercase;
                    color: var(--muted);
                    padding: 6px 8px;
                    background: #faf9f7;
                    border-bottom: 1px solid var(--border);
                    font-weight: 600;
                    letter-spacing: .04em;
                }

                .cart-table td {
                    padding: 5px 8px;
                    border-bottom: 1px solid #f5f3ef;
                    vertical-align: middle;
                }

                .cart-table tr:last-child td {
                    border-bottom: none;
                }

            .ci-name {
                font-size: .78rem;
                font-weight: 600;
                color: var(--text);
            }

            .ci-meta {
                font-size: .66rem;
                color: var(--muted);
            }

            .qty-btn {
                width: 20px;
                height: 20px;
                border: none;
                border-radius: 4px;
                background: #f0ebe0;
                color: var(--text);
                font-size: .82rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: background .12s;
            }

                .qty-btn:hover {
                    background: var(--black);
                    color: #fff;
                }

            .qty-input {
                width: 42px;
                text-align: center;
                border: 1px solid var(--border);
                border-radius: 5px;
                padding: 1px 2px;
                font-size: .8rem;
                font-weight: 700;
                color: var(--text);
            }

            .rm-btn {
                width: 20px;
                height: 20px;
                border: none;
                border-radius: 50%;
                background: var(--danger-bg);
                color: var(--danger);
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: .75rem;
                transition: background .12s;
            }

                .rm-btn:hover {
                    background: var(--danger);
                    color: #fff;
                }

            /* ══ Customer ════════════════════════════════════════════════════════ */
            .pos-pagination {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
                padding: 8px;
                border-top: 1px solid var(--border);
                flex-shrink: 0;
