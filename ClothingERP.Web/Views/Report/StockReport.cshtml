@model IEnumerable<StockListDto>
@{
    ViewData["Title"] = "Stock Report"; var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-archive me-2 text-primary"></i>Stock Report</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                <li class="breadcrumb-item active">Stock</li>
            </ol>
        </nav>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i>Print</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm col-6"><div class="stat-card"><div class="text-muted small">Total Variants</div><h4 class="fw-bold mb-0">@ViewBag.TotalItems</h4></div></div>
    <div class="col-sm col-6"><div class="stat-card"><div class="text-muted small">In Stock</div><h4 class="fw-bold text-success mb-0">@ViewBag.InStock</h4></div></div>
    <div class="col-sm col-6"><div class="stat-card"><div class="text-muted small">Low Stock</div><h4 class="fw-bold text-warning mb-0">@ViewBag.LowStock</h4></div></div>
    <div class="col-sm col-6"><div class="stat-card"><div class="text-muted small">Out of Stock</div><h4 class="fw-bold text-danger mb-0">@ViewBag.OutOfStock</h4></div></div>
    <div class="col-sm col-6"><div class="stat-card"><div class="text-muted small">Total Value</div><h4 class="fw-bold text-primary mb-0">৳@((decimal)ViewBag.TotalValue).ToString("N0")</h4></div></div>
</div>

<div class="row g-4 mb-4">
    <!-- Category Breakdown Chart -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-pie-chart me-2 text-primary"></i>Value by Category</span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center" style="min-height:260px;">
                <canvas id="categoryChart" style="max-height:240px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Category Table -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-table me-2 text-primary"></i>Category Breakdown</span>
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th class="ps-4">Category</th><th class="text-center">Items</th><th class="text-end pe-4">Stock Value</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in (dynamic)ViewBag.CategoryBreakdown)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold small">@cat.Category</td>
                                <td class="text-center"><span class="badge bg-primary bg-opacity-10 text-primary">@cat.Count</span></td>
                                <td class="text-end fw-semibold pe-4">৳@((decimal)cat.Value).ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Stock Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <span class="fw-semibold"><i class="bi bi-list-ul me-2 text-primary"></i>Item-wise Stock</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="stockTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Product</th>
                        <th>Variant</th>
                        <th>Category</th>
                        <th class="text-center" style="min-width:140px;">Stock Level</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Value</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var s in items)
                    {
                        var pct = s.ReorderPoint > 0 ? (int)Math.Min(s.Quantity / (s.ReorderPoint * 2) * 100, 100) : (s.Quantity > 0 ? 100 : 0);
                        var bc = s.Status == "Out of Stock" ? "danger" : s.Status == "Low Stock" ? "warning" : "success";
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td><div class="fw-semibold small">@s.ProductName</div><code style="font-size:.7rem;">@s.ProductSKU</code></td>
                            <td><span class="badge bg-secondary me-1" style="font-size:.6rem;">@s.SizeName</span><span class="small text-muted">@s.ColorName</span></td>
                            <td class="small text-muted">@s.CategoryName</td>
                            <td>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold small text-@bc">@s.Quantity.ToString("N0")</span>
                                    <span class="text-muted" style="font-size:.7rem;">Min:@s.ReorderPoint</span>
                                </div>
                                <div class="progress" style="height:5px;">
                                    <div class="progress-bar bg-@bc" style="width:@pct%"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(bc == "danger" ? "bg-danger" : bc == "warning" ? "bg-warning text-dark" : "bg-success") bg-opacity-15 @(bc == "danger" ? "text-danger" : bc == "warning" ? "text-warning" : "text-success") rounded-pill px-2">@s.Status</span>
                            </td>
                            <td class="text-end fw-semibold small pe-4">৳@s.StockValue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() { initDataTable('#stockTable', { order:[[5,'asc']], pageLength:50 }); });

        const labels = @Html.Raw(ViewBag.ChartLabels);
        const data   = @Html.Raw(ViewBag.ChartData);
        const colors = ['#4f7cff','#43a047','#f57c00','#e53935','#8e24aa','#00897b','#1e88e5','#fdd835'];

        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: colors, borderWidth: 2, borderColor: '#fff' }] },
            options: { responsive:true, plugins: { legend: { position:'bottom', labels: { boxWidth:12, padding:16 } } }, cutout:'60%' }
        });
    </script>
}