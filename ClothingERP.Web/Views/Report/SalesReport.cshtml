@model IEnumerable<SalesInvoiceListDto>
@{
    ViewData["Title"] = "Sales Report";
    var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Sales Report</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                <li class="breadcrumb-item active">Sales</li>
            </ol>
        </nav>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer me-1"></i>Print
    </button>
</div>

<!-- Date Filter -->
<form asp-action="SalesReport" method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body py-2 px-3 d-flex gap-2 align-items-center flex-wrap">
        <i class="bi bi-calendar-range text-muted"></i>
        <input type="date" name="fromDate" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.FromDate" />
        <span class="text-muted small">to</span>
        <input type="date" name="toDate" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.ToDate" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Generate</button>
        <a asp-action="SalesReport" class="btn btn-sm btn-light border">Reset</a>
        <span class="ms-auto text-muted small">@ViewBag.FromDate — @ViewBag.ToDate</span>
    </div>
</form>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm col-6">
        <div class="stat-card"><div class="text-muted small">Total Revenue</div><h4 class="fw-bold text-primary mb-0">৳@((decimal)ViewBag.TotalRevenue)</h4></div>
    </div>
    <div class="col-sm col-6">
        <div class="stat-card"><div class="text-muted small">Amount Collected</div><h4 class="fw-bold text-success mb-0">৳@((decimal)ViewBag.TotalPaid)</h4></div>
    </div>
    <div class="col-sm col-6">
        <div class="stat-card"><div class="text-muted small">Outstanding Due</div><h4 class="fw-bold text-danger mb-0">৳@((decimal)ViewBag.TotalDue)</h4></div>
    </div>
    <div class="col-sm col-6">
        <div class="stat-card"><div class="text-muted small">Invoices</div><h4 class="fw-bold mb-0">@ViewBag.InvoiceCount</h4></div>
    </div>
    <div class="col-sm col-6">
        <div class="stat-card"><div class="text-muted small">Avg. Sale</div><h4 class="fw-bold mb-0">৳@((decimal)ViewBag.AvgSale)</h4></div>
    </div>
</div>

<!-- Chart -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <span class="fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Daily Sales Trend</span>
    </div>
    <div class="card-body p-3">
        <canvas id="salesChart" style="max-height:280px;"></canvas>
    </div>
</div>

<!-- Invoices Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between">
        <span class="fw-semibold"><i class="bi bi-receipt me-2 text-primary"></i>Invoice Details</span>
        <span class="text-muted small">@items.Count invoices</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="salesTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="50">#</th>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Due</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var inv in items)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@inv.Id" class="fw-semibold text-primary small text-decoration-none">@inv.InvoiceNumber</a></td>
                            <td class="small">@inv.CustomerName</td>
                            <td class="small text-muted">@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end fw-semibold">৳@inv.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-success">৳@inv.PaidAmount.ToString("N2")</td>
                            <td class="text-end @(inv.DueAmount > 0 ? "text-danger fw-bold" : "text-muted")">@(inv.DueAmount > 0 ? "৳" + inv.DueAmount.ToString("N2") : "—")</td>
                            <td class="text-center">
                                @{
                                    var (cls, lbl) = inv.Status switch
                                    {
                                        "FullyPaid" => ("bg-success", "Paid"),
                                        "PartiallyPaid" => ("bg-warning text-dark", "Partial"),
                                        _ => ("bg-info", "Confirmed")
                                    };
                                }
                                <span class="badge @cls rounded-pill px-2">@lbl</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="ps-4">Total</td>
                        <td class="text-end">৳@items.Sum(i => i.TotalAmount).ToString("N2")</td>
                        <td class="text-end text-success">৳@items.Sum(i => i.PaidAmount).ToString("N2")</td>
                        <td class="text-end text-danger">৳@items.Sum(i => i.DueAmount).ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() { initDataTable('#salesTable', { order:[[3,'desc']], pageLength:25 }); });

        const labels = @Html.Raw(ViewBag.ChartLabels);
        const data   = @Html.Raw(ViewBag.ChartData);

        new Chart(document.getElementById('salesChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Daily Sales (৳)',
                    data,
                    backgroundColor: 'rgba(79,124,255,0.7)',
                    borderColor: '#4f7cff',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => '৳' + v.toLocaleString() } }
                }
            }
        });
    </script>
}