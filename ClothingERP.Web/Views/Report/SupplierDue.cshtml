@model IEnumerable<SupplierListDto>
@{
    ViewData["Title"] = "Supplier Due Report"; var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-truck me-2 text-primary"></i>Supplier Due Report</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                <li class="breadcrumb-item active">Supplier Due</li>
            </ol>
        </nav>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i>Print</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card border-start border-3 border-danger">
            <div class="text-muted small">Total Payable</div>
            <h3 class="fw-bold text-danger mb-0">৳@((decimal)ViewBag.TotalDue)</h3>
        </div>
    </div>
    <div class="col-sm-4"><div class="stat-card"><div class="text-muted small">Suppliers with Due</div><h4 class="fw-bold mb-0">@ViewBag.TotalCount</h4></div></div>
    <div class="col-sm-4"><div class="stat-card"><div class="text-muted small">Avg. Due</div><h4 class="fw-bold mb-0">৳@(items.Any() ? (items.Sum(s => s.CurrentBalance) / items.Count).ToString("N0") : "0")</h4></div></div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="supplierDueTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Supplier</th>
                        <th>Contact</th>
                        <th>Phone</th>
                        <th class="text-end">Payable Amount</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var s in items)
                    {
                        var duePct = (decimal)ViewBag.TotalDue > 0 ? s.CurrentBalance / (decimal)ViewBag.TotalDue * 100 : 0;
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td><div class="fw-semibold small">@s.CompanyName</div><div class="text-muted" style="font-size:.72rem;">@s.Email</div></td>
                            <td class="small">@s.ContactPerson</td>
                            <td class="small">@s.PhoneNumber</td>
                            <td class="text-end">
                                <div class="fw-bold text-danger">৳@s.CurrentBalance.ToString("N2")</div>
                                <div class="progress mt-1" style="height:4px;width:80px;margin-left:auto;">
                                    <div class="progress-bar bg-danger" style="width:@Math.Min(duePct, 100).ToString("F0")%"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Supplier" asp-action="Ledger" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-journal-text me-1"></i>Ledger
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr><td colspan="4" class="ps-4">Total</td><td class="text-end text-danger">৳@items.Sum(s => s.CurrentBalance).ToString("N2")</td><td></td></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>$(function() { initDataTable('#supplierDueTable', { order:[[4,'desc']] }); });</script>
}