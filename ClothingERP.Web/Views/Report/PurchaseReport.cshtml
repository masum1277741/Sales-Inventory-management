@model IEnumerable<PurchaseOrderListDto>
@{
    ViewData["Title"] = "Purchase Report"; var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-bag-check me-2 text-primary"></i>Purchase Report</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                <li class="breadcrumb-item active">Purchase</li>
            </ol>
        </nav>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i>Print</button>
</div>

<form asp-action="PurchaseReport" method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body py-2 px-3 d-flex gap-2 align-items-center flex-wrap">
        <i class="bi bi-calendar-range text-muted"></i>
        <input type="date" name="fromDate" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.FromDate" />
        <span class="text-muted small">to</span>
        <input type="date" name="toDate" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.ToDate" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Generate</button>
        <a asp-action="PurchaseReport" class="btn btn-sm btn-light border">Reset</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-3"><div class="stat-card"><div class="text-muted small">Total Orders</div><h4 class="fw-bold mb-0">@ViewBag.OrderCount</h4></div></div>
    <div class="col-sm-3"><div class="stat-card"><div class="text-muted small">Total Amount</div><h4 class="fw-bold text-primary mb-0">৳@((decimal)ViewBag.TotalAmount).ToString("N0")</h4></div></div>
    <div class="col-sm-3"><div class="stat-card"><div class="text-muted small">Amount Paid</div><h4 class="fw-bold text-success mb-0">৳@((decimal)ViewBag.TotalPaid).ToString("N0")</h4></div></div>
    <div class="col-sm-3"><div class="stat-card"><div class="text-muted small">Outstanding Due</div><h4 class="fw-bold text-danger mb-0">৳@((decimal)ViewBag.TotalDue).ToString("N0")</h4></div></div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="poTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="50">#</th>
                        <th>PO #</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Due</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var po in items)
                    {
                        var (sCls, sLbl) = po.Status switch
                        {
                            "Draft" => ("bg-warning text-dark", "Draft"),
                            "Approved" => ("bg-info", "Approved"),
                            "PartiallyReceived" => ("bg-primary", "Partial"),
                            "FullyReceived" => ("bg-success", "Received"),
                            _ => ("bg-secondary", "Cancelled")
                        };
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td><a asp-controller="Purchase" asp-action="Details" asp-route-id="@po.Id" class="fw-semibold text-primary small text-decoration-none">@po.PONumber</a></td>
                            <td class="small">@po.SupplierName</td>
                            <td class="small text-muted">@po.OrderDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center"><span class="badge @sCls rounded-pill px-2">@sLbl</span></td>
                            <td class="text-end fw-semibold">৳@po.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-success">৳@po.PaidAmount.ToString("N2")</td>
                            <td class="text-end @(po.DueAmount > 0 ? "text-danger fw-bold" : "text-muted")">@(po.DueAmount > 0 ? "৳" + po.DueAmount.ToString("N2") : "—")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="5" class="ps-4">Total</td>
                        <td class="text-end">৳@items.Sum(p => p.TotalAmount).ToString("N2")</td>
                        <td class="text-end text-success">৳@items.Sum(p => p.PaidAmount).ToString("N2")</td>
                        <td class="text-end text-danger">৳@items.Sum(p => p.DueAmount).ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>$(function() { initDataTable('#poTable', { order:[[3,'desc']], pageLength:25 }); });</script>
}