@using ClothingERP.Web.Models
@model List<BarcodeLabelViewModel>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Barcode Labels</title>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        * { box-sizing:border-box; margin:0; padding:0; }

        body {
            font-family:'Segoe UI', sans-serif;
            background:#f5f5f5;
            padding:12px;
        }

        /* ── Print Controls (hidden when printing) ── */
        .print-controls {
            text-align:center; padding:12px; margin-bottom:16px;
            background:#fff; border-radius:8px;
            box-shadow:0 1px 4px rgba(0,0,0,.1);
        }
        .btn-print {
            background:#4f7cff; color:#fff; border:none;
            padding:10px 32px; border-radius:8px;
            font-size:1rem; font-weight:600; cursor:pointer;
            margin-right:8px;
        }
        .btn-back {
            background:#eee; color:#333; border:none;
            padding:10px 24px; border-radius:8px;
            font-size:.9rem; cursor:pointer; text-decoration:none;
            display:inline-block;
        }

        /* ── Label Grid ── */
        .labels-grid {
            display:grid;
            grid-template-columns: repeat(3, 1fr);
            gap:6px;
            max-width:800px;
            margin:0 auto;
        }

        /* ── Single Label ── */
        .label-card {
            background:#fff;
            border:1px solid #ddd;
            border-radius:6px;
            padding:10px 8px 8px;
            text-align:center;
            page-break-inside:avoid;
            break-inside:avoid;
        }

        .label-card .shop-name {
            font-size:9px; font-weight:700; color:#666;
            text-transform:uppercase; letter-spacing:.05em;
            margin-bottom:4px;
        }

        .label-card .barcode-wrap svg {
            max-width:100%; height:auto;
        }

        .label-card .product-name {
            font-size:9px; font-weight:700; color:#222;
            margin-top:4px; line-height:1.2;
            overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
        }

        .label-card .variant-info {
            font-size:8px; color:#666; margin-top:2px;
        }

        .label-card .price {
            font-size:14px; font-weight:800; color:#1a1d23;
            margin-top:4px; letter-spacing:-.02em;
        }

        .label-card .barcode-num {
            font-size:7px; color:#888; font-family:monospace; letter-spacing:.05em;
        }

        /* ── Print Media ── */
        @@media print {
            body { background:transparent; padding:2mm; }
            .print-controls { display:none !important; }
            .labels-grid {
                grid-template-columns: repeat(3, 1fr);
                gap:3mm;
                max-width:100%;
            }
            .label-card {
                border:0.5pt solid #ccc;
                border-radius:0;
                padding:2mm;
            }
            @@page { margin:8mm; size:A4; }
        }
    </style>
</head>
<body>

    <!-- Controls -->
    <div class="print-controls no-print">
        <strong>@Model.Count label(s) ready</strong>
        <br/><br/>
        <button class="btn-print" onclick="window.print()">
            🖨️ Print Labels
        </button>
        <a href="/Barcode" class="btn-back">← Back</a>
    </div>

    <!-- Labels Grid -->
    <div class="labels-grid">
        @foreach (var label in Model)
        {
            <div class="label-card">
                <div class="shop-name">Clothing ERP</div>
                <div class="barcode-wrap">
                    <svg class="bc-svg" data-barcode="@label.Barcode"></svg>
                </div>
                <div class="product-name">@label.ProductName</div>
                <div class="variant-info">
                    @label.SizeName &nbsp;|&nbsp; @label.ColorName
                    @if (!string.IsNullOrEmpty(label.SKU))
                    { <span>&nbsp;|&nbsp; @label.SKU</span> }
                </div>
                <div class="price">৳@label.RetailPrice.ToString("N2")</div>
                <div class="barcode-num">@label.Barcode</div>
            </div>
        }
    </div>

    <script>
    // Render all barcodes
    document.querySelectorAll('.bc-svg').forEach(el => {
        try {
            JsBarcode(el, el.dataset.barcode, {
                format:       'CODE128',
                width:        1.5,
                height:       36,
                margin:       0,
                displayValue: false,
                lineColor:    '#000',
                background:   '#fff'
            });
        } catch (e) {
            el.innerHTML = '<text y="20" style="font-size:10px;fill:#e00;">Invalid</text>';
        }
    });

    // Auto-print after barcodes render
    window.addEventListener('load', () => setTimeout(() => window.print(), 800));
    </script>
</body>
</html>