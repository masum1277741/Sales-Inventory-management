@model ClothingERP.Application.DTOs.StorefrontSettingsDto
@{
    ViewData["Title"] = "Storefront Settings";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-gear me-2 text-primary"></i>Storefront Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Online Orders</a></li>
                <li class="breadcrumb-item active">Settings</li>
            </ol>
        </nav>
    </div>
    <a href="/Shop" target="_blank" class="btn btn-light border">
        <i class="bi bi-bag me-1"></i>View Live Store
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Settings" method="post">
            @Html.AntiForgeryToken()

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-shop me-2 text-primary"></i>Store Info</span>
                </div>
                <div class="card-body p-4">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsStoreEnabled" />
                        <label class="form-check-label fw-semibold">Store is Open (Publicly Visible)</label>
                        <div class="text-muted small">বন্ধ থাকলে customers /Shop এ গেলে "Store Closed" দেখাবে।</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Store Name</label>
                        <input asp-for="StoreName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tagline</label>
                        <input asp-for="StoreTagline" class="form-control" placeholder="Premium Fashion — Delivered" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Announcement Banner (optional)</label>
                        <input asp-for="AnnouncementText" class="form-control"
                               placeholder="Eid Sale: 20% Off All Items!" />
                        <small class="text-muted">খালি রাখলে banner দেখাবে না।</small>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-truck me-2 text-primary"></i>Shipping</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Flat Shipping Fee (USD)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="FlatShippingFeeUSD" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Free Shipping Above (USD)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="FreeShippingThresholdUSD" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <small class="text-muted">এই পরিমাণের বেশি order হলে shipping free হবে।</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-credit-card me-2 text-primary"></i>Payment Methods</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="CodEnabled" />
                                <label class="form-check-label fw-semibold">Cash on Delivery</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="BkashEnabled" />
                                <label class="form-check-label fw-semibold" style="color:#e2136e;">bKash</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="NagadEnabled" />
                                <label class="form-check-label fw-semibold" style="color:#f6921e;">Nagad</label>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-warning small mt-3 mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        bKash/Nagad enable করতে হলে <code>appsettings.json</code> এ credentials সেট করতে হবে।
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-shop-window me-2 text-primary"></i>Fulfillment Branch</span>
                </div>
                <div class="card-body p-4">
                    <label class="form-label fw-semibold">Online orders কোন branch এর stock থেকে fulfill হবে?</label>
                    <input asp-for="FulfillmentBranchId" class="form-control" type="number"
                           placeholder="Branch ID" />
                    <small class="text-muted">Main Branch এর ID সাধারণত 1।</small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i>Save Settings
            </button>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-link me-2 text-primary"></i>Store Access Links</span>
            </div>
            <div class="card-body p-3">
                @foreach (var link in new[] {
                    ("/Shop", "Homepage"),
                    ("/Shop/Catalog", "Product Catalog"),
                    ("/ShopAccount/Login", "Customer Login"),
                    ("/ShopAccount/Register", "Customer Register"),
                })
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small fw-semibold">@link.Item2</span>
                        <div class="d-flex gap-2">
                            <code class="small">@link.Item1</code>
                            <a href="@link.Item1" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </div>
                    </div>
                }

                <div class="mt-3 p-3 rounded" style="background:var(--clz-cream);">
                    <div class="fw-semibold small mb-2">Quick Enable/Disable</div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-success flex-fill"
                                onclick="quickToggleStore(true)">
                            Enable Store
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger flex-fill"
                                onclick="quickToggleStore(false)">
                            Disable Store
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        function quickToggleStore(enable) {
            const form = document.querySelector('form');
            document.querySelector('[name=IsStoreEnabled]').checked = enable;
            form.submit();
        }
    </script>
}