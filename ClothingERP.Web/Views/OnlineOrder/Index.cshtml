@model IEnumerable<OnlineOrderListDto>
@{
    ViewData["Title"] = "Online Orders";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-bag-check me-2 text-primary"></i>Online Orders</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Online Orders</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Settings" class="btn btn-light border"><i class="bi bi-gear me-1"></i>Storefront Settings</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table id="orderTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th class="ps-4">Order #</th><th>Customer</th><th>Date</th><th class="text-end">Total</th><th>Payment</th><th class="text-center">Status</th><th class="text-center">Action</th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="ps-4"><code>@o.OrderNumber</code></td>
                        <td>@o.CustomerName <div class="text-muted small">@o.CustomerPhone</div></td>
                        <td class="small">@o.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end fw-bold">$@o.TotalUSD.ToString("N2")</td>
                        <td><span class="badge bg-secondary">@o.PaymentMethod</span></td>
                        <td class="text-center">
                            @{
                                var cls = o.Status switch { "Delivered" => "bg-success", "Cancelled" => "bg-danger", "Shipped" => "bg-info", "Confirmed" or "Processing" => "bg-warning text-dark", _ => "bg-secondary" };
                            }
                            <span class="badge @cls">@o.Status</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$(function () { initDataTable('#orderTable', { order: [[2,'desc']] }); });</script>
}