@model IEnumerable<BrandDto>
@{
    ViewData["Title"] = "Brand Management";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-bookmark-star me-2 text-primary"></i>Brand Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Brands</li>
            </ol>
        </nav>
    </div>
    <button class="btn btn-primary" onclick="openModal()">
        <i class="bi bi-plus-circle me-1"></i>Add Brand
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table id="brandTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4" width="50">#</th>
                    <th>Brand</th>
                    <th class="text-center">Products</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" width="130">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var b in Model)
                {
                    <tr id="brand-@b.Id">
                        <td class="ps-4 text-muted small">@(i++)</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(b.LogoPath))
                                {
                                    <img src="@b.LogoPath" width="36" height="36" class="rounded" style="object-fit:contain;" />
                                }
                                else
                                {
                                    <div style="width:36px;height:36px;background:#f0f2f5;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-bookmark-star text-secondary"></i>
                                    </div>
                                }
                                <div>
                                    <div class="fw-semibold small">@b.Name</div>
                                    @if (!string.IsNullOrEmpty(b.Description))
                                    {
                                        <div class="text-muted" style="font-size:.72rem;">@b.Description</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-center"><span class="badge bg-info bg-opacity-15 text-info">@b.ProductCount</span></td>
                        <td class="text-center">
                            <span class="badge rounded-pill @(b.IsActive ? "bg-success" : "bg-danger") bg-opacity-15 @(b.IsActive ? "text-success" : "text-danger") px-2">
                                @(b.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-light border me-1"
                                    onclick="openModal(@b.Id,'@b.Name','@b.Description',@b.IsActive.ToString().ToLower())">
                                <i class="bi bi-pencil text-primary"></i>
                            </button>
                            <button class="btn btn-sm btn-light border me-1" onclick="toggle(@b.Id)">
                                <i class="bi bi-arrow-repeat text-warning"></i>
                            </button>
                            <button class="btn btn-sm btn-light border" onclick="del(@b.Id,'@b.Name')"
                                @(b.ProductCount > 0 ? "disabled title='Has products'" : "")>
                                <i class="bi bi-trash text-danger"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Brand Modal -->
<div class="modal fade" id="brandModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="modalTitle">Add Brand</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="brandForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="bId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="bName" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea class="form-control" id="bDesc" name="Description" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Logo</label>
                        <input type="file" class="form-control" name="logo" accept="image/*" />
                    </div>
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="bActive" name="IsActive" value="true" checked />
                        <label class="form-check-label fw-semibold" for="bActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="save()">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() { initDataTable('#brandTable'); });
        const tok = () => $('[name=__RequestVerificationToken]').val();

        function openModal(id, name, desc, active) {
            $('#modalTitle').text(id ? 'Edit Brand' : 'Add Brand');
            $('#bId').val(id || ''); $('#bName').val(name || '');
            $('#bDesc').val(desc || ''); $('#bActive').prop('checked', active !== false);
            new bootstrap.Modal('#brandModal').show();
        }

        function save() {
            const id = $('#bId').val();
            const url = id ? `/Brand/Edit/${id}` : '/Brand/Create';
            if (!$('#bName').val().trim()) { toastr.error('Name is required.'); return; }
            fetch(url, { method:'POST', body: new FormData(document.getElementById('brandForm')) })
                .then(r => r.json())
                .then(d => { if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); } else toastr.error(d.message); });
        }

        function toggle(id) {
            $.post('/Brand/ToggleStatus', { id, __RequestVerificationToken: tok() },
                d => { if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); } else toastr.error(d.message); });
        }

        function del(id, name) {
            Swal.fire({ title:'Delete?', text:`Delete "${name}"?`, icon:'warning', showCancelButton:true, confirmButtonColor:'#d33', confirmButtonText:'Delete' })
            .then(r => { if (r.isConfirmed) {
                $.post('/Brand/Delete', { id, __RequestVerificationToken: tok() },
                    d => { if (d.success) { $(`#brand-${id}`).fadeOut(); toastr.success(d.message); } else toastr.error(d.message); });
            }});
        }
    </script>
}