<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CLOZEY</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
            :root {
                --gold: #c9a96e;
                --gold-deep: #a6845a;
                --black: #0a0a0a;
                --cream: #faf8f5;
                --text: #1a1a1a;
                --muted: #777;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'DM Sans',sans-serif;
                margin: 0;
                color: var(--text);
                background: #fff;
            }

            h1, h2, h3, .serif {
                font-family: 'Cormorant Garamond',serif;
            }

            .shop-topbar {
                background: #fff3cd;
                text-align: center;
                padding: 8px;
                font-size: .82rem;
                font-weight: 600;
            }

            .shop-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 18px 5%;
                border-bottom: 1px solid #eee;
                position: sticky;
                top: 0;
                background: #fff;
                z-index: 100;
            }

            .shop-logo {
                font-family: 'Cormorant Garamond',serif;
                font-size: 1.7rem;
                font-weight: 700;
                letter-spacing: 2px;
                color: var(--black);
                text-decoration: none;
            }

            .shop-nav a {
                color: var(--text);
                text-decoration: none;
                margin: 0 14px;
                font-size: .88rem;
                font-weight: 500;
            }

            .shop-icons a {
                color: var(--text);
                margin-left: 16px;
                font-size: 1.05rem;
                position: relative;
            }

            .cart-count {
                position: absolute;
                top: -8px;
                right: -10px;
                background: var(--black);
                color: var(--gold);
                font-size: .62rem;
                padding: 1px 5px;
                border-radius: 8px;
            }

            .shop-footer {
                background: var(--black);
                color: #ccc;
                padding: 50px 5% 24px;
                margin-top: 60px;
            }

                .shop-footer h6 {
                    color: var(--gold);
                    font-family: 'DM Sans';
                    font-size: .78rem;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                }

                .shop-footer a {
                    color: #aaa;
                    text-decoration: none;
                    font-size: .84rem;
                    display: block;
                    margin-bottom: 8px;
                }

            .currency-switch {
                font-size: .78rem;
            }

            .btn-shop-primary {
                background: var(--black);
                color: var(--gold);
                border: none;
                padding: 12px 28px;
                border-radius: 6px;
                font-weight: 600;
                font-size: .85rem;
                letter-spacing: .05em;
            }

                .btn-shop-primary:hover {
                    background: #222;
                    color: var(--gold);
                }

            .btn-shop-outline {
                border: 1px solid var(--black);
                color: var(--black);
                background: transparent;
                padding: 11px 27px;
                border-radius: 6px;
                font-weight: 600;
                font-size: .85rem;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        var settings = ViewBag.Settings;
    }
    @if (settings != null && !string.IsNullOrEmpty(settings.AnnouncementText))
    {
        <div class="shop-topbar">@settings.AnnouncementText</div>
    }

    <header class="shop-header">
        <a href="/Shop" class="shop-logo">CLOZEY</a>
        <nav class="shop-nav d-none d-md-block">
            <a href="/Shop/Catalog">Shop All</a>
            <a href="/Shop/Catalog?categoryId=1">Clothing</a>
            <a href="/Shop/Catalog?categoryId=2">Beauty</a>
        </nav>
        <div class="d-flex align-items-center">
            <select class="form-select form-select-sm currency-switch me-3" id="currencySwitch" style="width:90px;" onchange="setCurrency(this.value)">
                <option value="USD">USD $</option>
                <option value="BDT">BDT ৳</option>
                <option value="MVR">MVR Rf</option>
            </select>
            <div class="shop-icons">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/ShopAccount/MyOrders" title="My Orders"><i class="bi bi-person"></i></a>
                }
                else
                {
                    <a href="/ShopAccount/Login" title="Login"><i class="bi bi-person"></i></a>
                }
                <a href="/Shop/Cart" title="Cart">
                    <i class="bi bi-bag"></i>
                    <span class="cart-count" id="cartCountBadge" style="display:none;">0</span>
                </a>
            </div>
        </div>
    </header>

    <main>@RenderBody()</main>

    <footer class="shop-footer">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h3 class="serif" style="color:#fff;">CLOZEY</h3>
                <p style="color:#999;font-size:.84rem;">Attractive Beauty — Premium clothing & beauty, delivered.</p>
            </div>
            <div class="col-md-2 mb-4"><h6>Shop</h6><a href="/Shop/Catalog">All Products</a><a href="#">New Arrivals</a></div>
            <div class="col-md-2 mb-4"><h6>Account</h6><a href="/ShopAccount/Login">Login</a><a href="/ShopAccount/MyOrders">My Orders</a></div>
            <div class="col-md-4 mb-4"><h6>Contact</h6><a href="#"><i class="bi bi-telephone me-1"></i>+880 1XXX-XXXXXX</a></div>
        </div>
        <hr style="border-color:#333;" />
        <div class="text-center" style="color:#666;font-size:.76rem;">© @DateTime.Now.Year CLOZEY — Attractive Beauty. All rights reserved.</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" />
    <script>
        // ══ Shop-wide Cart Helper (localStorage ভিত্তিক) ════════════════════════
        const ShopCart = {
        key: 'clozey-shop-cart',
        get() { return JSON.parse(localStorage.getItem(this.key) || '[]'); },
        save(cart) { localStorage.setItem(this.key, JSON.stringify(cart)); this.updateBadge(); },
        add(variantId, qty = 1) {
        const cart = this.get();
        const existing = cart.find(i => i.variantId === variantId);
        if (existing) existing.quantity += qty; else cart.push({ variantId, quantity: qty });
        this.save(cart);
        },
        updateQty(variantId, qty) {
        let cart = this.get();
        if (qty <= 0) cart = cart.filter(i => i.variantId !== variantId);
        else { const item = cart.find(i => i.variantId === variantId); if (item) item.quantity = qty; }
        this.save(cart);
        },
        remove(variantId) { this.save(this.get().filter(i => i.variantId !== variantId)); },
        clear() { this.save([]); },
        updateBadge() {
        const count = this.get().reduce((s, i) => s + i.quantity, 0);
        const badge = document.getElementById('cartCountBadge');
        if (badge) { badge.textContent = count; badge.style.display = count > 0 ? '' : 'none'; }
        }
        };
        document.addEventListener('DOMContentLoaded', () => ShopCart.updateBadge());

        function setCurrency(cur) { localStorage.setItem('clozey-currency', cur); location.reload(); }
        document.addEventListener('DOMContentLoaded', () => {
        const saved = localStorage.getItem('clozey-currency') || 'USD';
        document.getElementById('currencySwitch').value = saved;
        });

        function fmtPrice(usd) {
        const cur = localStorage.getItem('clozey-currency') || 'USD';
        const rates = window.__rates || { usdToBdt: 110, usdToMvr: 15.42 };
        if (cur === 'BDT') return '৳' + (usd * rates.usdToBdt).toFixed(0);
        if (cur === 'MVR') return 'Rf' + (usd * rates.usdToMvr).toFixed(2);
        return '$' + usd.toFixed(2);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>