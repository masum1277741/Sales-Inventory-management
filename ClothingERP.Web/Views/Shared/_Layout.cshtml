    <!-- Select2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <!-- Toastr -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

   <style>
/* ══════════════════════════════════════════════════════════════════════════
   CLOZEY ERP — Complete Design System
   Brand: Black #0a0a0a | Gold #c9a96e | Cream #faf8f5
══════════════════════════════════════════════════════════════════════════ */

/* ── CSS Variables ────────────────────────────────────────────────────── */
:root {
    /* Brand */
    --clz-black:        #0a0a0a;
    --clz-black-mid:    #141414;
    --clz-black-soft:   #1c1c1c;
    --clz-gold:         #c9a96e;
    --clz-gold-deep:    #a6845a;
    --clz-gold-light:   #e8d5b0;
    --clz-gold-pale:    rgba(201, 169, 110, .10);
    --clz-gold-border:  rgba(201, 169, 110, .20);
    --clz-cream:        #faf8f5;
    --clz-cream-mid:    #f3ede3;

    /* Layout */
    --sidebar-width:    260px;
    --sidebar-collapsed:70px;
    --topbar-h:         60px;

    /* UI */
    --border:           #e8e3da;
    --border-mid:       #ddd6c8;
    --card-bg:          #ffffff;
    --body-bg:          #f5f2ed;
    --text:             #1a1a1a;
    --text-mid:         #4a4a4a;
    --text-muted:       #7a7a7a;
    --radius:           10px;
    --radius-sm:        7px;
    --shadow:           0 1px 6px rgba(0,0,0,.07);
    --shadow-md:        0 4px 16px rgba(0,0,0,.10);

    /* Status — High Contrast */
    --success-bg:       #d1fae5;
    --success-text:     #065f46;
    --success-border:   #6ee7b7;

    --danger-bg:        #fee2e2;
    --danger-text:      #7f1d1d;
    --danger-border:    #fca5a5;

    --warning-bg:       #fef3c7;
    --warning-text:     #78350f;
    --warning-border:   #fcd34d;

    --info-bg:          #dbeafe;
    --info-text:        #1e3a8a;
    --info-border:      #93c5fd;

    --primary-bg:       #ede9fe;
    --primary-text:     #4c1d95;
    --primary-border:   #c4b5fd;

    --gray-bg:          #f1f5f9;
    --gray-text:        #1e293b;
    --gray-border:      #cbd5e1;
}

/* ── Reset & Base ─────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }

body {
    font-family:      'Segoe UI', system-ui, -apple-system, sans-serif;
    font-size:        .9rem;
    background:       var(--body-bg);
    color:            var(--text);
    line-height:      1.6;
    -webkit-font-smoothing: antialiased;
}

a { color: var(--clz-gold-deep); text-decoration: none; transition: color .15s; }
a:hover { color: var(--clz-gold); }

/* ══ SIDEBAR ═══════════════════════════════════════════════════════════ */
#sidebar {
    width:          var(--sidebar-width);
    height:         100vh;
    position:       fixed;
    top:            0;
    left:           0;
    background:     var(--clz-black);
    overflow-y:     auto;
    overflow-x:     hidden;
    transition:     width .25s ease;
    z-index:        1040;
    display:        flex;
    flex-direction: column;
    border-right:   1px solid rgba(201,169,110,.08);
}

/* Scrollbar */
#sidebar::-webkit-scrollbar              { width: 3px; }
#sidebar::-webkit-scrollbar-track       { background: transparent; }
#sidebar::-webkit-scrollbar-thumb       { background: rgba(201,169,110,.2); border-radius: 2px; }
#sidebar::-webkit-scrollbar-thumb:hover { background: rgba(201,169,110,.4); }

#sidebar .brand {
    padding:         12px 10px;
    border-bottom:   1px solid rgba(201,169,110,.10);
    display:         flex;
    align-items:     center;
    justify-content: center;
    min-height:      110px;
    flex-shrink:     0;
    overflow:        hidden;
}

#sidebar .brand-logo {
    width:        100%;
    max-width:    310px;
    height:       auto;
    max-height:   100px;
    object-fit:   contain;
    filter:   invert(1);
    opacity:  .90;
    transition: all .25s;
}

#sidebar .nav-label {
    padding:        14px 20px 5px;
    font-size:      .65rem;
    text-transform: uppercase;
    letter-spacing: .22em;
    color:          #c9a96e !important;
    font-weight:    700;
    white-space:    nowrap;
    overflow:       hidden;
    opacity: 1 !important;
    display: block !important;
      flex-shrink:    0;         
    min-height:     28px; 
}

/* Nav links */
#sidebar .nav-link {
    color:          rgba(255,255,255,.58);
    padding:        9px 16px;
    display:        flex;
    align-items:    center;
    gap:            10px;
    font-size:      .84rem;
    border-radius:  var(--radius-sm);
    margin:         2px 10px;
    transition:     all .18s;
    text-decoration:none;
    white-space:    nowrap;
    overflow:       hidden;
    border-left:    2px solid transparent;
    position:       relative;
}

#sidebar .nav-link i {
    font-size:   1.05rem;
    width:       20px;
    text-align:  center;
    flex-shrink: 0;
    transition:  color .18s;
}

#sidebar .nav-link span { transition: opacity .2s; }

#sidebar .nav-link:hover {
    background:    rgba(201,169,110,.08);
    color:         rgba(255,255,255,.88);
    border-left-color: rgba(201,169,110,.30);
}

#sidebar .nav-link:hover i { color: var(--clz-gold); }

#sidebar .nav-link.active {
    background:    rgba(201,169,110,.14);
    color:         var(--clz-gold) !important;
    border-left-color: var(--clz-gold);
    font-weight:   500;
}

#sidebar .nav-link.active i { color: var(--clz-gold) !important; }

/* Logout button */
.logout-btn {
    border:     none;
    background: transparent;
    width:      100%;
    text-align: left;
    cursor:     pointer;
    padding:    0;
    color:      inherit;
}

/* Sidebar footer */
#sidebar .sidebar-footer {
    padding:      14px 10px;
    border-top:   1px solid rgba(201,169,110,.10);
    flex-shrink:  0;
    margin-top:   auto;
}

/* ── Collapsed Sidebar ──────────────────────────────────────────────── */
body.sidebar-collapsed #sidebar              { width: var(--sidebar-collapsed); }
body.sidebar-collapsed #sidebar .brand {
    padding:    12px 0;
    min-height: 64px;
}

body.sidebar-collapsed #sidebar .brand-logo {
    max-width:  34px;
    max-height: 34px;
}
body.sidebar-collapsed #sidebar .nav-label   { opacity: 0; height: 0; padding: 0; overflow: hidden; }
body.sidebar-collapsed #sidebar .nav-link    { justify-content: center; padding: 10px 0; margin: 2px 8px; }
body.sidebar-collapsed #sidebar .nav-link i  { width: auto; }
body.sidebar-collapsed #sidebar .nav-link span { display: none; }
body.sidebar-collapsed #sidebar .sidebar-footer { padding: 10px 6px; }

/* ══ TOPBAR ═══════════════════════════════════════════════════════════ */
#topbar {
    height:     var(--topbar-h);
    background: var(--card-bg);
    border-bottom: 1px solid var(--border);
    display:    flex;
    align-items:center;
    padding:    0 24px;
    position:   fixed;
    top:        0;
    left:       var(--sidebar-width);
    right:      0;
    z-index:    1030;
    gap:        12px;
    transition: left .25s ease;
    box-shadow: 0 1px 0 var(--border);
}

body.sidebar-collapsed #topbar { left: var(--sidebar-collapsed); }

#topbar .page-title {
    font-weight: 600;
    font-size:   .98rem;
    color:       var(--text);
    flex:        1;
    letter-spacing: .01em;
}

#topbar .topbar-right {
    display:     flex;
    align-items: center;
    gap:         8px;
}

/* Topbar buttons */
#topbar .btn-sm {
    border-radius: var(--radius-sm);
    font-size:     .8rem;
    padding:       5px 12px;
}

/* User badge */
#topbar .user-badge {
    display:       flex;
    align-items:   center;
    gap:           8px;
    padding:       5px 10px 5px 6px;
    border-radius: var(--radius-sm);
    background:    var(--clz-cream);
    border:        1px solid var(--border);
    cursor:        pointer;
    transition:    background .15s;
}

#topbar .user-badge:hover { background: var(--clz-cream-mid); }

#topbar .user-badge .avatar {
    width:           32px;
    height:          32px;
    border-radius:   50%;
    background:      var(--clz-black);
    color:           var(--clz-gold);
    display:         flex;
    align-items:     center;
    justify-content: center;
    font-weight:     700;
    font-size:       .85rem;
    border:          1px solid var(--clz-gold-border);
    flex-shrink:     0;
}

/* ══ MAIN CONTENT ═════════════════════════════════════════════════════ */
#main-content {
    margin-left: var(--sidebar-width);
    margin-top:  var(--topbar-h);
    padding:     24px;
    min-height:  calc(100vh - var(--topbar-h));
    transition:  margin-left .25s ease;
}

body.sidebar-collapsed #main-content { margin-left: var(--sidebar-collapsed); }

/* ── Page Header ───────────────────────────────────────────────────── */
.page-header {
    margin-bottom: 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
}

.page-header h4 {
    font-weight:    600;
    font-size:      1.22rem;
    color:          var(--text);
    margin:         0 0 3px;
    letter-spacing: .01em;
}

/* Breadcrumb */
.breadcrumb             { margin: 0; }
.breadcrumb-item a      { color: var(--text-muted); font-size: .75rem; }
.breadcrumb-item a:hover{ color: var(--clz-gold); }
.breadcrumb-item.active { color: var(--text); font-size: .75rem; }
.breadcrumb-item + .breadcrumb-item::before { color: var(--border-mid); }

/* ══ CARDS ════════════════════════════════════════════════════════════ */
.card {
    background:    var(--card-bg) !important;
    border:        1px solid var(--border) !important;
    border-radius: var(--radius) !important;
    box-shadow:    var(--shadow);
}

.card-header {
    background:   var(--card-bg) !important;
    border-bottom: 1px solid var(--border) !important;
    font-weight:   500;
    font-size:     .86rem;
    color:         var(--text);
    padding:       14px 18px;
}

.card-body { padding: 18px; }

.shadow-sm { box-shadow: var(--shadow) !important; }
.shadow    { box-shadow: var(--shadow-md) !important; }

/* Stat Card */
.stat-card {
    background:    var(--card-bg);
    border:        1px solid var(--border);
    border-radius: var(--radius);
    padding:       18px 20px;
    transition:    box-shadow .2s, transform .2s;
}

.stat-card:hover {
    box-shadow: var(--shadow-md);
    transform:  translateY(-1px);
}

.stat-card .icon-wrap {
    width:           44px;
    height:          44px;
    border-radius:   10px;
    display:         flex;
    align-items:     center;
    justify-content: center;
    font-size:       1.15rem;
    flex-shrink:     0;
}

/* ══ STATUS BADGES — Universal High Contrast ═══════════════════════════ */
.badge {
    font-size:      .69rem !important;
    font-weight:    500   !important;
    padding:        4px 10px !important;
    border-radius:  20px !important;
    line-height:    1.4  !important;
    display:        inline-flex !important;
    align-items:    center !important;
    gap:            3px;
}

/* Active / Success / Paid / In Stock ─────────────── */
.badge.bg-success,
.badge.bg-success.bg-opacity-15,
.badge.bg-success.bg-opacity-10,
.badge.text-success {
    background: var(--success-bg)     !important;
    color:      var(--success-text)   !important;
    border:     1px solid var(--success-border) !important;
}

/* Inactive / Danger / Cancelled / Out of Stock ──── */
.badge.bg-danger,
.badge.bg-danger.bg-opacity-15,
.badge.bg-danger.bg-opacity-10,
.badge.text-danger {
    background: var(--danger-bg)    !important;
    color:      var(--danger-text)  !important;
    border:     1px solid var(--danger-border) !important;
}

/* Warning / Low Stock / Partial / Draft ─────────── */
.badge.bg-warning,
.badge.bg-warning.bg-opacity-15,
.badge.bg-warning.text-dark {
    background: var(--warning-bg)   !important;
    color:      var(--warning-text) !important;
    border:     1px solid var(--warning-border) !important;
}

/* Info / Confirmed / Approved ───────────────────── */
.badge.bg-info,
.badge.bg-info.bg-opacity-15,
.badge.bg-info.bg-opacity-10 {
    background: var(--info-bg)    !important;
    color:      var(--info-text)  !important;
    border:     1px solid var(--info-border) !important;
}

/* Primary / Role / Category / Group ─────────────── */
.badge.bg-primary,
.badge.bg-primary.bg-opacity-15,
.badge.bg-primary.bg-opacity-10,
.badge.text-primary {
    background: var(--primary-bg)   !important;
    color:      var(--primary-text) !important;
    border:     1px solid var(--primary-border) !important;
}

/* Secondary / Gray / Hold ───────────────────────── */
.badge.bg-secondary,
.badge.bg-secondary.bg-opacity-15 {
    background: var(--gray-bg)    !important;
    color:      var(--gray-text)  !important;
    border:     1px solid var(--gray-border) !important;
}

/* Light */
.badge.bg-light {
    background: #f8fafc !important;
    color:      #334155 !important;
    border:     1px solid #e2e8f0 !important;
}

/* Custom shorthand badge classes */
.badge-status-active {
    background: var(--success-bg);
    color:      var(--success-text);
    border:     1px solid var(--success-border);
    padding:    4px 10px;
    border-radius: 20px;
    font-size:  .69rem;
    font-weight:500;
}

.badge-status-inactive {
    background: var(--danger-bg);
    color:      var(--danger-text);
    border:     1px solid var(--danger-border);
    padding:    4px 10px;
    border-radius: 20px;
    font-size:  .69rem;
    font-weight:500;
}

/* ══ TEXT COLORS (override Bootstrap) ════════════════════════════════ */
.text-success { color: var(--success-text) !important; }
.text-danger  { color: var(--danger-text)  !important; }
.text-warning { color: var(--warning-text) !important; }
.text-info    { color: var(--info-text)    !important; }
.text-primary { color: var(--primary-text) !important; }
.text-muted   { color: var(--text-muted)   !important; }

/* ══ BUTTONS ══════════════════════════════════════════════════════════ */
.btn {
    border-radius: var(--radius-sm);
    font-size:     .82rem;
    font-weight:   500;
    transition:    all .18s;
    letter-spacing:.01em;
}

.btn-primary {
    background:   var(--clz-black)  !important;
    border-color: var(--clz-black)  !important;
    color:        #fff              !important;
}
.btn-primary:hover, .btn-primary:focus {
    background:   var(--clz-gold-deep) !important;
    border-color: var(--clz-gold-deep) !important;
}

.btn-outline-primary {
    color:       var(--clz-black) !important;
    border-color:var(--clz-black) !important;
}
.btn-outline-primary:hover {
    background:  var(--clz-black) !important;
    color:       #fff             !important;
}

.btn-success { background: #16a34a !important; border-color: #16a34a !important; color:#fff!important; }
.btn-success:hover { background: #15803d !important; border-color: #15803d !important; }

.btn-danger  { background: #dc2626 !important; border-color: #dc2626 !important; color:#fff!important; }
.btn-danger:hover  { background: #b91c1c !important; border-color: #b91c1c !important; }

.btn-warning { background: #d97706 !important; border-color: #d97706 !important; color:#fff!important; }
.btn-warning:hover { background: #b45309 !important; border-color: #b45309 !important; }

.btn-info    { background: #2563eb !important; border-color: #2563eb !important; color:#fff!important; }
.btn-info:hover    { background: #1d4ed8 !important; border-color: #1d4ed8 !important; }

.btn-light {
    background:  var(--clz-cream)  !important;
    border-color:var(--border)     !important;
    color:       var(--text)       !important;
}
.btn-light:hover {
    background:  var(--clz-cream-mid) !important;
    border-color:var(--border-mid)    !important;
}

.btn-outline-secondary { border-color: var(--border-mid) !important; color: var(--text-mid) !important; }
.btn-outline-secondary:hover { background: var(--clz-cream) !important; color: var(--text) !important; }

.btn-outline-success  { color: #15803d !important; border-color: #16a34a !important; }
.btn-outline-success:hover  { background: #16a34a !important; color: #fff !important; }

.btn-outline-danger   { color: #b91c1c !important; border-color: #dc2626 !important; }
.btn-outline-danger:hover   { background: #dc2626 !important; color: #fff !important; }

.btn-outline-warning  { color: #92400e !important; border-color: #d97706 !important; }
.btn-outline-warning:hover  { background: #d97706 !important; color: #fff !important; }

.btn-outline-info     { color: #1e40af !important; border-color: #2563eb !important; }
.btn-outline-info:hover     { background: #2563eb !important; color: #fff !important; }

/* ══ FORMS ════════════════════════════════════════════════════════════ */
.form-control, .form-select {
    border:        1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size:     .87rem;
    color:         var(--text);
    background:    var(--card-bg);
    padding:       8px 12px;
    transition:    border-color .18s, box-shadow .18s;
}

.form-control:focus, .form-select:focus {
    border-color: var(--clz-gold);
    box-shadow:   0 0 0 3px rgba(201,169,110,.14);
    outline:      none;
}

.form-control::placeholder { color: #b8b0a4; }

.form-control-sm, .form-select-sm {
    font-size: .8rem;
    padding:   5px 10px;
}

.form-label {
    font-size:     .82rem;
    font-weight:   500;
    color:         var(--text);
    margin-bottom: 5px;
}

.input-group-text {
    background:   var(--clz-cream) !important;
    border-color: var(--border)    !important;
    color:        var(--text-muted)!important;
    font-size:    .87rem;
}

/* Checkbox / Radio */
.form-check-input:checked {
    background-color: var(--clz-black);
    border-color:     var(--clz-black);
}
.form-check-input:focus {
    box-shadow:  0 0 0 3px rgba(201,169,110,.15);
    border-color:var(--clz-gold);
}
.form-switch .form-check-input:checked { background-color: var(--clz-black); }

/* Validation */
.is-invalid { border-color: #dc2626 !important; }
.invalid-feedback { color: #b91c1c; font-size: .78rem; }
.text-danger.small, .field-error { color: #b91c1c; font-size: .75rem; }

/* ══ TABLES ═══════════════════════════════════════════════════════════ */
.table {
    font-size: .85rem;
    color:     var(--text);
    --bs-table-bg: transparent;
}

.table-hover > tbody > tr:hover > * {
    background: rgba(201,169,110,.04);
}

.table > :not(caption) > * > * {
    padding:    10px 12px;
    border-color: var(--border);
}

.table-light {
    background: #f7f4ef !important;
    --bs-table-bg: #f7f4ef !important;
}

.table-light th {
    color:          #374151 !important;
    font-size:      .72rem  !important;
    font-weight:    600     !important;
    text-transform: uppercase !important;
    letter-spacing: .06em   !important;
    border-bottom:  2px solid var(--border-mid) !important;
}

/* DataTables */
table.dataTable thead th {
    background:     #f7f4ef;
    font-weight:    600;
    font-size:      .72rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color:          #374151;
}

.dataTables_wrapper .dataTables_length select,
.dataTables_wrapper .dataTables_filter input {
    border:        1px solid var(--border);
    border-radius: var(--radius-sm);
    padding:       4px 8px;
    font-size:     .83rem;
    color:         var(--text);
}

.dataTables_wrapper .dataTables_filter input:focus {
    border-color: var(--clz-gold);
    box-shadow:   0 0 0 3px rgba(201,169,110,.12);
    outline:      none;
}

.dataTables_info, .dataTables_length { font-size: .78rem; color: var(--text-muted); }

/* Pagination */
.page-link {
    color:        var(--text);
    border-color: var(--border);
    font-size:    .82rem;
    padding:      5px 10px;
}
.page-link:hover          { background: var(--clz-cream); color: var(--clz-gold-deep); }
.page-item.active .page-link {
    background:   var(--clz-black);
    border-color: var(--clz-black);
    color:        #fff;
}
.page-item.disabled .page-link { color: #bbb; }

/* ══ DROPDOWNS ════════════════════════════════════════════════════════ */
.dropdown-menu {
    border:        1px solid var(--border);
    border-radius: var(--radius);
    padding:       6px;
    box-shadow:    0 8px 24px rgba(0,0,0,.10);
    font-size:     .84rem;
    min-width:     160px;
}

.dropdown-item {
    border-radius: var(--radius-sm);
    padding:       7px 12px;
    color:         var(--text);
    font-size:     .84rem;
    transition:    background .13s;
}

.dropdown-item:hover              { background: var(--clz-cream); color: var(--text); }
.dropdown-item.text-danger        { color: #b91c1c !important; }
.dropdown-item.text-danger:hover  { background: #fee2e2; }
.dropdown-divider { border-color: var(--border); margin: 4px 0; }

/* ══ MODALS ═══════════════════════════════════════════════════════════ */
.modal-content {
    border:        1px solid var(--border);
    border-radius: 14px;
    box-shadow:    0 20px 60px rgba(0,0,0,.15);
}
.modal-header {
    border-bottom: 1px solid var(--border);
    padding:       18px 20px;
}
.modal-footer {
    border-top:  1px solid var(--border);
    padding:     14px 20px;
}
.modal-title { font-weight: 600; font-size: .95rem; }
.btn-close   { opacity: .5; }
.btn-close:hover { opacity: .8; }

/* ══ ALERTS ═══════════════════════════════════════════════════════════ */
.alert {
    border-radius: var(--radius-sm);
    font-size:     .85rem;
    padding:       10px 14px;
}
.alert-danger {
    background:   #fee2e2;
    border-color: #fca5a5;
    color:        #7f1d1d;
}
.alert-success {
    background:   #d1fae5;
    border-color: #6ee7b7;
    color:        #065f46;
}
.alert-warning {
    background:   #fef3c7;
    border-color: #fcd34d;
    color:        #78350f;
}
.alert-info {
    background:   #dbeafe;
    border-color: #93c5fd;
    color:        #1e3a8a;
}

/* ══ SELECT2 ══════════════════════════════════════════════════════════ */
.select2-container--bootstrap-5 .select2-selection {
    border-color:  var(--border)      !important;
    border-radius: var(--radius-sm)   !important;
    font-size:     .87rem             !important;
    color:         var(--text)        !important;
    background:    var(--card-bg)     !important;
    min-height:    38px               !important;
}
.select2-container--bootstrap-5.select2-container--focus .select2-selection,
.select2-container--bootstrap-5 .select2-selection:focus {
    border-color: var(--clz-gold)             !important;
    box-shadow:   0 0 0 3px rgba(201,169,110,.14) !important;
}
.select2-container--bootstrap-5 .select2-dropdown {
    border-color:  var(--border)   !important;
    border-radius: var(--radius)   !important;
    box-shadow:    var(--shadow-md) !important;
    font-size:     .85rem          !important;
}
.select2-container--bootstrap-5 .select2-results__option--highlighted {
    background: var(--clz-cream-mid) !important;
    color:      var(--text)          !important;
}
.select2-container--bootstrap-5 .select2-results__option--selected {
    background: var(--clz-black) !important;
    color:      var(--clz-gold)  !important;
}
.select2-search__field:focus { outline: none !important; }

/* ══ TOASTR ═══════════════════════════════════════════════════════════ */
.toast-success,
.toast-error,
.toast-warning,
.toast-info {
    background:    #1a1a1a !important;
    border-radius: var(--radius-sm) !important;
    box-shadow:    0 4px 16px rgba(0,0,0,.2) !important;
    font-size:     .84rem !important;
    opacity:       1 !important;
}
.toast-success { border-left: 3px solid #16a34a !important; }
.toast-error   { border-left: 3px solid #dc2626 !important; }
.toast-warning { border-left: 3px solid #d97706 !important; }
.toast-info    { border-left: 3px solid #2563eb !important; }

.toast-title   { font-weight: 600 !important; color: #fff !important; }
.toast-message { color: rgba(255,255,255,.8) !important; }
.toast-close-button { color: rgba(255,255,255,.5) !important; }

/* ══ PROGRESS ═════════════════════════════════════════════════════════ */
.progress {
    background:    #ede8df;
    border-radius: 4px;
    overflow:      hidden;
}
.progress-bar                  { transition: width .4s ease; }
.progress-bar.bg-success       { background: #16a34a !important; }
.progress-bar.bg-warning       { background: #d97706 !important; }
.progress-bar.bg-danger        { background: #dc2626 !important; }
.progress-bar.bg-info          { background: #2563eb !important; }
.progress-bar.bg-primary       { background: var(--clz-black) !important; }

/* ══ MISC UTILITIES ═══════════════════════════════════════════════════ */
code {
    color:         var(--clz-gold-deep);
    background:    rgba(201,169,110,.10);
    padding:       1px 5px;
    border-radius: 4px;
    font-size:     .82em;
    font-family:   'Consolas', monospace;
}

.fw-semibold { font-weight: 500 !important; }

pre {
    background:    #f8f9fa;
    border:        1px solid var(--border);
    border-radius: var(--radius-sm);
    padding:       12px;
    font-size:     .8rem;
    color:         var(--text);
}

hr { border-color: var(--border); opacity: 1; margin: 16px 0; }

/* Scrollbar (global) */
::-webkit-scrollbar             { width: 5px; height: 5px; }
::-webkit-scrollbar-track       { background: transparent; }
::-webkit-scrollbar-thumb       { background: #d4cdc3; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--clz-gold-border); }

/* ══ MOBILE ═══════════════════════════════════════════════════════════ */
@@media (max-width: 768px) {
    #sidebar {
        transform: translateX(-100%);
        width:     var(--sidebar-width) !important;
    }

    body.sidebar-open #sidebar {
        transform: translateX(0);
        box-shadow: 4px 0 20px rgba(0,0,0,.3);
    }

    /* Mobile overlay */
    body.sidebar-open::before {
        content:    '';
        position:   fixed;
        inset:      0;
        background: rgba(0,0,0,.4);
        z-index:    1039;
    }

    #topbar    { left: 0 !important; }
    #main-content { margin-left: 0 !important; padding: 16px; }

    .stat-card { padding: 14px; }
    .page-header h4 { font-size: 1.05rem; }

    #topbar .page-title { font-size: .88rem; }
}

@@media (max-width: 576px) {
    #main-content { padding: 12px; }
    .card-body    { padding: 14px; }

    .topbar-right .d-none.d-md-inline { display: none !important; }
}

/* ══ PRINT ════════════════════════════════════════════════════════════ */
@@media print {
    #sidebar, #topbar, .no-print { display: none !important; }
    #main-content { margin: 0 !important; padding: 0 !important; }
    .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    .page-header { border-bottom: 2px solid #333 !important; }
}
</style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ══ SIDEBAR ════════════════════════════════════════════════════════════ -->
    <nav id="sidebar">
      <div class="brand">
    <img src="/logo/logo.png"
         alt="CLOZEY ERP"
         class="brand-logo"
         onerror="this.style.display='none';
                  document.getElementById('brand-text').style.display='flex';" />
    <div id="brand-text"
         style="display:none;flex-direction:column;align-items:center;gap:2px;">
        <span style="color:var(--clz-gold);font-weight:700;font-size:1rem;
                     letter-spacing:.08em;">CLOZEY</span>
        <span style="color:rgba(255,255,255,.35);font-size:.6rem;
                     letter-spacing:.18em;">ATTRACTIVE BEAUTY</span>
    </div>
</div>

        @if (ViewBag.SidebarMenus != null)
        {
            var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();

            <div class="nav-label">Navigation</div>
            <nav class="nav flex-column py-1">
                @foreach (var menu in (IEnumerable<ClothingERP.Domain.Entities.AppModule>)ViewBag.SidebarMenus)
                {
                    var isActive = currentCtrl?.Equals(menu.Controller, StringComparison.OrdinalIgnoreCase) == true;
                    <a class="nav-link @(isActive ? "active" : "")"
                           href="/@menu.Controller/@menu.Action"
                           title="@menu.Name">
                        <i class="bi @(menu.Icon ?? "bi-circle")"></i>
                        <span>@menu.Name</span>
                    </a>
                }
            </nav>
        }

        <div class="mt-auto p-3">
            <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutFormSidebar">
                @Html.AntiForgeryToken()
                <button type="button"
                        class="nav-link text-danger logout-btn"
                        onclick="doLogout('logoutFormSidebar')">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- ══ TOP BAR ════════════════════════════════════════════════════════════ -->
    <header id="topbar">
        <button class="btn btn-sm btn-light" id="sidebarToggle">
            <i class="bi bi-list fs-5"></i>
        </button>
        <span class="page-title">@(ViewData["Title"] ?? "Dashboard")</span>

        <div class="topbar-right">
            <!-- Quick Stats -->
            <a asp-controller="Stock" asp-action="Index" class="btn btn-sm btn-light position-relative">
                <i class="bi bi-archive"></i>
                <span class="d-none d-md-inline ms-1">Stock</span>
            </a>
            <a asp-controller="Sales" asp-action="POS" class="btn btn-sm btn-primary">
                <i class="bi bi-cart-plus"></i>
                <span class="d-none d-md-inline ms-1">New Sale</span>
            </a>

            <!-- User Menu -->
            <div class="dropdown">
                <div class="user-badge dropdown-toggle" data-bs-toggle="dropdown">
                    <div class="avatar">@(ViewBag.CurrentUser?.Substring(0, 1).ToUpper() ?? "U")</div>
                    <div class="d-none d-md-block">
                        <div style="font-size:.8rem;font-weight:600;">@ViewBag.CurrentUser</div>
                        <div style="font-size:.7rem;color:#888;">@ViewBag.CurrentRole</div>
                    </div>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutFormTop">
                            @Html.AntiForgeryToken()
                            <button type="button"
                                    class="dropdown-item text-danger"
                                    onclick="doLogout('logoutFormTop')">
                                <i class="bi bi-box-arrow-left me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ══ MAIN CONTENT ════════════════════════════════════════════════════════ -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- ══ SCRIPTS ════════════════════════════════════════════════════════════ -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // ── Sidebar Toggle ───────────────────────────────────────────────────
        $('#sidebarToggle').on('click', function () {
        if ($(window).width() <= 768) {
        $('body').toggleClass('sidebar-open');
        } else {
        $('body').toggleClass('sidebar-collapsed');
        localStorage.setItem('sidebarCollapsed', $('body').hasClass('sidebar-collapsed'));
        }
        });
        if (localStorage.getItem('sidebarCollapsed') === 'true') $('body').addClass('sidebar-collapsed');

        // ── Toastr Config ────────────────────────────────────────────────────
        toastr.options = { positionClass: 'toast-top-right', timeOut: 3500, closeButton: true, progressBar: true };

        // ── TempData Notifications ───────────────────────────────────────────
        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["Success"])');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["Error"])');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>toastr.warning('@Html.Raw(TempData["Warning"])');</text>
        }

        // ── Default DataTable Init ───────────────────────────────────────────
        function initDataTable(selector, options) {
        if ($(selector).length) {
        $(selector).DataTable($.extend({
        responsive: true, pageLength: 25,
        language: { search: '', searchPlaceholder: 'Search...' }
        }, options || {}));
        }
        }

        // ── Delete Confirm ───────────────────────────────────────────────────
        function confirmDelete(url, name) {
        Swal.fire({ title: 'Delete?', text: `Delete "${name}"?`, icon: 'warning',
        showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes, delete!' })
        .then((result) => { if (result.isConfirmed) window.location.href = url; });
        }
        // ── Logout Confirm ───────────────────────────────────────────────────
        function doLogout(formId) {
        Swal.fire({
        title: 'Logout?',
        text: 'Are you sure you want to logout?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, logout!',
        cancelButtonText: 'Cancel'
        }).then((result) => {
        if (result.isConfirmed) document.getElementById(formId).submit();
        });
        }
        // ── Select2 Init ─────────────────────────────────────────────────────
        $(document).ready(function () {
        $('select.select2').select2({ theme: 'bootstrap-5', width: '100%' });
        });

    </script>
            
                <script>
                    if ('serviceWorker' in navigator) {
                    window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js', { scope: '/' })
                    .then(reg => {
                    console.log('[PWA] Service Worker registered:', reg.scope);

                    // New version available?
                    reg.addEventListener('updatefound', () => {
                    const worker = reg.installing;
                    worker?.addEventListener('statechange', () => {
                    if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                    showUpdateBanner();
                    }
                    });
                    });
                    })
                    .catch(err => console.warn('[PWA] SW registration failed:', err));
                    });
                    }

                    // ── Update available banner ────────────────────────────────────────────
                    function showUpdateBanner() {
                    const banner = document.createElement('div');
                    banner.id = 'pwa-update-banner';
                    banner.innerHTML = `
                    <div style="
                    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
                    background:#0a0a0a; color:#fff; border:1px solid #c9a96e;
                    border-radius:10px; padding:12px 20px; z-index:9999;
                    display:flex; align-items:center; gap:14px;
                    box-shadow:0 4px 20px rgba(0,0,0,.3); font-size:.82rem;
                    max-width:340px; width:calc(100% - 40px);">
                    <span style="color:#c9a96e; font-size:1.1rem;">🔄</span>
                    <span>New version available!</span>
                    <button onclick="updateApp()" style="
                    background:#c9a96e; color:#000; border:none;
                    border-radius:6px; padding:5px 14px; font-weight:600;
                    cursor:pointer; font-size:.78rem;">Update</button>
                    <button onclick="this.closest('#pwa-update-banner').remove()" style="
                    background:transparent; border:none; color:rgba(255,255,255,.4);
                    cursor:pointer; font-size:1rem;">✕</button>
                    </div>`;
                    document.body.appendChild(banner);
                    }

                    function updateApp() {
                    navigator.serviceWorker.getRegistration().then(reg => {
                    reg?.waiting?.postMessage({ type: 'SKIP_WAITING' });
                    window.location.reload();
                    });
                    }

                    // ── PWA Install Prompt ─────────────────────────────────────────────────
                    let deferredPrompt;

                    window.addEventListener('beforeinstallprompt', e => {
                    e.preventDefault();
                    deferredPrompt = e;
                    showInstallButton();
                    });

                    function showInstallButton() {
                    // Topbar এ install button দেখাও
                    const topbar = document.querySelector('.topbar-right');
                    if (!topbar || document.getElementById('pwa-install-btn')) return;

                    const btn = document.createElement('button');
                    btn.id    = 'pwa-install-btn';
                    btn.title = 'Install CLOZEY ERP App';
                    btn.className = 'topbar-icon-btn';
                    btn.innerHTML = '<i class="bi bi-download" style="font-size:.95rem;"></i>';
                    btn.style.cssText = 'border-color:#c9a96e; color:#c9a96e;';
                    btn.onclick = installApp;
                    topbar.insertBefore(btn, topbar.firstChild);
                    }

                    async function installApp() {
                    if (!deferredPrompt) return;
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log('[PWA] Install outcome:', outcome);
                    deferredPrompt = null;
                    document.getElementById('pwa-install-btn')?.remove();
                    }

                    window.addEventListener('appinstalled', () => {
                    console.log('[PWA] App installed!');
                    document.getElementById('pwa-install-btn')?.remove();
                    deferredPrompt = null;
                    });
                </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>