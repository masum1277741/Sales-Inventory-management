    <!-- ══ MAIN CONTENT ════════════════════════════════════════════════════════ -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- ══ Global Search Command Palette ══════════════════════════════════ -->
    <div class="search-overlay" id="searchOverlay" onclick="if(event.target===this)closeSearchPalette()">
        <div class="search-palette">
            <div class="search-palette-input">
                <i class="bi bi-search"></i>
                <input type="text" id="globalSearchInput" placeholder="Search products, customers, invoices, suppliers..." autocomplete="off" />
                <kbd>ESC</kbd>
            </div>
            <div class="search-palette-results" id="searchResults">
                <div class="search-empty-state">
                    <i class="bi bi-search"></i>
                    <p>প্রোডাক্ট, customer, invoice, supplier, gift card — যা খুঁজছেন টাইপ করুন</p>
                    <div class="search-hints">
                        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
                        <span><kbd>Enter</kbd> select</span>
                        <span><kbd>Esc</kbd> close</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ SCRIPTS ════════════════════════════════════════════════════════════ -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        // ── Sidebar Toggle ───────────────────────────────────────────────────
        $('#sidebarToggle').on('click', function () {
        if ($(window).width() <= 768) {
        $('body').toggleClass('sidebar-open');
        } else {
        $('body').toggleClass('sidebar-collapsed');
        localStorage.setItem('sidebarCollapsed', $('body').hasClass('sidebar-collapsed'));
        }
        });
        if (localStorage.getItem('sidebarCollapsed') === 'true') $('body').addClass('sidebar-collapsed');

        // ── Toastr Config ────────────────────────────────────────────────────
        toastr.options = { positionClass: 'toast-top-right', timeOut: 3500, closeButton: true, progressBar: true };

        // ── TempData Notifications ───────────────────────────────────────────
        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["Success"])');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["Error"])');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>toastr.warning('@Html.Raw(TempData["Warning"])');</text>
        }

        // ── Default DataTable Init ───────────────────────────────────────────
        function initDataTable(selector, options) {
        if ($(selector).length) {
        $(selector).DataTable($.extend({
        responsive: true, pageLength: 25,
        language: { search: '', searchPlaceholder: 'Search...' }
        }, options || {}));
        }
        }

        // ── Delete Confirm ───────────────────────────────────────────────────
        function confirmDelete(url, name) {
        Swal.fire({ title: 'Delete?', text: `Delete "${name}"?`, icon: 'warning',
        showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes, delete!' })
        .then((result) => { if (result.isConfirmed) window.location.href = url; });
        }
        // ── Logout Confirm ───────────────────────────────────────────────────
        function doLogout(formId) {
        Swal.fire({
        title: 'Logout?',
        text: 'Are you sure you want to logout?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, logout!',
        cancelButtonText: 'Cancel'
        }).then((result) => {
        if (result.isConfirmed) document.getElementById(formId).submit();
        });
        }
        // ── Select2 Init ─────────────────────────────────────────────────────
        $(document).ready(function () {
        $('select.select2').select2({ theme: 'bootstrap-5', width: '100%' });
        });

        // ══════════════════════════════════════════════════════════════════════
        // GLOBAL SEARCH (Ctrl+K Command Palette)
        // ══════════════════════════════════════════════════════════════════════
        let searchDebounce;
        let flatResults = [];
        let activeIndex = -1;

        function openSearchPalette() {
            document.getElementById('searchOverlay').classList.add('open');
            const input = document.getElementById('globalSearchInput');
            input.value = '';
            input.focus();
            showEmptyState();
        }

        function closeSearchPalette() {
            document.getElementById('searchOverlay').classList.remove('open');
            clearTimeout(searchDebounce);
        }

        function showEmptyState() {
            document.getElementById('searchResults').innerHTML = `
                <div class="search-empty-state">
                    <i class="bi bi-search"></i>
                    <p>প্রোডাক্ট, customer, invoice, supplier, gift card — যা খুঁজছেন টাইপ করুন</p>
                    <div class="search-hints">
                        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
                        <span><kbd>Enter</kbd> select</span>
                        <span><kbd>Esc</kbd> close</span>
                    </div>
                </div>`;
            flatResults = [];
            activeIndex = -1;
        }

        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const overlay = document.getElementById('searchOverlay');
                overlay.classList.contains('open') ? closeSearchPalette() : openSearchPalette();
            }

            if (e.key === 'Escape' && document.getElementById('searchOverlay').classList.contains('open')) {
                closeSearchPalette();
            }
        });

        document.getElementById('globalSearchInput')?.addEventListener('input', function () {
            clearTimeout(searchDebounce);
            const val = this.value.trim();

            if (val.length < 2) {
                showEmptyState();
                return;
            }

            document.getElementById('searchResults').innerHTML = `<div class="search-loading">খোঁজা হচ্ছে...</div>`;

            searchDebounce = setTimeout(async () => {
                try {
                    const groups = await fetch(`/Search/Global?keyword=${encodeURIComponent(val)}`).then(r => r.json());
                    renderSearchResults(groups);
                } catch {
                    document.getElementById('searchResults').innerHTML = `<div class="search-loading">কিছু ভুল হয়েছে, আবার চেষ্টা করুন।</div>`;
                }
            }, 250);
        });

        function renderSearchResults(groups) {
            flatResults = [];
            activeIndex = -1;

            if (!groups.length) {
                document.getElementById('searchResults').innerHTML = `
                    <div class="search-empty-state">
                        <i class="bi bi-emoji-frown"></i>
                        <p>কোনো ফলাফল পাওয়া যায়নি।</p>
                    </div>`;
                return;
            }

            let html = '';
            groups.forEach(group => {
                html += `<div class="search-cat-label">${escapeHtml(group.category)}</div>`;
                group.items.forEach(item => {
                    const idx = flatResults.length;
                    flatResults.push(item);
                    html += `
                        <div class="search-result-item" data-idx="${idx}" data-url="${escapeHtml(item.url)}" onclick="navigateTo(this.dataset.url)">
                            <div class="sr-icon"><i class="bi ${escapeHtml(group.icon || 'bi-search')}"></i></div>
                            <div class="sr-text">
                                <div class="sr-title">${escapeHtml(item.title)}</div>
                                ${item.subtitle ? `<div class="sr-subtitle">${escapeHtml(item.subtitle)}</div>` : ''}
                            </div>
                            ${item.badge ? `<span class="sr-badge ${escapeHtml(item.badgeColor || 'secondary')}">${escapeHtml(item.badge)}</span>` : ''}
                        </div>`;
                });
            });

            document.getElementById('searchResults').innerHTML = html;
        }

        function escapeHtml(s) {
            return (s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function navigateTo(url) {
            closeSearchPalette();
            window.location.href = url;
        }

        document.getElementById('globalSearchInput')?.addEventListener('keydown', function (e) {
            const items = document.querySelectorAll('.search-result-item');
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = Math.min(activeIndex + 1, items.length - 1);
                updateActiveItem(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = Math.max(activeIndex - 1, 0);
                updateActiveItem(items);
            } else if (e.key === 'Enter' && activeIndex >= 0) {
                e.preventDefault();
                navigateTo(flatResults[activeIndex].url);
            }
        });

        function updateActiveItem(items) {
            items.forEach(i => i.classList.remove('active'));
            if (items[activeIndex]) {
                items[activeIndex].classList.add('active');
                items[activeIndex].scrollIntoView({ block: 'nearest' });
            }
        }


        const BulkActions = {
            selected: new Set(),
            rowDataMap: {},    

            init(tableSelector, checkboxClass) {
                this.tableSelector  = tableSelector;
                this.checkboxClass  = checkboxClass;
                this.selected.clear();
                this.updateToolbar();
            },

            toggleRow(id, checked, label) {
                if (checked) { this.selected.add(id); this.rowDataMap[id] = label; }
                else this.selected.delete(id);

                $(`#row-${id}`).toggleClass('row-selected', checked);
                this.updateToolbar();
            },

            toggleAll(checked) {
                $(`.${this.checkboxClass}`).each((_, el) => {
                    el.checked = checked;
                    const id = parseInt(el.value);
                    const label = el.dataset.label || '';
                    this.toggleRow(id, checked, label);
                });
            },

            clear() {
                this.selected.clear();
                $(`.${this.checkboxClass}`).prop('checked', false);
                $(this.tableSelector + ' tr').removeClass('row-selected');
                $('#selectAllCheckbox').prop('checked', false);
                this.updateToolbar();
            },

            updateToolbar() {
                const count = this.selected.size;
                const toolbar = document.getElementById('bulkToolbar');
                if (!toolbar) return;
                toolbar.classList.toggle('show', count > 0);
                const countEl = document.getElementById('bulkCount');
                if (countEl) countEl.textContent = `${count} selected`;
            },

            getIds() { return Array.from(this.selected); }
        };

        function bulkCheckboxChanged(el) {
            BulkActions.toggleRow(parseInt(el.value), el.checked, el.dataset.label || '');
        }
        function bulkSelectAll(el) {
            BulkActions.toggleAll(el.checked);
        }
        function bulkClearSelection() {
            BulkActions.clear();
        }

        // ══════════════════════════════════════════════════════════════════════
        // NOTIFICATION CENTER
        // ══════════════════════════════════════════════════════════════════════
        let notifLoaded = false;

        // ── Initial unread count load + polling ──────────────────────────────────
        async function refreshUnreadCount() {
            try {
                const data = await fetch('/Notification/UnreadCount').then(r => r.json());
                const badge = document.getElementById('notifBadge');
                if (data.count > 0) {
                    badge.textContent = data.count > 99 ? '99+' : data.count;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            } catch {}
        }

        refreshUnreadCount();
        setInterval(refreshUnreadCount, 60000); 

        // ── Load full feed when bell clicked ─────────────────────────────────────
        async function loadNotificationFeed() {
            const body = document.getElementById('notifPanelBody');
            body.innerHTML = `<div class="notif-empty"><i class="bi bi-hourglass-split"></i><p>Loading...</p></div>`;

            try {
                const feed = await fetch('/Notification/GetFeed').then(r => r.json());
                renderNotifFeed(feed);
                refreshUnreadCount();
            } catch {
                body.innerHTML = `<div class="notif-empty"><i class="bi bi-wifi-off"></i><p>Failed to load.</p></div>`;
            }
        }

        function renderNotifFeed(feed) {
            const body = document.getElementById('notifPanelBody');

            if (!feed.notifications.length) {
                body.innerHTML = `
                    <div class="notif-empty">
                        <i class="bi bi-bell-slash"></i>
                        <p>কোনো notification নেই — সব ঠিক আছে!</p>
                    </div>`;
                return;
            }

            body.innerHTML = feed.notifications.map(n => `
                <div class="notif-item ${n.isRead ? '' : 'unread'}" onclick="handleNotifClick(${n.id}, '${n.actionUrl || ''}')">
                    <div class="notif-icon ${n.severity}"><i class="bi ${n.icon}"></i></div>
                    <div class="notif-content">
                        <div class="notif-title">${escapeHtmlNotif(n.title)}</div>
                        <div class="notif-msg">${escapeHtmlNotif(n.message)}</div>
                        <div class="notif-time">${n.timeAgo}</div>
                    </div>
                    <button class="notif-close-btn" onclick="event.stopPropagation();dismissNotif(${n.id}, this)">
                        <i class="bi bi-x"></i>
                    </button>
                </div>`).join('');
        }

        function escapeHtmlNotif(s) {
            return (s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }

        // ── Click → mark read + navigate ──────────────────────────────────────────
        function handleNotifClick(id, url) {
            $.post('/Notification/MarkAsRead', { id, __RequestVerificationToken: notifTok() });
            if (url) window.location.href = url;
            else { refreshUnreadCount(); }
        }

        function dismissNotif(id, btn) {
            $.post('/Notification/Delete', { id, __RequestVerificationToken: notifTok() }, () => {
                btn.closest('.notif-item').remove();
                refreshUnreadCount();
            });
        }

        function markAllNotificationsRead() {
            $.post('/Notification/MarkAllAsRead', { __RequestVerificationToken: notifTok() }, d => {
                if (d.success) {
                    toastr.success(d.message);
                    document.querySelectorAll('.notif-item.unread').forEach(el => el.classList.remove('unread'));
                    refreshUnreadCount();
                }
            });
        }

        function notifTok() {
            return document.querySelector('[name=__RequestVerificationToken]')?.value || '';
        }


        let appHubConnection = null;

        function setLiveStatus(status) {
            const dot = document.getElementById('liveDot');
            if (!dot) return;
            dot.className = 'live-dot ' + status;  // connected | connecting | disconnected
        }

        async function startSignalRConnection() {
            if (typeof signalR === 'undefined') return;

            appHubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/app')
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])  // exponential-ish backoff
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            appHubConnection.onreconnecting(() => setLiveStatus('connecting'));
            appHubConnection.onreconnected(() => setLiveStatus('connected'));
            appHubConnection.onclose(() => setLiveStatus('disconnected'));

        
            appHubConnection.on('StockUpdated', data => {
                document.dispatchEvent(new CustomEvent('rt:stockUpdated', { detail: data }));
            });

            appHubConnection.on('SaleCompleted', data => {
                document.dispatchEvent(new CustomEvent('rt:saleCompleted', { detail: data }));
            });

            appHubConnection.on('LowStockAlert', data => {
                document.dispatchEvent(new CustomEvent('rt:lowStockAlert', { detail: data }));
              
                if (typeof toastr !== 'undefined') {
                    toastr.warning(`${data.productName} — মাত্র ${data.quantity} pcs বাকি!`, 'Low Stock', { timeOut: 4000 });
                }
            });

            try {
                await appHubConnection.start();
                setLiveStatus('connected');
            } catch (err) {
                setLiveStatus('disconnected');
                console.warn('[SignalR] Connection failed:', err);
                setTimeout(startSignalRConnection, 5000); 
            }
        }

        document.addEventListener('DOMContentLoaded', startSignalRConnection);

    </script>
            
                <script>
                    if ('serviceWorker' in navigator) {
                    window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js', { scope: '/' })
                    .then(reg => {
                    console.log('[PWA] Service Worker registered:', reg.scope);

                    // New version available?
                    reg.addEventListener('updatefound', () => {
                    const worker = reg.installing;
                    worker?.addEventListener('statechange', () => {
                    if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                    showUpdateBanner();
                    }
                    });
                    });
                    })
                    .catch(err => console.warn('[PWA] SW registration failed:', err));
                    });
                    }

                    // ── Update available banner ────────────────────────────────────────────
                    function showUpdateBanner() {
                    const banner = document.createElement('div');
                    banner.id = 'pwa-update-banner';
                    banner.innerHTML = `
                    <div style="
                    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
                    background:#0a0a0a; color:#fff; border:1px solid #c9a96e;
                    border-radius:10px; padding:12px 20px; z-index:9999;
                    display:flex; align-items:center; gap:14px;
                    box-shadow:0 4px 20px rgba(0,0,0,.3); font-size:.82rem;
                    max-width:340px; width:calc(100% - 40px);">
                    <span style="color:#c9a96e; font-size:1.1rem;">🔄</span>
                    <span>New version available!</span>
                    <button onclick="updateApp()" style="
                    background:#c9a96e; color:#000; border:none;
                    border-radius:6px; padding:5px 14px; font-weight:600;
                    cursor:pointer; font-size:.78rem;">Update</button>
                    <button onclick="this.closest('#pwa-update-banner').remove()" style="
                    background:transparent; border:none; color:rgba(255,255,255,.4);
                    cursor:pointer; font-size:1rem;">✕</button>
                    </div>`;
                    document.body.appendChild(banner);
                    }

                    function updateApp() {
                    navigator.serviceWorker.getRegistration().then(reg => {
                    reg?.waiting?.postMessage({ type: 'SKIP_WAITING' });
                    window.location.reload();
                    });
                    }

                    // ── PWA Install Prompt ─────────────────────────────────────────────────
                    let deferredPrompt;

                    window.addEventListener('beforeinstallprompt', e => {
                    e.preventDefault();
                    deferredPrompt = e;
                    showInstallButton();
                    });

                    function showInstallButton() {
             
                    const topbar = document.querySelector('.topbar-right');
                    if (!topbar || document.getElementById('pwa-install-btn')) return;

                    const btn = document.createElement('button');
                    btn.id    = 'pwa-install-btn';
                    btn.title = 'Install CLOZEY ERP App';
                    btn.className = 'topbar-icon-btn';
                    btn.innerHTML = '<i class="bi bi-download" style="font-size:.95rem;"></i>';
                    btn.style.cssText = 'border-color:#c9a96e; color:#c9a96e;';
                    btn.onclick = installApp;
                    topbar.insertBefore(btn, topbar.firstChild);
                    }

                    async function installApp() {
                    if (!deferredPrompt) return;
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log('[PWA] Install outcome:', outcome);
                    deferredPrompt = null;
                    document.getElementById('pwa-install-btn')?.remove();
                    }

                    window.addEventListener('appinstalled', () => {
                    console.log('[PWA] App installed!');
                    document.getElementById('pwa-install-btn')?.remove();
                    deferredPrompt = null;
                    });
                </script>
    @await RenderSectionAsync("Scripts", required: false)

<div class="bulk-toolbar" id="bulkToolbar">
    <span class="bt-count" id="bulkCount">0 selected</span>
    <div id="bulkActionButtons" class="d-flex gap-2"></div>
    <button class="bt-close" onclick="bulkClearSelection()" title="Clear selection">
        <i class="bi bi-x-lg"></i>
    </button>
</div>
</body>
</html>
