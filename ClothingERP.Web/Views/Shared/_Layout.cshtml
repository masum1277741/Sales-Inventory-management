    <!-- ══ TOP BAR ════════════════════════════════════════════════════════════ -->
    <header id="topbar">
        <button class="btn btn-sm btn-light" id="sidebarToggle" type="button">
            <i class="bi bi-list fs-5"></i>
        </button>
        <span class="page-title">@(ViewData["Title"] ?? "Dashboard")</span>

        <!-- ══ Global Search Trigger ═══════════════════════════════════════ -->
        <button class="search-trigger-btn d-none d-md-flex" type="button" onclick="openSearchPalette()">
            <i class="bi bi-search"></i>
            <span>Search anything...</span>
