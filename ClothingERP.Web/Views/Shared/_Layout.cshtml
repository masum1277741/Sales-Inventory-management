            </a>

            <!-- ══ Notification Bell ═══════════════════════════════════════════════ -->
            <div class="dropdown notif-dropdown">
                <button class="topbar-icon-btn position-relative" data-bs-toggle="dropdown"
                        onclick="loadNotificationFeed()" title="Notifications">
                    <i class="bi bi-bell" style="font-size:.95rem;"></i>
                    <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                </button>

                <div class="dropdown-menu dropdown-menu-end notif-panel">
                    <div class="notif-panel-header">
                        <span class="fw-semibold">Notifications</span>
