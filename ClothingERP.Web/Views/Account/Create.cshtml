@model CreateAccountTransactionDto
@{
    ViewData["Title"] = "Add Transaction";
    decimal rateBDT = (decimal)(ViewBag.RateBDT ?? 110m);
    decimal rateMVR = (decimal)(ViewBag.RateMVR ?? 15.42m);
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0">
            <i class="bi bi-plus-square me-2 text-primary"></i>Add Transaction
        </h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-action="Index">Accounts</a></li>
            <li class="breadcrumb-item active">Add</li>
        </ol></nav>
    </div>
    <a asp-action="Index" class="btn btn-light border">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">
                    <i class="bi bi-journal-plus me-2 text-primary"></i>Transaction Details
                </span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <!-- Type Selector -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Transaction Type <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-3">
                            <div class="flex-fill">
                                <input type="radio" class="btn-check" name="TransactionType"
                                       id="typeIncome" value="Income" checked
                                       onchange="updateCategories('Income')" />
                                <label class="btn btn-outline-success w-100 py-3" for="typeIncome">
                                    <i class="bi bi-arrow-down-circle-fill d-block fs-3 mb-1"></i>
                                    <span class="fw-bold">Income</span>
                                </label>
                            </div>
                            <div class="flex-fill">
                                <input type="radio" class="btn-check" name="TransactionType"
                                       id="typeExpense" value="Expense"
                                       onchange="updateCategories('Expense')" />
                                <label class="btn btn-outline-danger w-100 py-3" for="typeExpense">
                                    <i class="bi bi-arrow-up-circle-fill d-block fs-3 mb-1"></i>
                                    <span class="fw-bold">Expense</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Category -->
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">
                                Category <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Category" class="form-select" id="categorySelect">
                                <option value="">— Select Category —</option>
                                <optgroup label="Income" id="incomeGroup">
                                    <option>Sales Revenue</option>
                                    <option>Other Income</option>
                                    <option>Interest Income</option>
                                    <option>Discount Received</option>
                                    <option>Commission Income</option>
                                </optgroup>
                                <optgroup label="Expense" id="expenseGroup" style="display:none;">
                                    <option>Rent</option>
                                    <option>Salary & Wages</option>
                                    <option>Utilities</option>
                                    <option>Marketing & Advertising</option>
                                    <option>Transport & Delivery</option>
                                    <option>Office Supplies</option>
                                    <option>Bank Charges</option>
                                    <option>Repairs & Maintenance</option>
                                    <option>Insurance</option>
                                    <option>Other Expense</option>
                                </optgroup>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <!-- Date -->
                        <div class="col-md-6">
                            <label asp-for="TransactionDate" class="form-label fw-semibold">
                                Date <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TransactionDate" class="form-control" type="date" />
                            <span asp-validation-for="TransactionDate" class="text-danger small"></span>
                        </div>

                        <!-- Amount with Currency Conversion -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Amount <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2">
                                <!-- USD -->
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light fw-bold text-success">$</span>
                                        <input asp-for="Amount" id="amtUSD" class="form-control"
                                               type="number" step="0.01" min="0.01"
                                               placeholder="USD" oninput="convertAmt('USD')" />
                                    </div>
                                    <small class="text-muted" style="font-size:.65rem;">US Dollar</small>
                                </div>
                                <!-- BDT (display only) -->
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light fw-bold"
                                              style="color:#065f46;">৳</span>
                                        <input id="amtBDT" class="form-control"
                                               type="number" step="1" min="0"
                                               placeholder="BDT" oninput="convertAmt('BDT')" />
                                    </div>
                                    <small class="text-muted" style="font-size:.65rem;">
                                        1 USD = ৳@rateBDT.ToString("N2")
                                    </small>
                                </div>
                                <!-- MVR (display only) -->
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light fw-bold"
                                              style="color:#1e3a8a;">Rf</span>
                                        <input id="amtMVR" class="form-control"
                                               type="number" step="0.01" min="0"
                                               placeholder="MVR" oninput="convertAmt('MVR')" />
                                    </div>
                                    <small class="text-muted" style="font-size:.65rem;">
                                        1 USD = Rf@rateMVR.ToString("N2")
                                    </small>
                                </div>
                            </div>
                            <div id="amtPreview" class="mt-2 p-2 rounded small text-muted"
                                 style="background:#f8f9ff;display:none;">
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <!-- Reference -->
                        <div class="col-md-6">
                            <label asp-for="ReferenceNumber" class="form-label fw-semibold">
                                Reference #
                            </label>
                            <input asp-for="ReferenceNumber" class="form-control"
                                   placeholder="Optional" />
                        </div>

                        <!-- Description -->
                        <div class="col-md-6">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Description
                            </label>
                            <input asp-for="Description" class="form-control"
                                   placeholder="Optional notes" />
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Save Transaction
                        </button>
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
const RATE_BDT = @rateBDT;
const RATE_MVR = @rateMVR;

function updateCategories(type) {
    document.getElementById('categorySelect').value = '';
    if (type === 'Income') {
        document.getElementById('incomeGroup').style.display  = '';
        document.getElementById('expenseGroup').style.display = 'none';
    } else {
        document.getElementById('incomeGroup').style.display  = 'none';
        document.getElementById('expenseGroup').style.display = '';
    }
}

function convertAmt(from) {
    const usdEl = document.getElementById('amtUSD');
    const bdtEl = document.getElementById('amtBDT');
    const mvrEl = document.getElementById('amtMVR');
    const prev  = document.getElementById('amtPreview');

    let usd = 0;
    if (from === 'USD') {
        usd = parseFloat(usdEl.value) || 0;
        bdtEl.value = usd > 0 ? (usd * RATE_BDT).toFixed(0) : '';
        mvrEl.value = usd > 0 ? (usd * RATE_MVR).toFixed(2) : '';
    } else if (from === 'BDT') {
        const bdt = parseFloat(bdtEl.value) || 0;
        usd = bdt / RATE_BDT;
        usdEl.value = usd > 0 ? usd.toFixed(2) : '';
        mvrEl.value = usd > 0 ? (usd * RATE_MVR).toFixed(2) : '';
    } else {
        const mvr = parseFloat(mvrEl.value) || 0;
        usd = mvr / RATE_MVR;
        usdEl.value = usd > 0 ? usd.toFixed(2) : '';
        bdtEl.value = usd > 0 ? (usd * RATE_BDT).toFixed(0) : '';
    }

    if (usd > 0) {
        prev.style.display = '';
        prev.innerHTML = `<i class="bi bi-info-circle me-1"></i>
            <strong>$${usd.toFixed(2)}</strong> =
            <span style="color:#065f46;">৳${(usd*RATE_BDT).toFixed(0)}</span> /
            <span style="color:#1e3a8a;">Rf${(usd*RATE_MVR).toFixed(2)}</span>`;
    } else {
        prev.style.display = 'none';
    }
}

$(function () {
    updateCategories('Income');
});
</script>
}