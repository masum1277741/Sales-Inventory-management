@model IEnumerable<GRNListDto>
@{
    ViewData["Title"] = "Goods Receipt Notes"; var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-box-arrow-in-down me-2 text-primary"></i>Goods Receipt Notes</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Purchase</a></li>
                <li class="breadcrumb-item active">GRN</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateGRN" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New GRN</a>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-bag me-1"></i>PO List</a>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#e8f0fe;"><i class="bi bi-box-arrow-in-down" style="color:#4f7cff;"></i></div>
                <div><div class="text-muted small">Total GRNs</div><h4 class="mb-0 fw-bold">@ViewBag.TotalCount</h4></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#e8f5e9;"><i class="bi bi-currency-dollar" style="color:#43a047;"></i></div>
                <div><div class="text-muted small">Total Value</div><h4 class="mb-0 fw-bold">৳@((decimal)ViewBag.TotalValue).ToString("N0")</h4></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#fff3e0;"><i class="bi bi-calendar3" style="color:#f57c00;"></i></div>
                <div><div class="text-muted small">This Month</div><h4 class="mb-0 fw-bold">@items.Count(g => g.ReceivedDate.Month == DateTime.Today.Month)</h4></div>
            </div>
        </div>
    </div>
</div>

<!-- Date Filter -->
<form asp-action="GRN" method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3 d-flex gap-2 align-items-center">
        <i class="bi bi-calendar-range text-muted"></i>
        <input type="date" name="fromDate" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.FromDate" />
        <span class="text-muted small">to</span>
        <input type="date" name="toDate" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.ToDate" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Filter</button>
        <a asp-action="GRN" class="btn btn-sm btn-light border">Reset</a>
        <span class="ms-auto text-muted small">@items.Count filtered</span>
    </div>
</form>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="grnTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="50">#</th>
                        <th>GRN Number</th>
                        <th>PO Number</th>
                        <th>Supplier</th>
                        <th>Received Date</th>
                        <th class="text-end">Total Value</th>
                        <th class="text-center" width="100">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var grn in items)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td class="fw-semibold small text-success">@grn.GRNNumber</td>
                            <td><a asp-action="Details" asp-route-id="@grn.PurchaseOrderId" class="text-primary small text-decoration-none">@grn.PONumber</a></td>
                            <td class="small">@grn.SupplierName</td>
                            <td class="small text-muted">@grn.ReceivedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end fw-semibold">৳@grn.TotalValue.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="GRNDetails" asp-route-id="@grn.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>$(function() { initDataTable('#grnTable', { order:[[4,'desc']] }); });</script>
}