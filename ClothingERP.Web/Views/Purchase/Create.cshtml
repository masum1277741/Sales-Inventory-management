@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-bag-plus me-2 text-primary"></i>Create Purchase Order</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Purchase</a></li>
                <li class="breadcrumb-item active">New PO</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<form asp-action="Create" method="post" id="poForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="itemsJson" name="itemsJson" />

    <div class="row g-4">
        <!-- Left -->
        <div class="col-lg-8">

            <!-- PO Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Order Information</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
                            <select name="SupplierId" class="form-select select2" id="supplierSelect" required>
                                <option value="">— Select Supplier —</option>
                                @foreach (var s in (IEnumerable<SupplierListDto>)ViewBag.Suppliers)
                                {
                                    <option value="@s.Id">@s.CompanyName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Expected Delivery</label>
                            <input type="date" name="ExpectedDeliveryDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Notes</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Search + Items -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="bi bi-list-ul me-2 text-primary"></i>Order Items <span class="badge bg-primary ms-1" id="itemCount">0</span></span>
                </div>
                <div class="card-body p-4">
                    <!-- Search Bar -->
                    <div class="position-relative mb-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="productSearch" class="form-control" placeholder="Search product by name, SKU or barcode..." autocomplete="off" />
                        </div>
                        <div id="searchDD" class="position-absolute w-100 bg-white border rounded shadow-sm" style="z-index:1000;max-height:250px;overflow-y:auto;display:none;top:100%;"></div>
                    </div>

                    <!-- Items Table -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle" id="itemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width:200px;">Product</th>
                                    <th class="text-center" style="width:100px;">Qty</th>
                                    <th class="text-end" style="width:120px;">Unit Cost</th>
                                    <th class="text-end" style="width:80px;">Discount</th>
                                    <th class="text-end" style="width:110px;">Total</th>
                                    <th style="width:50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="itemsTbody">
                                <tr id="emptyRow">
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-search fs-3 d-block mb-2"></i>
                                        Search and add products above
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-calculator me-2 text-primary"></i>Order Summary</span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Sub Total</span>
                        <span class="fw-semibold" id="sumSubtotal">৳0.00</span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Discount (৳)</label>
                        <input type="number" class="form-control form-control-sm" name="DiscountAmount" id="globalDiscount" value="0" min="0" step="0.01" oninput="calcTotal()" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Tax (৳)</label>
                        <input type="number" class="form-control form-control-sm" name="TaxAmount" id="globalTax" value="0" min="0" step="0.01" oninput="calcTotal()" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Shipping (৳)</label>
                        <input type="number" class="form-control form-control-sm" name="ShippingCost" id="globalShipping" value="0" min="0" step="0.01" oninput="calcTotal()" />
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>TOTAL</span><span id="sumTotal">৳0.00</span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 d-grid gap-2">
                    <button type="submit" class="btn btn-primary" onclick="prepareSubmit()">
                        <i class="bi bi-check-circle me-1"></i>Create Purchase Order
                    </button>
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(function() { $('#supplierSelect').select2({ theme:'bootstrap-5', width:'100%' }); });

        const poItems = [];
        let searchTimer;

        document.getElementById('productSearch').addEventListener('input', e => {
            clearTimeout(searchTimer);
            const val = e.target.value.trim();
            if (val.length < 2) { $('#searchDD').hide(); return; }
            searchTimer = setTimeout(async () => {
                const data = await fetch(`/Purchase/SearchVariants?keyword=${encodeURIComponent(val)}`).then(r => r.json());
                const dd = $('#searchDD');
                if (!data.length) { dd.hide(); return; }
                dd.html(data.map(v => `
                    <div class="p-2 border-bottom" style="cursor:pointer;"
                         onmousedown="event.preventDefault();addItem(${JSON.stringify(v).replace(/"/g,'&quot;')})">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold small">${v.productName}</div>
                                <div class="text-muted" style="font-size:.72rem;">${v.sizeName} · ${v.colorName} · ${v.barcode}</div>
                            </div>
                            <div class="text-end"><div class="fw-bold small text-primary">৳${v.costPrice}</div></div>
                        </div>
                    </div>
                `).join('')).show();
            }, 250);
        });

        document.addEventListener('click', e => { if (!e.target.closest('#productSearch, #searchDD')) $('#searchDD').hide(); });

        function addItem(v) {
            const existing = poItems.find(i => i.variantId === v.variantId);
            if (existing) { existing.qty++; }
            else { poItems.push({ variantId: v.variantId, productName: v.productName, sizeName: v.sizeName, colorName: v.colorName, barcode: v.barcode, qty: 1, unitCost: v.costPrice, discount: 0 }); }
            document.getElementById('productSearch').value = '';
            $('#searchDD').hide();
            renderItems();
        }

        function removeItem(idx) { poItems.splice(idx, 1); renderItems(); }

        function renderItems() {
            const tbody = document.getElementById('itemsTbody');
            const empty = document.getElementById('emptyRow');
            if (!poItems.length) { tbody.innerHTML = ''; tbody.appendChild(empty); empty.style.display = ''; calcTotal(); return; }
            empty.style.display = 'none';
            tbody.innerHTML = poItems.map((item, i) => `
                <tr>
                    <td>
                        <div class="fw-semibold small">${item.productName}</div>
                        <div class="d-flex gap-1 mt-1">
                            <span class="badge bg-secondary" style="font-size:.6rem;">${item.sizeName}</span>
                            <span class="text-muted" style="font-size:.7rem;">${item.colorName}</span>
                        </div>
                    </td>
                    <td class="text-center">
                        <input type="number" class="form-control form-control-sm text-center" style="width:70px;" value="${item.qty}" min="1" onchange="poItems[${i}].qty=parseInt(this.value)||1;calcTotal();" />
                    </td>
                    <td class="text-end">
                        <input type="number" class="form-control form-control-sm text-end" style="width:90px;" value="${item.unitCost}" step="0.01" min="0" onchange="poItems[${i}].unitCost=parseFloat(this.value)||0;calcTotal();" />
                    </td>
                    <td class="text-end">
                        <input type="number" class="form-control form-control-sm text-end" style="width:70px;" value="${item.discount}" step="0.01" min="0" onchange="poItems[${i}].discount=parseFloat(this.value)||0;calcTotal();" />
                    </td>
                    <td class="text-end fw-semibold small">৳${((item.qty*item.unitCost)-item.discount).toFixed(2)}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(${i})"><i class="bi bi-x-lg"></i></button>
                    </td>
                </tr>
            `).join('');
            document.getElementById('itemCount').textContent = poItems.length;
            calcTotal();
        }

        function calcTotal() {
            const subtotal  = poItems.reduce((s, i) => s + i.qty * i.unitCost - i.discount, 0);
            const discount  = parseFloat(document.getElementById('globalDiscount').value) || 0;
            const tax       = parseFloat(document.getElementById('globalTax').value)      || 0;
            const shipping  = parseFloat(document.getElementById('globalShipping').value) || 0;
            const total     = subtotal - discount + tax + shipping;
            document.getElementById('sumSubtotal').textContent = '৳' + subtotal.toFixed(2);
            document.getElementById('sumTotal').textContent    = '৳' + total.toFixed(2);
        }

        function prepareSubmit() {
            if (!poItems.length) { toastr.error('Add at least one item.'); return false; }
            document.getElementById('itemsJson').value = JSON.stringify(poItems.map(i => ({
                productVariantId: i.variantId, quantity: i.qty, unitCost: i.unitCost, discountAmount: i.discount
            })));
        }
    </script>
}