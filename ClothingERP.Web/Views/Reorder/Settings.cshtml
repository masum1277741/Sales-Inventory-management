@model ReorderSettingsDto
@{
    ViewData["Title"] = "Reorder Settings";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-sliders me-2 text-primary"></i>Reorder Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Reorder Suggestions</a></li>
                <li class="breadcrumb-item active">Settings</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Settings" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Analysis Period (দিন)</label>
                        <input asp-for="AnalysisPeriodDays" class="form-control" type="number" min="7" max="180" />
                        <small class="text-muted">গত কত দিনের বিক্রির ডাটা দিয়ে গড় (velocity) হিসাব হবে — বেশি দিন মানে বেশি stable হিসাব।</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Default Lead Time (দিন)</label>
                        <input asp-for="DefaultLeadTimeDays" class="form-control" type="number" min="1" max="60" />
                        <small class="text-muted">কোনো specific সাপ্লায়ার ইতিহাস না থাকলে এই default ব্যবহার হবে।</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Safety Stock (দিন)</label>
                        <input asp-for="SafetyStockDays" class="form-control" type="number" min="0" max="30" />
                        <small class="text-muted">Lead time এর পরেও কত দিনের অতিরিক্ত buffer stock রাখা উচিত।</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Minimum Daily Velocity</label>
                        <input asp-for="MinDailyVelocity" class="form-control" type="number" step="0.01" min="0" max="10" />
                        <small class="text-muted">এর কম দৈনিক গড় বিক্রি হলে "slow-moving" ধরে suggestion দেখানো হবে না।</small>
                    </div>

                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save Settings
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>