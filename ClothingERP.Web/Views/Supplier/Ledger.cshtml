@model IEnumerable<SupplierLedgerDto>
@{
    ViewData["Title"] = "Supplier Ledger";
    var supplier = (SupplierDto)ViewBag.Supplier;
    var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Ledger — @supplier.CompanyName</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Suppliers</a></li>
                <li class="breadcrumb-item active">Ledger</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success btn-sm" onclick="openPayModal()"><i class="bi bi-cash me-1"></i>Make Payment</button>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="text-muted small mb-1">Company</div>
            <h6 class="fw-bold mb-0">@supplier.CompanyName</h6>
            <small class="text-muted">@supplier.PhoneNumber</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card h-100">
            <div class="text-muted small mb-1">Total Invoiced (Credit)</div>
            <h4 class="fw-bold text-danger mb-0">৳@((decimal)ViewBag.TotalCredit).ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card h-100">
            <div class="text-muted small mb-1">Total Paid (Debit)</div>
            <h4 class="fw-bold text-success mb-0">৳@((decimal)ViewBag.TotalDebit).ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card h-100 border-start border-3 @((decimal)ViewBag.Balance > 0 ? "border-danger" : "border-success")">
            <div class="text-muted small mb-1">Current Balance</div>
            <h4 class="fw-bold @((decimal)ViewBag.Balance > 0 ? "text-danger" : "text-success") mb-0">
                ৳@((decimal)ViewBag.Balance).ToString("N2")
            </h4>
            <small class="@((decimal)ViewBag.Balance > 0 ? "text-danger" : "text-muted")">
                @((decimal)ViewBag.Balance > 0 ? "You owe supplier" : "Clear")
            </small>
        </div>
    </div>
</div>

<!-- Date Filter -->
<form asp-action="Ledger" asp-route-id="@supplier.Id" method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3 d-flex gap-2 align-items-center">
        <i class="bi bi-calendar-range text-muted"></i>
        <input type="date" name="from" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.FromDate" />
        <span class="text-muted small">to</span>
        <input type="date" name="to" class="form-control form-control-sm" style="width:150px;" value="@ViewBag.ToDate" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Filter</button>
        <a asp-action="Ledger" asp-route-id="@supplier.Id" class="btn btn-sm btn-light border">Reset</a>
    </div>
</form>

<!-- Ledger Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="ledgerTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="50">#</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Reference</th>
                        <th class="text-end">Debit (Paid)</th>
                        <th class="text-end">Credit (Invoice)</th>
                        <th class="text-end pe-4">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var entry in items)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td class="small">
                                @entry.EntryDate.ToString("dd MMM yyyy")
                                <br /><span class="text-muted" style="font-size:.7rem;">@entry.EntryDate.ToString("HH:mm")</span>
                            </td>
                            <td>
                                @{
                                    var (cls, lbl) = entry.EntryType switch
                                    {
                                        "Invoice" => ("danger", "Invoice"),
                                        "Payment" => ("success", "Payment"),
                                        "Return" => ("info", "Return"),
                                        "Adjustment" => ("warning", "Adjustment"),
                                        _ => ("secondary", "—")
                                    };
                                }
                                <span class="badge bg-@cls bg-opacity-15 text-@cls px-2">@lbl</span>
                            </td>
                            <td class="small">@(entry.Description ?? "—")</td>
                            <td><code class="small">@(entry.ReferenceNumber ?? "—")</code></td>
                            <td class="text-end text-success fw-semibold">@(entry.Debit > 0 ? "৳" + entry.Debit.ToString("N2") : "—")</td>
                            <td class="text-end text-danger fw-semibold">@(entry.Credit > 0 ? "৳" + entry.Credit.ToString("N2") : "—")</td>
                            <td class="text-end fw-bold pe-4 @(entry.Balance > 0 ? "text-danger" : "text-success")">
                                ৳@entry.Balance.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="ps-4 fw-bold">Total</td>
                        <td class="text-end fw-bold text-success">৳@((decimal)ViewBag.TotalDebit).ToString("N2")</td>
                        <td class="text-end fw-bold text-danger">৳@((decimal)ViewBag.TotalCredit).ToString("N2")</td>
                        <td class="text-end fw-bold pe-4 @((decimal)ViewBag.Balance > 0 ? "text-danger" : "text-success")">
                            ৳@((decimal)ViewBag.Balance).ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="payModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-cash me-2 text-success"></i>Payment to @supplier.CompanyName</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">৳</span>
                        <input type="number" class="form-control" id="pmAmt" value="@((decimal)ViewBag.Balance).ToString(" F2")" step="0.01" min="0.01" />
                    </div>
                    <small class="text-muted">Balance: ৳@((decimal)ViewBag.Balance).ToString("N2")</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Method</label>
                    <select class="form-select" id="pmMethod">
                        <option value="1">Cash</option>
                        <option value="2">Bank Transfer</option>
                        <option value="3">Cheque</option>
                        <option value="4">Mobile Banking</option>
                    </select>
                </div>
                <div>
                    <label class="form-label fw-semibold">Reference</label>
                    <input type="text" class="form-control" id="pmRef" placeholder="Optional" />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success px-4" onclick="submitPay()">Save Payment</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(function() { initDataTable('#ledgerTable', { order:[[1,'desc']], pageLength:50 }); });
        const tok = () => $('[name=__RequestVerificationToken]').val();
        function openPayModal() { new bootstrap.Modal('#payModal').show(); }
        function submitPay() {
            $.post('/Supplier/AddPayment', {
                supplierId: @supplier.Id, amount: parseFloat($('#pmAmt').val()),
                method: $('#pmMethod').val(), reference: $('#pmRef').val(),
                __RequestVerificationToken: tok()
            }, d => {
                if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); }
                else toastr.error(d.message);
            });
        }
    </script>
}