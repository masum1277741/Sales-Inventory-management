@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>404 Not Found — Clothing ERP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #f0f2f5, #e8eaf6);
            font-family: 'Segoe UI', sans-serif;
        }
        .card-404 {
            background: #fff; border-radius: 20px; padding: 48px 40px;
            max-width: 480px; width: 100%;
            box-shadow: 0 8px 40px rgba(0,0,0,.10); text-align: center;
        }
        .num-404 {
            font-size: 6rem; font-weight: 900;
            background: linear-gradient(135deg,#4f7cff,#764ba2);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            line-height: 1;
        }
        .btn-home {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 32px; background: #4f7cff; color: #fff;
            border-radius: 10px; text-decoration: none; font-weight: 600;
        }
        .btn-home:hover { background: #3a6ae0; color: #fff; }
    </style>
</head>
<body>
<div class="card-404">
    <div class="num-404">404</div>
    <h4 class="fw-bold mt-3 mb-2">Page Not Found</h4>
    <p class="text-muted mb-4">The page you are looking for doesn't exist or has been moved.</p>
    <a href="/Dashboard" class="btn-home">
        <i class="bi bi-house-fill"></i> Back to Dashboard
    </a>
</div>
</body>
</html>