@model GiftCardDto
@{
    ViewData["Title"] = "Gift Card Details";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-credit-card-2-front me-2 text-primary"></i>@Model.CardCode</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Gift Cards</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Card Visual -->
        <div class="rounded-4 p-4 text-white mb-3" style="background:linear-gradient(135deg,#0a0a0a,#2a2a2a);min-height:180px;position:relative;">
            <div class="small" style="color:#c9a96e;letter-spacing:2px;">
                @(Model.IsStoreCredit ? "STORE CREDIT" : "GIFT CARD")
            </div>
            <h3 class="fw-bold mt-3 mb-0">$@Model.CurrentBalance.ToString("N2")</h3>
            <div class="small text-muted">of $@Model.InitialValue.ToString("N2") original</div>
            <div class="mt-4"><code class="text-white-50">@Model.CardCode</code></div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr><td class="text-muted">Status</td><td class="text-end fw-bold">@Model.Status</td></tr>
                    <tr><td class="text-muted">Customer</td><td class="text-end">@(Model.CustomerName ?? "—")</td></tr>
                    <tr><td class="text-muted">Recipient</td><td class="text-end">@(Model.RecipientName ?? "—")</td></tr>
                    <tr><td class="text-muted">Issued</td><td class="text-end">@Model.IssuedDate.ToString("dd MMM yyyy")</td></tr>
                    <tr><td class="text-muted">Expiry</td><td class="text-end">@(Model.ExpiryDate?.ToString("dd MMM yyyy") ?? "Never")</td></tr>
                </table>
                @if (Model.Status == "Active")
                {
                    <button class="btn btn-outline-danger btn-sm w-100 mt-3" onclick="cancelCard(@Model.Id)">
                        <i class="bi bi-x-circle me-1"></i>Cancel This Card
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Transaction History</span>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Type</th>
                            <th>Invoice</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end pe-4">Balance After</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td class="ps-4 small">@t.TransactionDate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td><span class="badge bg-secondary">@t.TransactionType</span></td>
                                <td class="small">@(t.SalesInvoiceId.HasValue ? $"INV-{t.SalesInvoiceId}" : "—")</td>
                                <td class="text-end fw-bold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                    @(t.Amount >= 0 ? "+" : "")$@t.Amount.ToString("N2")
                                </td>
                                <td class="text-end pe-4">$@t.BalanceAfter.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        function cancelCard(id) {
            Swal.fire({ title: 'Cancel this card?', text: 'অবশিষ্ট balance শূন্য হয়ে যাবে।', icon: 'warning', showCancelButton: true })
            .then(r => { if (r.isConfirmed) {
                $.post('/GiftCard/Cancel', { id, __RequestVerificationToken: $('[name=__RequestVerificationToken]').val() }, d => {
                    if (d.success) location.reload(); else toastr.error(d.message);
                });
            }});
        }
    </script>
}