@model ClothingERP.Application.DTOs.IssueStoreCreditDto
@{
    ViewData["Title"] = "Issue Store Credit";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-arrow-return-left me-2 text-primary"></i>Issue Store Credit</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Gift Cards</a></li>
                <li class="breadcrumb-item active">Issue Store Credit</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Store credit হলো return/refund এর বিকল্প — cash ফেরত না দিয়ে এই credit দিলে
                    customer পরের কেনাকাটায় ব্যবহার করতে পারবে।
                </div>

                <form asp-action="IssueStoreCredit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Customer <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input type="text" id="custSearch" class="form-control"
                                   placeholder="Customer নাম বা ফোন লিখে খুঁজুন..." autocomplete="off" />
                            <div id="custDropdown" class="position-absolute w-100 bg-white border rounded shadow"
                                 style="z-index:999;display:none;top:100%;max-height:200px;overflow-y:auto;"></div>
                        </div>
                        <input type="hidden" asp-for="CustomerId" />
                        <div id="selectedCustomer" class="mt-2 small text-success"></div>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Credit Amount (USD) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold">$</span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes (optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"
                                  placeholder="কেন store credit দেওয়া হচ্ছে..."></textarea>
                    </div>

                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Issue Store Credit
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timer;
        document.getElementById('custSearch').addEventListener('input', function () {
            clearTimeout(timer);
            const val = this.value.trim();
            if (val.length < 2) { $('#custDropdown').hide(); return; }
            timer = setTimeout(async () => {
                const data = await fetch(`/GiftCard/SearchCustomers?keyword=${encodeURIComponent(val)}`).then(r => r.json());
                const dd = $('#custDropdown');
                if (!data.length) { dd.hide(); return; }
                dd.html(data.map(c => `
                    <div class="p-2 border-bottom" style="cursor:pointer;"
                         onmousedown="event.preventDefault();selectCust(${c.id},'${c.name}','${c.phoneNumber||''}')">
                        <div class="fw-semibold small">${c.name}</div>
                        <div class="text-muted" style="font-size:.72rem;">${c.phoneNumber||''}</div>
                    </div>`).join('')).show();
            }, 250);
        });

        function selectCust(id, name, phone) {
            document.querySelector('[name=CustomerId]').value = id;
            document.getElementById('selectedCustomer').innerHTML =
                `<i class="bi bi-check-circle text-success me-1"></i><strong>${name}</strong> ${phone}`;
            document.getElementById('custSearch').value = '';
            $('#custDropdown').hide();
        }
        document.addEventListener('click', e => {
            if (!e.target.closest('#custSearch,#custDropdown')) $('#custDropdown').hide();
        });
    </script>
}