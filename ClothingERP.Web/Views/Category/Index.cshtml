@{
    ViewData["Title"] = "Category Management";
    var categories = (IEnumerable<CategoryDto>)ViewBag.Categories;
    var subCategories = (IEnumerable<SubCategoryDto>)ViewBag.SubCategories;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-tags me-2 text-primary"></i>Category Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Categories</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4" id="catTabs">
    <li class="nav-item">
        <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#catPane">
            <i class="bi bi-folder me-1"></i>Categories <span class="badge bg-primary ms-1">@categories.Count()</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#subPane">
            <i class="bi bi-folder2-open me-1"></i>Sub-Categories <span class="badge bg-secondary ms-1">@subCategories.Count()</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- ── Categories Tab ────────────────────────────────────────────────── -->
    <div class="tab-pane fade show active" id="catPane">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold"><i class="bi bi-folder me-2 text-primary"></i>All Categories</span>
                <button class="btn btn-primary btn-sm" onclick="openCatModal()">
                    <i class="bi bi-plus-circle me-1"></i>Add Category
                </button>
            </div>
            <div class="card-body p-0">
                <table id="catTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" width="50">#</th>
                            <th>Category</th>
                            <th class="text-center">Sub-cats</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" width="130">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var c in categories)
                        {
                            <tr id="cat-@c.Id">
                                <td class="ps-4 text-muted small">@(i++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(c.ImagePath))
                                        {
                                            <img src="@c.ImagePath" width="36" height="36" class="rounded" style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div style="width:36px;height:36px;background:#e8f0fe;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-folder text-primary"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold small">@c.Name</div>
                                            @if (!string.IsNullOrEmpty(c.Description))
                                            {
                                                <div class="text-muted" style="font-size:.72rem;">@c.Description</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center"><span class="badge bg-info bg-opacity-15 text-info">@c.SubCategoryCount</span></td>
                                <td class="text-center">
                                    <span class="badge rounded-pill @(c.IsActive ? "bg-success" : "bg-danger") bg-opacity-15 @(c.IsActive ? "text-success" : "text-danger") px-2">
                                        @(c.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light border me-1" onclick="openCatModal(@c.Id,'@c.Name','@c.Description',@c.IsActive.ToString().ToLower())">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border me-1" onclick="toggleCat(@c.Id)" title="Toggle Status">
                                        <i class="bi bi-arrow-repeat text-warning"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border" onclick="deleteCat(@c.Id,'@c.Name')" @(c.SubCategoryCount > 0 ? "disabled" : "")>
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ── Sub-Categories Tab ─────────────────────────────────────────────── -->
    <div class="tab-pane fade" id="subPane">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold"><i class="bi bi-folder2-open me-2 text-primary"></i>All Sub-Categories</span>
                <button class="btn btn-primary btn-sm" onclick="openSubModal()">
                    <i class="bi bi-plus-circle me-1"></i>Add Sub-Category
                </button>
            </div>
            <div class="card-body p-0">
                <table id="subTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" width="50">#</th>
                            <th>Sub-Category</th>
                            <th>Parent Category</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" width="100">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int j = 1;
                        }
                        @foreach (var s in subCategories)
                        {
                            <tr id="sub-@s.Id">
                                <td class="ps-4 text-muted small">@(j++)</td>
                                <td class="fw-semibold small">@s.Name</td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary">@s.CategoryName</span></td>
                                <td class="text-center">
                                    <span class="badge rounded-pill @(s.IsActive ? "bg-success" : "bg-danger") bg-opacity-15 @(s.IsActive ? "text-success" : "text-danger") px-2">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light border me-1"
                                            onclick="openSubModal(@s.Id,'@s.Name','@s.Description',@s.CategoryId)">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border" onclick="deleteSub(@s.Id,'@s.Name')">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ══ Category Modal ════════════════════════════════════════════════════ -->
<div class="modal fade" id="catModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="catModalTitle">Add Category</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="catForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="catId" name="_editId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="catName" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea class="form-control" id="catDesc" name="Description" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Image</label>
                        <input type="file" class="form-control" name="image" accept="image/*" />
                    </div>
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="catIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label fw-semibold" for="catIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveCat()">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ══ Sub-Category Modal ════════════════════════════════════════════════ -->
<div class="modal fade" id="subModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="subModalTitle">Add Sub-Category</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="subForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="subId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Parent Category <span class="text-danger">*</span></label>
                        <select class="form-select select2" id="subCatId" name="CategoryId" required>
                            <option value="">— Select Category —</option>
                            @foreach (var c in (IEnumerable<CategoryDto>)ViewBag.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sub-Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subName" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea class="form-control" id="subDesc" name="Description" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveSub()">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            initDataTable('#catTable');
            initDataTable('#subTable');
            $('#subCatId').select2({ theme:'bootstrap-5', width:'100%', dropdownParent: $('#subModal') });
        });

        const tok = () => $('[name=__RequestVerificationToken]').val();

        // ── Category Modal ────────────────────────────────────────────────────────
        function openCatModal(id, name, desc, isActive) {
            const isEdit = !!id;
            $('#catModalTitle').text(isEdit ? 'Edit Category' : 'Add Category');
            $('#catId').val(id || '');
            $('#catName').val(name || '');
            $('#catDesc').val(desc || '');
            $('#catIsActive').prop('checked', isActive !== false);
            new bootstrap.Modal('#catModal').show();
        }

        function saveCat() {
            const id = $('#catId').val();
            const url = id ? `/Category/EditCategory/${id}` : '/Category/CreateCategory';
            const fd = new FormData(document.getElementById('catForm'));
            if (!$('#catName').val().trim()) { toastr.error('Name is required.'); return; }

            fetch(url, { method:'POST', body: fd })
                .then(r => r.json())
                .then(d => {
                    if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); }
                    else toastr.error(d.message);
                });
        }

        function toggleCat(id) {
            $.post('/Category/ToggleCategoryStatus', { id, __RequestVerificationToken: tok() },
                d => { if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); } else toastr.error(d.message); });
        }

        function deleteCat(id, name) {
            Swal.fire({ title:'Delete?', text:`Delete "${name}"?`, icon:'warning', showCancelButton:true, confirmButtonColor:'#d33', confirmButtonText:'Delete' })
            .then(r => { if (r.isConfirmed) {
                $.post('/Category/DeleteCategory', { id, __RequestVerificationToken: tok() },
                    d => { if (d.success) { toastr.success(d.message); $(`#cat-${id}`).fadeOut(); } else toastr.error(d.message); });
            }});
        }

        // ── Sub-Category Modal ────────────────────────────────────────────────────
        function openSubModal(id, name, desc, catId) {
            const isEdit = !!id;
            $('#subModalTitle').text(isEdit ? 'Edit Sub-Category' : 'Add Sub-Category');
            $('#subId').val(id || '');
            $('#subName').val(name || '');
            $('#subDesc').val(desc || '');
            if (catId) $('#subCatId').val(catId).trigger('change');
            new bootstrap.Modal('#subModal').show();
        }

        function saveSub() {
            const id = $('#subId').val();
            const url = id ? `/Category/EditSubCategory/${id}` : '/Category/CreateSubCategory';
            if (!$('#subName').val().trim() || !$('#subCatId').val()) { toastr.error('Fill required fields.'); return; }

            $.post(url, { Name: $('#subName').val(), Description: $('#subDesc').val(),
                          CategoryId: $('#subCatId').val(), __RequestVerificationToken: tok() },
                d => {
                    if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); }
                    else toastr.error(d.message);
                });
        }

        function deleteSub(id, name) {
            Swal.fire({ title:'Delete?', text:`Delete "${name}"?`, icon:'warning', showCancelButton:true, confirmButtonColor:'#d33', confirmButtonText:'Delete' })
            .then(r => { if (r.isConfirmed) {
                $.post('/Category/DeleteSubCategory', { id, __RequestVerificationToken: tok() },
                    d => { if (d.success) { toastr.success(d.message); $(`#sub-${id}`).fadeOut(); } else toastr.error(d.message); });
            }});
        }
    </script>
}