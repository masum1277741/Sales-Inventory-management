@model ClothingERP.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    var today = DateTime.Now.ToString("dddd, dd MMMM yyyy");

    var layout     = (List<WidgetConfigDto>)ViewBag.WidgetLayout;
    var allWidgets = (List<WidgetDefinitionDto>)ViewBag.AvailableWidgets;

    string SizeClass(string size) => size switch
    {
        "Small"  => "col-6 col-md-3",
        "Medium" => "col-md-6",
        "Large"  => "col-lg-8",
        "Full"   => "col-12",
        _        => "col-md-6"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@today</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light border" onclick="openCustomizeModal()">
            <i class="bi bi-grid-3x3-gap me-1"></i>Customize Dashboard
        </button>
        <a asp-controller="Sales" asp-action="POS" class="btn btn-primary">
            <i class="bi bi-cart-plus me-1"></i>New Sale
        </a>
    </div>
</div>

<div class="row g-3" id="widgetContainer">
    @foreach (var w in layout.Where(x => x.IsVisible).OrderBy(x => x.Order))
    {
        <div class="@SizeClass(w.Size) widget-wrapper" data-widget-key="@w.WidgetKey">
            @await Html.PartialAsync($"~/Views/Dashboard/Widgets/_{w.WidgetKey}.cshtml", Model)
        </div>
    }

    @if (!layout.Any(x => x.IsVisible))
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm text-center py-5 text-muted">
                <i class="bi bi-grid-3x3-gap d-block mb-2" style="font-size:2.5rem;"></i>
                সব widget বন্ধ আছে। "Customize Dashboard" থেকে চালু করুন।
            </div>
        </div>
    }
</div>

<!-- ══ Customize Modal ══════════════════════════════════════════════════ -->
<div class="modal fade" id="customizeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Customize Dashboard</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Drag <i class="bi bi-grip-vertical"></i> দিয়ে সাজান, চেকবক্স দিয়ে দেখান/লুকান।</p>
                <div id="widgetConfigList">
                    @foreach (var w in layout.OrderBy(x => x.Order))
                    {
                        var def = allWidgets.First(d => d.WidgetKey == w.WidgetKey);
                        <div class="widget-config-row" data-key="@w.WidgetKey" data-size="@w.Size">
                            <i class="bi bi-grip-vertical drag-handle"></i>
                            <i class="bi @def.Icon"></i>
                            <span class="flex-grow-1">@def.Title</span>
                            @if (def.AllowResize)
                            {
                                <select class="form-select form-select-sm size-select" style="width:90px;">
                                    <option value="Small"  selected="@(w.Size == "Small")">Small</option>
                                    <option value="Medium" selected="@(w.Size == "Medium")">Medium</option>
                                    <option value="Large"  selected="@(w.Size == "Large")">Large</option>
                                    <option value="Full"   selected="@(w.Size == "Full")">Full</option>
                                </select>
                            }
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input visibility-toggle" type="checkbox" @(w.IsVisible ? "checked" : "") />
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-light" onclick="resetLayout()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Default
                </button>
                <button class="btn btn-primary px-4" onclick="saveLayout()">
                    <i class="bi bi-check-lg me-1"></i>Save Layout
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.css" />
    <style>
        .widget-config-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 8px; border-bottom: 1px solid var(--border);
        }
        .widget-config-row .drag-handle { cursor: grab; color: #bbb; }
        .widget-config-row:last-child { border-bottom: none; }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <script>
        let sortableInstance = null;

        function openCustomizeModal() {
        new bootstrap.Modal('#customizeModal').show();
        if (!sortableInstance) {
        sortableInstance = new Sortable(document.getElementById('widgetConfigList'), {
        handle: '.drag-handle',
        animation: 150
        });
        }
        }

        function collectLayoutFromModal() {
            const rows = document.querySelectorAll('#widgetConfigList .widget-config-row');
            const widgets = [];
            rows.forEach((row, index) => {
                const sizeSelect = row.querySelector('.size-select');
                widgets.push({
                    widgetKey: row.dataset.key,
                    order: index,
                    size: sizeSelect ? sizeSelect.value : row.dataset.size,
                    isVisible: row.querySelector('.visibility-toggle').checked
                });
            });
            return { widgets };
        }

        async function saveLayout() {
        const rows = document.querySelectorAll('.widget-config-row');
        const widgets = Array.from(rows).map((row, idx) => ({
        widgetKey: row.dataset.key,
        order:     idx,
        isVisible: row.querySelector('.visibility-toggle').checked,
        size:      row.querySelector('.size-select')?.value || row.dataset.size || 'Medium'
        }));

        fetch('/Dashboard/SaveLayout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': $('[name=__RequestVerificationToken]').val() },
        body: JSON.stringify({ widgets })
        }).then(r => r.json()).then(d => {
        if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 600); }
        else toastr.error(d.message);
        });
        }
        async function resetLayout() {
        Swal.fire({ title: 'Default layout এ ফিরে যাবেন?', icon: 'question', showCancelButton: true })
        .then(r => { if (r.isConfirmed) {
        $.post('/Dashboard/ResetLayout', { __RequestVerificationToken: $('[name=__RequestVerificationToken]').val() }, d => {
        if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 600); }
        });
        }});
        }
    </script>
}