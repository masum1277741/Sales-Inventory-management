@model ClothingERP.Application.DTOs.DashboardDto
@{
    var rateBDT = (decimal)(ViewBag.RateBDT ?? 110m);
}
<div class="stat-card" id="todaySalesWidget" data-amount="@Model.TodaySales" data-rate-bdt="@rateBDT">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-wrap" style="background:#d1fae5;"><i class="bi bi-cash-stack" style="color:#065f46;"></i></div>
        <div>
            <div class="text-muted small">Today's Sales</div>
            <h4 class="mb-0 fw-bold" id="todaySalesValue">@CurrencyHelper.FormatUSD(Model.TodaySales)</h4>
            <small class="text-muted" id="todaySalesBdt">@CurrencyHelper.FormatBDT(Model.TodaySales * rateBDT)</small>
        </div>
    </div>
</div>

<script>
    document.addEventListener('rt:saleCompleted', e => {
        const widget = document.getElementById('todaySalesWidget');
        if (!widget) return;

        const current = parseFloat(widget.dataset.amount) || 0;
        const rateBdt = parseFloat(widget.dataset.rateBdt) || 110;
        const updated = current + e.detail.totalAmount;
        widget.dataset.amount = updated;

        const valueEl = document.getElementById('todaySalesValue');
        const bdtEl = document.getElementById('todaySalesBdt');
        valueEl.textContent = '$' + updated.toFixed(2);
        bdtEl.textContent = '৳' + (updated * rateBdt).toFixed(2);

        valueEl.style.transition = 'color .3s';
        valueEl.style.color = '#16a34a';
        bdtEl.style.transition = 'color .3s';
        bdtEl.style.color = '#16a34a';
        setTimeout(() => {
            valueEl.style.color = '';
            bdtEl.style.color = '';
        }, 800);
    });
</script>
