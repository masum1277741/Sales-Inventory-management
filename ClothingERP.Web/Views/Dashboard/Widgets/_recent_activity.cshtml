@model ClothingERP.Application.DTOs.DashboardDto
@{
    var rateBDT = (decimal)(ViewBag.RateBDT ?? 110m);
}
<div class="card border-0 shadow-sm h-100">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
        <span class="fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Activity</span>
        <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-light">View All</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentInvoices.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var inv in Model.RecentInvoices)
                {
                    <div class="list-group-item border-0 px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-controller="Sales" asp-action="Details" asp-route-id="@inv.Id"
                               class="fw-semibold small text-primary text-decoration-none">@inv.InvoiceNumber</a>
                            <div class="text-muted small">@inv.CustomerName — @inv.InvoiceDate.ToString("dd MMM, hh:mm tt")</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold small">@CurrencyHelper.FormatUSD(inv.TotalAmount)</div>
                            <small class="text-muted">@CurrencyHelper.FormatBDT(inv.TotalAmount * rateBDT)</small>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-2"></i>
                <p class="mt-2 small">No recent activity</p>
            </div>
        }
    </div>
</div>
