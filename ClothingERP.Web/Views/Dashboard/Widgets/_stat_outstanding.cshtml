@model ClothingERP.Application.DTOs.DashboardDto
<div class="stat-card h-100">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-wrap" style="background:#fee2e2;"><i class="bi bi-wallet2" style="color:#7f1d1d;"></i></div>
        <div>
            <div class="text-muted small">Outstanding Due</div>
            <h4 class="mb-0 fw-bold">৳@((Model.TotalCustomerDue + Model.TotalSupplierDue).ToString("N2"))</h4>
            <small class="text-muted">Customer: ৳@Model.TotalCustomerDue.ToString("N2") · Supplier: ৳@Model.TotalSupplierDue.ToString("N2")</small>
        </div>
    </div>
</div>