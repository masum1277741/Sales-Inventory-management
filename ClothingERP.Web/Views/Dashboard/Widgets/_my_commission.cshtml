@model ClothingERP.Application.DTOs.DashboardDto
@{
    var rateBDT = (decimal)(ViewBag.RateBDT ?? 110m);
    var commission = (decimal)(ViewBag.MyPendingCommission ?? 0m);
}
<div class="stat-card h-100">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-wrap" style="background:#d1fae5;"><i class="bi bi-person-badge" style="color:#065f46;"></i></div>
        <div>
            <div class="text-muted small">My Pending Commission</div>
            <h4 class="mb-0 fw-bold text-success">@CurrencyHelper.FormatUSD(commission)</h4>
            <small class="text-muted d-block">@CurrencyHelper.FormatBDT(commission * rateBDT)</small>
            <small class="text-muted">This month</small>
        </div>
    </div>
</div>
