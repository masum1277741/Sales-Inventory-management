@model ClothingERP.Application.DTOs.DashboardDto
<div class="stat-card h-100">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-wrap" style="background:#fef3c7;"><i class="bi bi-exclamation-triangle" style="color:#78350f;"></i></div>
        <div>
            <div class="text-muted small">Low Stock Items</div>
            <h4 class="mb-0 fw-bold">@Model.LowStockCount</h4>
            <small class="text-muted">Out of stock: @Model.OutOfStockCount</small>
        </div>
    </div>
</div>