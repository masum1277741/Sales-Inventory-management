@model ClothingERP.Application.DTOs.DashboardDto
@{
    var rateBDT = (decimal)(ViewBag.RateBDT ?? 110m);
}
<div class="stat-card h-100">
    <div class="d-flex align-items-center gap-3">
        <div class="icon-wrap" style="background:#f3e5f5;"><i class="bi bi-boxes" style="color:#8e24aa;"></i></div>
        <div class="flex-grow-1">
            <div class="text-muted small">Inventory Value</div>
            <div class="fw-bold fs-5">@CurrencyHelper.FormatUSD(Model.TotalRetailStockValue)</div>
            <small class="text-muted d-block">@CurrencyHelper.FormatBDT(Model.TotalRetailStockValue * rateBDT)</small>
            <small class="text-muted">Retail price × quantity</small>
        </div>
    </div>
</div>
