@{ ViewData["Title"] = "Create Purchase Return"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-arrow-return-right me-2 text-primary"></i>Create Purchase Return</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-action="Purchase">Purchase Returns</a></li>
            <li class="breadcrumb-item active">New Return</li>
        </ol></nav>
    </div>
    <a asp-action="Purchase" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
    <!-- Left -->
    <div class="col-lg-8">

        <!-- PO Selection -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-bag me-2 text-primary"></i>Select Purchase Order</span>
            </div>
            <div class="card-body p-4">
                <label class="form-label fw-semibold">Purchase Order <span class="text-danger">*</span></label>
                <select class="form-select select2" id="poSelect" onchange="loadPOItems(this.value)">
                    <option value="">— Select Received PO —</option>
                    @foreach (var po in (IEnumerable<PurchaseOrderListDto>)ViewBag.PurchaseOrders)
                    {
                        @if((ViewBag.PurchaseOrderId as int?) == po.Id)
                        {
                            <option value="@po.Id" selected>@po.PONumber — @po.SupplierName</option>
                        }
                        else
                        {
                            <option value="@po.Id">@po.PONumber — @po.SupplierName</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- PO Info -->
        <div id="poInfoCard" class="card border-0 shadow-sm mb-4 border-start border-3 border-warning" style="display:none;">
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-sm-4"><div class="text-muted small">PO #</div><div class="fw-bold" id="poNum">—</div></div>
                    <div class="col-sm-4"><div class="text-muted small">Supplier</div><div class="fw-semibold" id="poSupplier">—</div></div>
                    <div class="col-sm-4"><input type="hidden" id="poSupplierId" /></div>
                </div>
            </div>
        </div>

        <!-- Items -->
        <div id="itemsCard" class="card border-0 shadow-sm" style="display:none;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between">
                <span class="fw-semibold"><i class="bi bi-list-check me-2 text-primary"></i>Received Items</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-light border" onclick="selectAll(true)"><i class="bi bi-check-all me-1"></i>All</button>
                    <button class="btn btn-sm btn-light border" onclick="selectAll(false)"><i class="bi bi-x-lg me-1"></i>Clear</button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" width="50"><input type="checkbox" class="form-check-input" onchange="selectAll(this.checked)" /></th>
                                <th>Product</th>
                                <th class="text-center">Received</th>
                                <th class="text-center" style="width:110px;">Return Qty</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end pe-4">Total</th>
                            </tr>
                        </thead>
                        <tbody id="returnItemsTbody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right -->
    <div class="col-lg-4">
        <div id="returnFormCard" class="card border-0 shadow-sm mb-4" style="display:none;">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-file-text me-2 text-primary"></i>Return Details</span>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                    <select class="form-select mb-2" id="reasonSelect" onchange="if(this.value) $('#reasonText').val(this.value)">
                        <option value="">— Choose reason —</option>
                        <option>Defective / damaged goods</option>
                        <option>Wrong product delivered</option>
                        <option>Quality issues</option>
                        <option>Excess quantity received</option>
                        <option>Order cancelled</option>
                    </select>
                    <textarea class="form-control" id="reasonText" rows="3" placeholder="Describe the reason..."></textarea>
                </div>

                <!-- Summary -->
                <div class="p-3 rounded mb-4" style="background:#f8f9ff;">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Selected Items:</span>
                        <span class="fw-semibold" id="sumItems">0</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Total Qty:</span>
                        <span class="fw-semibold" id="sumQty">0</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total Return Value:</span>
                        <span class="text-danger fs-5" id="sumTotal">৳0.00</span>
                    </div>
                </div>

                <button type="button" class="btn btn-danger w-100" onclick="submitReturn()">
                    <i class="bi bi-check-circle me-1"></i>Submit Purchase Return
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#e3f2fd,#f8f9ff);">
            <div class="card-body p-3">
                <div class="fw-semibold small mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>Note</div>
                <ul class="list-unstyled mb-0 small text-muted">
                    <li class="mb-1"><i class="bi bi-check-circle me-1 text-success"></i>Only received items can be returned</li>
                    <li class="mb-1"><i class="bi bi-check-circle me-1 text-success"></i>Stock will be automatically reduced</li>
                    <li><i class="bi bi-check-circle me-1 text-success"></i>Supplier ledger will be updated</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
$(function() {
    $('#poSelect').select2({ theme:'bootstrap-5', width:'100%' });
    const preselected = '@ViewBag.PurchaseOrderId';
    if (preselected && preselected !== '') loadPOItems(preselected);
});

const tok = () => document.querySelector('[name=__RequestVerificationToken]').value;
let currentPO = null;

async function loadPOItems(poId) {
    if (!poId) { $('#poInfoCard, #itemsCard, #returnFormCard').hide(); return; }
    const data = await fetch(`/Return/GetPOForReturn/${poId}`).then(r => r.json());
    currentPO = data;

    $('#poNum').text(data.poNumber);
    $('#poSupplier').text(data.supplierName);
    $('#poSupplierId').val(data.supplierId);
    $('#poInfoCard').fadeIn(200);

    if (!data.items.length) {
        toastr.warning('No received items to return for this PO.');
        $('#itemsCard, #returnFormCard').hide();
        return;
    }

    document.getElementById('returnItemsTbody').innerHTML = data.items.map((item, i) => `
        <tr>
            <td class="ps-4">
                <input type="checkbox" class="form-check-input item-check" onchange="calcSummary()" />
                <input type="hidden" class="variant-id" value="${item.productVariantId}" />
                <input type="hidden" class="unit-cost" value="${item.unitCost}" />
            </td>
            <td>
                <div class="fw-semibold small">${item.productName}</div>
                <div class="d-flex gap-1 mt-1">
                    <span class="badge bg-secondary" style="font-size:.6rem;">${item.sizeName}</span>
                    <span class="text-muted" style="font-size:.72rem;">${item.colorName}</span>
                    <code style="font-size:.65rem;">${item.barcode}</code>
                </div>
            </td>
            <td class="text-center fw-semibold">${item.receivedQty}</td>
            <td class="text-center">
                <input type="number" class="form-control form-control-sm text-center return-qty"
                       style="width:80px;margin:auto;"
                       value="${item.receivedQty}" min="1" max="${item.receivedQty}" step="1"
                       oninput="calcSummary()" />
            </td>
            <td class="text-end small">৳${parseFloat(item.unitCost).toFixed(2)}</td>
            <td class="text-end fw-semibold small pe-4 row-total">৳0.00</td>
        </tr>
    `).join('');

    $('#itemsCard, #returnFormCard').fadeIn(200);
    calcSummary();
}

function selectAll(checked) {
    document.querySelectorAll('.item-check').forEach(cb => cb.checked = checked);
    document.querySelectorAll('thead .form-check-input').forEach(cb => cb.checked = checked);
    calcSummary();
}

function calcSummary() {
    let totalQty = 0, totalValue = 0, itemCount = 0;
    document.querySelectorAll('#returnItemsTbody tr').forEach(row => {
        const checked = row.querySelector('.item-check')?.checked;
        const qty     = parseFloat(row.querySelector('.return-qty')?.value)  || 0;
        const cost    = parseFloat(row.querySelector('.unit-cost')?.value)    || 0;
        const total   = checked ? qty * cost : 0;
        row.querySelector('.row-total').textContent = '৳' + total.toFixed(2);
        if (checked) { totalQty += qty; totalValue += total; itemCount++; }
    });
    document.getElementById('sumItems').textContent = itemCount;
    document.getElementById('sumQty').textContent   = totalQty;
    document.getElementById('sumTotal').textContent = '৳' + totalValue.toFixed(2);
}

async function submitReturn() {
    const poId       = parseInt($('#poSelect').val());
    const supplierId = parseInt($('#poSupplierId').val());
    const reason     = $('#reasonText').val().trim();
    if (!poId)    { toastr.error('Select a purchase order.'); return; }
    if (!reason)  { toastr.error('Reason is required.'); return; }

    const items = [];
    document.querySelectorAll('#returnItemsTbody tr').forEach(row => {
        if (!row.querySelector('.item-check')?.checked) return;
        const qty  = parseFloat(row.querySelector('.return-qty')?.value)  || 0;
        const cost = parseFloat(row.querySelector('.unit-cost')?.value)    || 0;
        if (qty <= 0) return;
        items.push({
            productVariantId: parseInt(row.querySelector('.variant-id')?.value),
            returnQuantity:   qty,
            unitCost:         cost
        });
    });

    if (!items.length) { toastr.error('Select at least one item.'); return; }

    const dto = { purchaseOrderId: poId, supplierId, reason, items };

    const btn = event.currentTarget;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

    try {
        const resp = await fetch('/Return/CreatePurchaseReturn', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tok() },
            body: JSON.stringify(dto)
        });
        const data = await resp.json();
        if (data.success) {
            Swal.fire({ title: 'Return Created!', text: `Return: ${data.data.returnNumber}`, icon: 'success', confirmButtonText: 'View Details' })
            .then(() => window.location.href = `/Return/PurchaseReturnDetails/${data.data.returnId}`);
        } else toastr.error(data.message);
    } catch (e) { toastr.error('Network error.'); }
    finally { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Submit Purchase Return'; }
}
</script>
}