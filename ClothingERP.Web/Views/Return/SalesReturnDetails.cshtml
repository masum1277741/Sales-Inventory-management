@model SalesReturnDto
@{
    ViewData["Title"] = "Return — " + Model.ReturnNumber;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-arrow-return-left me-2 text-primary"></i>@Model.ReturnNumber</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Sales">Sales Returns</a></li>
                <li class="breadcrumb-item active">@Model.ReturnNumber</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Sales" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <!-- Return Header -->
            <div class="card-body p-4" style="background:linear-gradient(135deg,#fff5f5,#fff);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Return Number</div>
                        <h4 class="fw-bold mb-1 text-danger">@Model.ReturnNumber</h4>
                        <div class="text-muted small">@Model.ReturnDate.ToString("dd MMMM yyyy, hh:mm tt")</div>
                    </div>
                    <div class="text-end">
                        <span class="badge @(Model.ReturnType == "Exchange" ? "bg-warning text-dark" : "bg-danger") rounded-pill px-3 py-2 fs-6">
                            <i class="bi @(Model.ReturnType == "Exchange" ? "bi-arrow-left-right" : "bi-arrow-return-left") me-1"></i>
                            @Model.ReturnType
                        </span>
                        <div class="text-muted small mt-1">Invoice: <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SalesInvoiceId" class="text-primary">@Model.InvoiceNumber</a></div>
                    </div>
                </div>
            </div>

            <!-- Customer + Reason -->
            <div class="card-body border-top p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Customer</div>
                        <div class="fw-semibold">@Model.CustomerName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Reason</div>
                        <div class="fw-semibold">@(Model.Reason ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Refund Method</div>
                        <div class="fw-semibold">@Model.RefundMethod</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Refund Amount</div>
                        <div class="fw-bold text-success fs-5">৳@Model.RefundAmount.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <!-- Items -->
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Product</th>
                            <th class="text-center">Qty Returned</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end pe-4">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@(i++)</td>
                                <td>
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    <div class="d-flex gap-1 mt-1">
                                        <span class="badge bg-secondary" style="font-size:.6rem;">@item.SizeName</span>
                                        <span class="text-muted" style="font-size:.72rem;">@item.ColorName</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.DefectDescription))
                                    {
                                        <div class="text-danger" style="font-size:.72rem;"><i class="bi bi-exclamation-circle me-1"></i>@item.DefectDescription</div>
                                    }
                                </td>
                                <td class="text-center fw-bold">@item.ReturnQuantity.ToString("N0")</td>
                                <td class="text-end small">৳@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold pe-4">৳@item.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end fw-bold pe-3">Total Return Value:</td>
                            <td class="text-end fw-bold pe-4 text-danger">৳@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end fw-bold pe-3 text-success">Refund Amount:</td>
                            <td class="text-end fw-bold pe-4 text-success fs-5">৳@Model.RefundAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Return Summary</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="ps-3 text-muted">Return #</td><td class="fw-semibold text-danger">@Model.ReturnNumber</td></tr>
                        <tr><td class="ps-3 text-muted">Invoice #</td><td><a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SalesInvoiceId">@Model.InvoiceNumber</a></td></tr>
                        <tr><td class="ps-3 text-muted">Type</td><td><span class="badge @(Model.ReturnType == "Exchange" ? "bg-warning text-dark" : "bg-danger") bg-opacity-15">@Model.ReturnType</span></td></tr>
                        <tr><td class="ps-3 text-muted">Customer</td><td class="fw-semibold">@Model.CustomerName</td></tr>
                        <tr><td class="ps-3 text-muted">Date</td><td class="small">@Model.ReturnDate.ToString("dd MMM yyyy")</td></tr>
                        <tr><td class="ps-3 text-muted">Items</td><td class="fw-semibold">@Model.Items.Count</td></tr>
                        <tr><td class="ps-3 text-muted">Total Value</td><td class="fw-bold text-danger">৳@Model.TotalAmount.ToString("N2")</td></tr>
                        <tr><td class="ps-3 text-muted">Refunded</td><td class="fw-bold text-success">৳@Model.RefundAmount.ToString("N2")</td></tr>
                        <tr><td class="ps-3 text-muted">Refund via</td><td>@Model.RefundMethod</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>