@{
    ViewData["Title"] = "Create Sales Return";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-arrow-return-left me-2 text-primary"></i>Create Sales Return</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Sales">Sales Returns</a></li>
                <li class="breadcrumb-item active">New Return</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Sales" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
    <!-- Left: Search + Items -->
    <div class="col-lg-8">

        <!-- Invoice Search -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-search me-2 text-primary"></i>Find Sales Invoice</span>
            </div>
            <div class="card-body p-4">
                <div class="position-relative">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-receipt text-primary"></i></span>
                        <input type="text" id="invoiceSearch" class="form-control"
                               placeholder="Search by Invoice # or Customer name..."
                               autocomplete="off" oninput="searchInvoices(this.value)" />
                    </div>
                    <div id="invoiceDropdown"
                         class="position-absolute w-100 bg-white border rounded shadow"
                         style="z-index:1000;max-height:250px;overflow-y:auto;display:none;top:100%;"></div>
                </div>
            </div>
        </div>

        <!-- Invoice Info (shown after selection) -->
        <div id="invoiceInfoCard" class="card border-0 shadow-sm mb-4 border-start border-3 border-warning" style="display:none;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between">
                <span class="fw-semibold"><i class="bi bi-receipt me-2 text-warning"></i>Invoice Details</span>
                <button class="btn btn-sm btn-light border" onclick="clearInvoice()">
                    <i class="bi bi-x me-1"></i>Change Invoice
                </button>
            </div>
            <div class="card-body p-3">
                <div class="row g-2 mb-3">
                    <div class="col-sm-4">
                        <div class="text-muted small">Invoice #</div>
                        <div class="fw-bold" id="invNum">—</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Customer</div>
                        <div class="fw-semibold" id="invCustomer">—</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Invoice Total</div>
                        <div class="fw-bold text-primary" id="invTotal">৳0.00</div>
                    </div>
                </div>
                <input type="hidden" id="selectedInvoiceId" />
                <input type="hidden" id="selectedCustomerId" />
            </div>
        </div>

        <!-- Items to Return (shown after invoice selection) -->
        <div id="itemsCard" class="card border-0 shadow-sm" style="display:none;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between">
                <span class="fw-semibold"><i class="bi bi-list-check me-2 text-primary"></i>Select Items to Return</span>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-light border" onclick="selectAll(true)">
                        <i class="bi bi-check-all me-1"></i>Select All
                    </button>
                    <button class="btn btn-sm btn-light border" onclick="selectAll(false)">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" width="50">
                                    <input type="checkbox" class="form-check-input" onchange="selectAll(this.checked)" />
                                </th>
                                <th>Product</th>
                                <th class="text-center">Sold Qty</th>
                                <th class="text-center" style="width:110px;">Return Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end pe-4">Return Total</th>
                            </tr>
                        </thead>
                        <tbody id="returnItemsTbody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Return Info -->
    <div class="col-lg-4">

        <div id="returnFormCard" class="card border-0 shadow-sm mb-4" style="display:none;">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Return Information</span>
            </div>
            <div class="card-body p-4">
                <!-- Return Type -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Return Type <span class="text-danger">*</span></label>
                    <div class="d-flex gap-2">
                        <div class="flex-fill">
                            <input type="radio" class="btn-check" name="returnType" id="typeReturn" value="1" checked />
                            <label class="btn btn-outline-danger w-100" for="typeReturn">
                                <i class="bi bi-arrow-return-left me-1"></i>Return
                            </label>
                        </div>
                        <div class="flex-fill">
                            <input type="radio" class="btn-check" name="returnType" id="typeExchange" value="2" />
                            <label class="btn btn-outline-warning w-100" for="typeExchange">
                                <i class="bi bi-arrow-left-right me-1"></i>Exchange
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Reason -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                    <select class="form-select mb-2" id="reasonSelect" onchange="if(this.value) $('#reasonText').val(this.value)">
                        <option value="">— Choose reason —</option>
                        <option>Defective / damaged item</option>
                        <option>Wrong size received</option>
                        <option>Wrong color received</option>
                        <option>Customer changed mind</option>
                        <option>Does not fit</option>
                        <option>Duplicate purchase</option>
                    </select>
                    <textarea class="form-control" id="reasonText" rows="2" placeholder="Enter reason..."></textarea>
                </div>

                <!-- Refund Method -->
                <div class="mb-3" id="refundMethodSection">
                    <label class="form-label fw-semibold">Refund Method <span class="text-danger">*</span></label>
                    <select class="form-select" id="refundMethod">
                        <option value="1">Cash</option>
                        <option value="2">Store Credit</option>
                        <option value="3">Bank Transfer</option>
                    </select>
                </div>

                <!-- Refund Amount -->
                <div class="mb-4 p-3 rounded" style="background:#f8f9ff;">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Selected Items Value:</span>
                        <span class="fw-semibold" id="selectedValue">৳0.00</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Refund Amount:</span>
                        <span class="text-success fs-5" id="refundAmount">৳0.00</span>
                    </div>
                    <div class="mt-2">
                        <label class="form-label fw-semibold small">Override Refund Amount</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">৳</span>
                            <input type="number" class="form-control" id="refundAmountInput" min="0" step="0.01" />
                        </div>
                    </div>
                </div>

                <button type="button" class="btn btn-danger w-100" onclick="submitReturn()">
                    <i class="bi bi-check-circle me-1"></i>Submit Return
                </button>
            </div>
        </div>

        <!-- Help Card -->
        <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#fff8e1,#fffde7);">
            <div class="card-body p-3">
                <div class="fw-semibold small mb-2"><i class="bi bi-lightbulb me-1 text-warning"></i>How it works</div>
                <ul class="list-unstyled mb-0 small text-muted">
                    <li class="mb-1"><i class="bi bi-1-circle me-1 text-primary"></i>Search for the original invoice</li>
                    <li class="mb-1"><i class="bi bi-2-circle me-1 text-primary"></i>Select items to return</li>
                    <li class="mb-1"><i class="bi bi-3-circle me-1 text-primary"></i>Choose return type & reason</li>
                    <li><i class="bi bi-4-circle me-1 text-primary"></i>Stock is automatically restored</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const tok = () => document.querySelector('[name=__RequestVerificationToken]').value;
        let currentInvoice = null;
        let searchTimer;

        // ── Invoice Search ─────────────────────────────────────────────────────────
        function searchInvoices(val) {
            clearTimeout(searchTimer);
            if (val.length < 2) { $('#invoiceDropdown').hide(); return; }
            searchTimer = setTimeout(async () => {
                const data = await fetch(`/Return/SearchInvoices?keyword=${encodeURIComponent(val)}`).then(r => r.json());
                const dd = $('#invoiceDropdown');
                if (!data.length) { dd.hide(); return; }
                dd.html(data.map(i => `
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center"
                         style="cursor:pointer;"
                         onmousedown="event.preventDefault();selectInvoice(${i.id})">
                        <div>
                            <div class="fw-bold">${i.invoiceNumber}</div>
                            <div class="text-muted small">${i.customerName} · ${i.date}</div>
                        </div>
                        <div class="fw-bold text-primary">৳${parseFloat(i.totalAmount).toFixed(2)}</div>
                    </div>
                `).join('')).show();
            }, 250);
        }

        document.addEventListener('click', e => {
            if (!e.target.closest('#invoiceSearch, #invoiceDropdown')) $('#invoiceDropdown').hide();
        });

        async function selectInvoice(id) {
            const data = await fetch(`/Return/GetInvoiceForReturn/${id}`).then(r => r.json());
            currentInvoice = data;
            $('#invoiceDropdown').hide();
            $('#invoiceSearch').val(data.invoiceNumber);
            $('#invNum').text(data.invoiceNumber);
            $('#invCustomer').text(data.customerName);
            $('#invTotal').text('৳' + parseFloat(data.totalAmount).toFixed(2));
            $('#selectedInvoiceId').val(data.id);
            $('#selectedCustomerId').val(data.customerId || '');
            $('#invoiceInfoCard').fadeIn(200);
            renderItems(data.items);
            $('#itemsCard, #returnFormCard').fadeIn(200);
        }

        function clearInvoice() {
            currentInvoice = null;
            $('#invoiceSearch').val('');
            $('#invoiceInfoCard, #itemsCard, #returnFormCard').hide();
        }

        // ── Items ──────────────────────────────────────────────────────────────────
        function renderItems(items) {
            const tbody = document.getElementById('returnItemsTbody');
            tbody.innerHTML = items.map((item, i) => `
                <tr data-index="${i}">
                    <td class="ps-4">
                        <input type="checkbox" class="form-check-input item-check" data-index="${i}"
                               onchange="calcTotal()" />
                    </td>
                    <td>
                        <div class="fw-semibold small">${item.productName}</div>
                        <div class="d-flex gap-1 mt-1 align-items-center">
                            <span class="badge bg-secondary" style="font-size:.6rem;">${item.sizeName}</span>
                            <span class="text-muted" style="font-size:.72rem;">${item.colorName}</span>
                            <code style="font-size:.65rem;">${item.barcode}</code>
                        </div>
                        <input type="hidden" class="variant-id" value="${item.productVariantId}" />
                        <input type="hidden" class="unit-price" value="${item.unitPrice}" />
                        <input type="hidden" class="max-qty" value="${item.quantity}" />
                    </td>
                    <td class="text-center fw-semibold">${item.quantity}</td>
                    <td class="text-center">
                        <input type="number" class="form-control form-control-sm text-center return-qty"
                               style="width:80px;margin:auto;" value="${item.quantity}"
                               min="1" max="${item.quantity}" step="1"
                               oninput="calcTotal()" />
                    </td>
                    <td class="text-end small">৳${parseFloat(item.unitPrice).toFixed(2)}</td>
                    <td class="text-end fw-semibold small pe-4 row-total">৳${parseFloat(item.totalAmount).toFixed(2)}</td>
                </tr>
            `).join('');
            calcTotal();
        }

        function selectAll(checked) {
            document.querySelectorAll('.item-check').forEach(cb => cb.checked = checked);
            document.querySelectorAll('thead .form-check-input').forEach(cb => cb.checked = checked);
            calcTotal();
        }

        function calcTotal() {
            let total = 0;
            document.querySelectorAll('#returnItemsTbody tr').forEach(row => {
                const checked  = row.querySelector('.item-check')?.checked;
                const qty      = parseFloat(row.querySelector('.return-qty')?.value) || 0;
                const price    = parseFloat(row.querySelector('.unit-price')?.value)  || 0;
                const rowTotal = checked ? qty * price : 0;
                row.querySelector('.row-total').textContent = '৳' + rowTotal.toFixed(2);
                if (checked) total += rowTotal;
            });
            document.getElementById('selectedValue').textContent = '৳' + total.toFixed(2);
            document.getElementById('refundAmount').textContent   = '৳' + total.toFixed(2);
            document.getElementById('refundAmountInput').value    = total.toFixed(2);
        }

        // ── Submit ─────────────────────────────────────────────────────────────────
        async function submitReturn() {
            const invoiceId = parseInt($('#selectedInvoiceId').val());
            if (!invoiceId) { toastr.error('Select an invoice first.'); return; }

            const items = [];
            document.querySelectorAll('#returnItemsTbody tr').forEach(row => {
                if (!row.querySelector('.item-check')?.checked) return;
                const qty   = parseFloat(row.querySelector('.return-qty')?.value)  || 0;
                const price = parseFloat(row.querySelector('.unit-price')?.value)   || 0;
                if (qty <= 0) return;
                items.push({
                    productVariantId: parseInt(row.querySelector('.variant-id')?.value),
                    returnQuantity:   qty,
                    unitPrice:        price
                });
            });

            if (!items.length)         { toastr.error('Select at least one item.'); return; }
            const reason = $('#reasonText').val().trim();
            if (!reason)               { toastr.error('Reason is required.'); return; }

            const returnType = parseInt(document.querySelector('[name="returnType"]:checked')?.value || 1);
            const dto = {
                salesInvoiceId: invoiceId,
                returnType:     returnType,
                reason:         reason,
                refundAmount:   parseFloat($('#refundAmountInput').val()) || 0,
                refundMethod:   parseInt($('#refundMethod').val()),
                items
            };

            const btn = event.currentTarget;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

            try {
                const resp = await fetch('/Return/CreateSalesReturn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tok() },
                    body: JSON.stringify(dto)
                });
                const data = await resp.json();
                if (data.success) {
                    Swal.fire({ title: 'Return Created!', text: `Return: ${data.data.returnNumber}`, icon: 'success', confirmButtonText: 'View Details' })
                    .then(() => window.location.href = `/Return/SalesReturnDetails/${data.data.returnId}`);
                } else toastr.error(data.message);
            } catch (e) { toastr.error('Network error.'); }
            finally { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Submit Return'; }
        }

        // Handle return type change - hide refund for exchange
        document.querySelectorAll('[name="returnType"]').forEach(r => {
            r.addEventListener('change', () => {
                $('#refundMethodSection').toggle(r.value === '1');
            });
        });
    </script>
}