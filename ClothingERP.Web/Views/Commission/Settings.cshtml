@model IEnumerable<StaffCommissionRateDto>
@{
    ViewData["Title"] = "Commission Settings"; var settings = (CommissionSettingsDto)ViewBag.Settings;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-sliders me-2 text-primary"></i>Commission Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Commission</a></li>
                <li class="breadcrumb-item active">Settings</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3"><span class="fw-semibold">Global Defaults</span></div>
            <div class="card-body p-4">
                <form asp-action="UpdateSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsEnabled" @(settings.IsEnabled ? "checked" : "") />
                        <label class="form-check-label fw-semibold">Commission Tracking Active</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Default Commission Rate</label>
                        <div class="input-group">
                            <input name="DefaultCommissionPercent" class="form-control" type="number" step="0.1" value="@settings.DefaultCommissionPercent" />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Minimum Sale Amount for Commission</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input name="MinSaleAmountForCommission" class="form-control" type="number" step="0.01" value="@settings.MinSaleAmountForCommission" />
                        </div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="ExcludeReturnsFromCommission" @(settings.ExcludeReturnsFromCommission ? "checked" : "") />
                        <label class="form-check-label">Reverse commission on cancelled/returned sales</label>
                    </div>
                    <button type="submit" class="btn btn-primary px-4">Save Settings</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3"><span class="fw-semibold">Per-Staff Custom Rate</span></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light"><tr><th class="ps-4">Staff</th><th>Role</th><th class="text-center">Rate</th><th class="text-center pe-4">Action</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr id="rate-@s.UserId">
                                <td class="ps-4 fw-semibold small">@s.UserName</td>
                                <td><span class="badge bg-primary">@s.RoleName</span></td>
                                <td class="text-center">
                                    <input type="number" class="form-control form-control-sm d-inline-block text-center"
                                           style="width:80px;" id="rateInput-@s.UserId" value="@s.EffectiveRate" step="0.1" />
                                    %
                                    @if (s.IsCustomRate)
                                    {
                                        <span class="badge bg-info ms-1" style="font-size:.6rem;">Custom</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <button class="btn btn-sm btn-outline-primary" onclick="saveRate(@s.UserId)">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    @if (s.IsCustomRate)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" onclick="resetRate(@s.UserId)" title="Reset to default">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        const tok = () => $('[name=__RequestVerificationToken]').val();

        function saveRate(userId) {
            const rate = parseFloat($(`#rateInput-${userId}`).val());
            $.post('/Commission/SetStaffRate', { UserId: userId, CommissionPercent: rate, __RequestVerificationToken: tok() }, d => {
                if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 600); }
                else toastr.error(d.message);
            });
        }

        function resetRate(userId) {
            $.post('/Commission/RemoveStaffRate', { userId, __RequestVerificationToken: tok() }, d => {
                if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 600); }
                else toastr.error(d.message);
            });
        }
    </script>
}