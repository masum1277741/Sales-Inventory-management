@model IEnumerable<NotificationDto>
@{
    ViewData["Title"] = "Notifications"; var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-bell me-2 text-primary"></i>All Notifications</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Notifications</li>
            </ol>
        </nav>
    </div>
    <button class="btn btn-outline-primary" onclick="markAllNotificationsRead(); setTimeout(()=>location.reload(),500);">
        <i class="bi bi-check-all me-1"></i>Mark All Read
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @foreach (var n in items)
        {
            var (bg, fg) = n.Severity switch
            {
                "success" => ("#d1fae5", "#065f46"),
                "warning" => ("#fef3c7", "#78350f"),
                "danger" => ("#fee2e2", "#7f1d1d"),
                _ => ("#dbeafe", "#1e3a8a")
            };
            <div class="d-flex align-items-start gap-3 p-3 border-bottom @(n.IsRead ? "" : "bg-light")"
                 style="cursor:pointer;" onclick="window.location.href='@(n.ActionUrl ?? "#")'">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:42px;height:42px;background:@bg;color:@fg;">
                    <i class="bi @n.Icon"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">@n.Title</div>
                    <div class="text-muted small">@n.Message</div>
                    <div class="text-muted" style="font-size:.72rem;">@n.TimeAgo</div>
                </div>
                @if (!n.IsRead)
                {
                    <span class="badge bg-primary rounded-pill">New</span>
                }
            </div>
        }

        @if (!items.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-bell-slash d-block mb-2" style="font-size:2.5rem;"></i>
                কোনো notification নেই।
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()