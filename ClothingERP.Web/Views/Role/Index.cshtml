@model IEnumerable<RoleDto>
@{
    ViewData["Title"] = "Role Management";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-shield-lock me-2 text-primary"></i>Role Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Roles</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Role</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#e8f0fe;"><i class="bi bi-shield" style="color:#4f7cff;"></i></div>
                <div><div class="text-muted small">Total Roles</div><h4 class="mb-0 fw-bold">@Model.Count()</h4></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#e8f5e9;"><i class="bi bi-shield-check" style="color:#43a047;"></i></div>
                <div><div class="text-muted small">Active Roles</div><h4 class="mb-0 fw-bold text-success">@Model.Count(r => r.IsActive)</h4></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#fff3e0;"><i class="bi bi-people" style="color:#f57c00;"></i></div>
                <div><div class="text-muted small">Total Assigned</div><h4 class="mb-0 fw-bold">@Model.Sum(r => r.UserCount)</h4></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var role in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="icon-wrap" style="background:#e8f0fe;width:44px;height:44px;">
                                <i class="bi bi-shield-fill" style="color:#4f7cff;font-size:1.1rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@role.Name</h6>
                                <small class="text-muted">@role.UserCount user(s)</small>
                            </div>
                        </div>
                        <span class="badge rounded-pill px-2 @(role.IsActive ? "bg-success" : "bg-secondary") bg-opacity-15 @(role.IsActive ? "text-success" : "text-secondary")">
                            @(role.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(role.Description))
                    {
                        <p class="text-muted small mb-3">@role.Description</p>
                    }
                    <div class="d-flex gap-2 mt-auto">
                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-light border flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Permissions" asp-route-id="@role.Id" class="btn btn-sm btn-primary flex-fill">
                            <i class="bi bi-key me-1"></i>Permissions
                        </a>
                        <button class="btn btn-sm btn-light border" onclick="deleteRole(@role.Id, '@role.Name')"
                            @(role.UserCount > 0 ? "disabled title='Has users'" : "")>
                            <i class="bi bi-trash text-danger"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function deleteRole(id, name) {
            Swal.fire({ title: 'Delete Role?', text: `Delete "${name}"?`, icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Delete' })
            .then(r => { if (r.isConfirmed) {
                $.post('/Role/Delete', { id, __RequestVerificationToken: $('[name=__RequestVerificationToken]').val() },
                    d => { if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 700); }
                           else toastr.error(d.message); });
            }});
        }
    </script>
}