@model ClothingERP.Application.DTOs.LoginDto
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — CLOZEY ERP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --black:       #0a0a0a;
            --black-soft:  #141414;
            --gold:        #c9a96e;
            --gold-deep:   #a6845a;
            --gold-pale:   #f0ddb8;
            --cream:       #faf8f5;
            --cream-mid:   #f3ede3;
            --border:      #e8e0d0;
            --text:        #1a1a1a;
            --muted:       #888;
        }

        html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: var(--cream); }

        /* ── Wrapper ────────────────────────────────────────────────────── */
        .lw { display: flex; min-height: 100vh; }

        /* ── Left Dark Panel ────────────────────────────────────────────── */
        .lp {
            width: 44%;
            background: var(--black);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 40px;
            position: relative;
            overflow: hidden;
        }

        /* Concentric arcs */
        .arc {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(201,169,110,.09);
            pointer-events: none;
        }
        .arc-1 { width:560px; height:560px; top:-200px; left:-180px; }
        .arc-2 { width:380px; height:380px; bottom:-140px; right:-120px; }
        .arc-3 { width:220px; height:220px; top:42%; right:24px; }
        .arc-4 { width:100px; height:100px; top:14%;  left:14%; border-style:dashed; border-color:rgba(201,169,110,.06); }

        

        /* Brand content */
        .lp-inner { position: relative; z-index: 1; text-align: center; }

            .lp-logo {
                width: 150px;
                display: block;
                margin: 0 auto 10px;
                padding: 12px 18px;
                background: rgba(255, 255, 255, 0.12);
                border-radius: 10px;
                backdrop-filter: blur(4px);
            }

        .lp-divider {
            width: 48px; height: 1px;
            background: var(--gold);
            margin: 18px auto;
        }

        .lp-tag {
            font-size: .6rem;
            font-weight: 500;
            letter-spacing: .38em;
            text-transform: uppercase;
            color: var(--gold);
        }

        .lp-quote {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 1rem;
            color: rgba(255,255,255,.38);
            line-height: 1.9;
            max-width: 220px;
            margin: 20px auto 0;
        }

        .lp-system {
            margin-top: 36px;
            font-size: .58rem;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: rgba(255,255,255,.16);
        }

        /* ── Right Form Panel ───────────────────────────────────────────── */
        .rp {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 24px;
            background: var(--cream);
        }

        .fb { width: 100%; max-width: 380px; }

        /* Small logo top of form */
        .fb-logo {
            width: 68px;
            display: block;
            margin: 0 auto 22px;
            opacity: .78;
        }

        .fb-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.05rem;
            font-weight: 500;
            color: var(--text);
            text-align: center;
            letter-spacing: .02em;
        }

        .fb-sub {
            font-size: .65rem;
            font-weight: 500;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: var(--muted);
            text-align: center;
            margin-top: 5px;
        }

        .fb-divider {
            width: 40px; height: 1px;
            background: var(--gold);
            margin: 20px auto 28px;
        }

        /* Form fields */
        .field-group { position: relative; margin-bottom: 26px; }

        .field-label {
            display: block;
            font-size: .6rem;
            font-weight: 500;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--text);
            margin-bottom: 8px;
        }

        .field-input {
            width: 100%;
            border: none;
            border-bottom: 1.5px solid var(--border);
            border-radius: 0;
            background: transparent;
            padding: 9px 32px 9px 0;
            font-size: .92rem;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            outline: none;
            transition: border-color .22s;
        }

        .field-input:focus { border-bottom-color: var(--gold); }
        .field-input::placeholder { color: #cbc4b8; }

        .field-icon {
            position: absolute;
            right: 0; bottom: 10px;
            color: #c8c0b4;
            font-size: .9rem;
            cursor: pointer;
            transition: color .2s;
            background: none; border: none; padding: 0;
        }
        .field-icon:hover { color: var(--gold); }

        .field-error { font-size: .7rem; color: #c0392b; margin-top: 4px; }

        /* Alert */
        .err-alert {
            font-size: .8rem;
            padding: 11px 14px;
            background: #fff5f5;
            border-left: 2.5px solid #c0392b;
            color: #992b2b;
            margin-bottom: 22px;
            border-radius: 0 4px 4px 0;
        }

        /* Remember me */
        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 28px;
        }

        .remember-row input[type="checkbox"] {
            width: 14px; height: 14px;
            accent-color: var(--black);
            cursor: pointer;
        }

        .remember-row label {
            font-size: .7rem;
            color: var(--muted);
            letter-spacing: .04em;
            cursor: pointer;
            user-select: none;
        }

        /* Submit button */
        .btn-signin {
            width: 100%;
            padding: 14px;
            background: var(--black);
            color: #fff;
            border: none;
            border-radius: 0;
            font-family: 'DM Sans', sans-serif;
            font-size: .65rem;
            font-weight: 500;
            letter-spacing: .3em;
            text-transform: uppercase;
            cursor: pointer;
            transition: background .25s;
            position: relative;
            overflow: hidden;
        }

        .btn-signin::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(201,169,110,.18) 50%, transparent 100%);
            transform: translateX(-100%);
            transition: transform .55s ease;
        }

        .btn-signin:hover { background: var(--gold-deep); }
        .btn-signin:hover::after { transform: translateX(100%); }
        .btn-signin:active { transform: scale(.99); }

        /* Footer */
        .fb-footer {
            margin-top: 28px;
            font-size: .64rem;
            color: #bbb;
            text-align: center;
            letter-spacing: .05em;
        }

        /* Validation */
        .field-input.is-invalid { border-bottom-color: #c0392b; }

        /* ── Responsive ─────────────────────────────────────────────────── */
        @@media (max-width: 820px) {
            .lp { display: none; }
            .rp { background: #fff; }
        }
    </style>
</head>
<body>
<div class="lw">

    <!-- ══ Left Brand Panel ═══════════════════════════════════════════════ -->
    <div class="lp">
        <div class="arc arc-1"></div>
        <div class="arc arc-2"></div>
        <div class="arc arc-3"></div>
        <div class="arc arc-4"></div>

       

        <div class="lp-inner">
            <img src="/logo/logo.png" class="lp-logo" alt="CLOZEY" />
            <div class="lp-tag">Attractive Beauty</div>
            <div class="lp-divider"></div>
            <p class="lp-quote">
                "Elegance is the only beauty<br/>that never fades."
            </p>
            <p class="lp-system">Business Management System</p>
        </div>
    </div>

    <!-- ══ Right Form Panel ══════════════════════════════════════════════ -->
    <div class="rp">
        <div class="fb">

            <img src="/logo/logo.png" class="fb-logo" alt="CLOZEY" />
            <h1 class="fb-title">Welcome Back</h1>
            <p class="fb-sub">Sign in to continue</p>
            <div class="fb-divider"></div>

            <form asp-action="Login" asp-controller="Auth" method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="err-alert">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        @Html.ValidationSummary(true)
                    </div>
                }

                @if (TempData["error"] != null)
                {
                    <div class="err-alert">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        @TempData["error"]
                    </div>
                }

                <!-- Username -->
                <div class="field-group">
                    <label asp-for="Username" class="field-label">Username</label>
                    <input asp-for="Username" class="field-input"
                           placeholder="Enter your username"
                           autocomplete="username" autofocus />
                    <button type="button" class="field-icon" tabindex="-1" aria-hidden="true">
                        <i class="bi bi-person"></i>
                    </button>
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <!-- Password -->
                <div class="field-group">
                    <label asp-for="Password" class="field-label">Password</label>
                    <input asp-for="Password" id="pwdField" class="field-input"
                           type="password" placeholder="Enter your password"
                           autocomplete="current-password" />
                    <button type="button" class="field-icon" onclick="togglePwd()" tabindex="-1" aria-label="Show password">
                        <i class="bi bi-eye" id="pwdEye"></i>
                    </button>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <!-- Remember -->
                <div class="remember-row">
                    <input asp-for="RememberMe" type="checkbox" id="rememberCheck" />
                    <label for="rememberCheck">Keep me signed in</label>
                </div>

                <button type="submit" class="btn-signin">Sign In</button>
            </form>

            <p class="fb-footer">© @DateTime.Now.Year CLOZEY — Attractive Beauty</p>
        </div>
    </div>
</div>

<script>
function togglePwd() {
    const f = document.getElementById('pwdField');
    const e = document.getElementById('pwdEye');
    f.type   = f.type === 'password' ? 'text' : 'password';
    e.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}
</script>
</body>
</html>