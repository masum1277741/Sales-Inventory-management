@model ClothingERP.Application.DTOs.LoginDto
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Clothing ERP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            font-family: 'Segoe UI', sans-serif;
        }
        .login-wrapper { width: 100%; padding: 16px; }
        .login-card {
            background: #fff;
            border-radius: 20px;
            padding: 40px 36px;
            width: 100%;
            max-width: 420px;
            margin: 0 auto;
            box-shadow: 0 24px 80px rgba(0,0,0,.4);
        }
        .brand-icon {
            width: 64px; height: 64px; background: #4f7cff;
            border-radius: 16px; display: flex; align-items: center;
            justify-content: center; margin: 0 auto 16px; font-size: 1.8rem; color: #fff;
        }
        .brand-title  { text-align: center; font-size: 1.5rem; font-weight: 700; color: #1a1d23; margin-bottom: 4px; }
        .brand-sub    { text-align: center; font-size: .85rem; color: #888; margin-bottom: 28px; }
        .form-label   { font-weight: 600; font-size: .85rem; color: #444; margin-bottom: 6px; }
        .input-group-text { background: #f7f8fc; border-right: 0; color: #888; }
        .form-control {
            border-left: 0;
            background: #f7f8fc;
            padding: 10px 14px;
            font-size: .9rem;
        }
        .form-control:focus { box-shadow: none; border-color: #4f7cff; background: #fff; }
        .btn-login {
            background: #4f7cff; color: #fff; border: none;
            padding: 12px; font-size: .95rem; font-weight: 600;
            border-radius: 10px; transition: background .2s;
        }
        .btn-login:hover { background: #3a6ae0; color: #fff; }
        .toggle-pw { cursor: pointer; background: #f7f8fc; border-left: 0; border-color: #dee2e6; }
        .footer-text { text-align: center; font-size: .75rem; color: #aaa; margin-top: 24px; }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-card">
        <div class="brand-icon"><i class="bi bi-bag-heart-fill"></i></div>
        <div class="brand-title">Clothing ERP</div>
        <div class="brand-sub">Sign in to your account</div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <span asp-validation-summary="ModelOnly"></span>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="Username" class="form-control" placeholder="Enter username" autocomplete="username" />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="passwordInput" class="form-control"
                           placeholder="Enter password" autocomplete="current-password" />
                    <button class="btn toggle-pw border" type="button" id="togglePw" tabindex="-1">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check mb-0">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-login w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    $('#togglePw').on('click', function () {
        const inp  = $('#passwordInput');
        const icon = $('#eyeIcon');
        if (inp.attr('type') === 'password') {
            inp.attr('type', 'text');
            icon.removeClass('bi-eye').addClass('bi-eye-slash');
        } else {
            inp.attr('type', 'password');
            icon.removeClass('bi-eye-slash').addClass('bi-eye');
        }
    });
</script>
</body>
</html>