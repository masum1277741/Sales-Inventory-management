@model StockDto
@{
    ViewData["Title"] = "Stock Movements";

    var totalIn = Model.Movements
        .Where(m => m.MovementType is "Purchase" or "SalesReturn" or "OpeningBalance" or "Adjustment" && m.NewQuantity > m.PreviousQuantity)
        .Sum(m => m.Quantity);
    var totalOut = Model.Movements
        .Where(m => m.MovementType is "Sale" or "PurchaseReturn" && m.NewQuantity < m.PreviousQuantity)
        .Sum(m => m.Quantity);

    (string cls, string icon, string label) GetTypeStyle(string t) => t switch
    {
        "Purchase" => ("success", "bi-box-arrow-in-down-right", "Purchase"),
        "Sale" => ("danger", "bi-box-arrow-up-right", "Sale"),
        "SalesReturn" => ("info", "bi-arrow-return-left", "Sales Return"),
        "PurchaseReturn" => ("warning", "bi-arrow-return-right", "Purchase Return"),
        "Adjustment" => ("purple", "bi-sliders", "Adjustment"),
        "OpeningBalance" => ("secondary", "bi-bank", "Opening Balance"),
        _ => ("secondary", "bi-circle", t)
    };
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Stock Movement History</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Stock</a></li>
                <li class="breadcrumb-item active">Movements</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-warning btn-sm"
                onclick="openAdjust(@Model.ProductVariantId, '@Model.ProductName', '@Model.SizeName', '@Model.ColorName', @Model.Quantity)">
            <i class="bi bi-sliders me-1"></i>Adjust Stock
        </button>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<!-- Product Info + Stats -->
<div class="row g-3 mb-4">
    <!-- Product Card -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div style="width:60px;height:60px;border-radius:12px;background:#e8f0fe;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-box-seam text-primary fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">@Model.ProductName</h5>
                        <code class="small">@Model.ProductSKU</code>
                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            <span class="badge bg-secondary">@Model.SizeName</span>
                            <span class="badge bg-light text-dark border">@Model.ColorName</span>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">Barcode: </small>
                            <code class="small">@Model.Barcode</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Stats -->
    <div class="col-md-7">
        <div class="row g-3 h-100">
            <div class="col-4">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                        <div class="icon-wrap mb-2 mx-auto" style="background:#e8f5e9;">
                            <i class="bi bi-box-arrow-in-down-right" style="color:#43a047;"></i>
                        </div>
                        <div class="text-muted small">Total In</div>
                        <h4 class="fw-bold text-success mb-0">+@totalIn.ToString("N0")</h4>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                        <div class="icon-wrap mb-2 mx-auto" style="background:#fce4ec;">
                            <i class="bi bi-box-arrow-up-right" style="color:#e53935;"></i>
                        </div>
                        <div class="text-muted small">Total Out</div>
                        <h4 class="fw-bold text-danger mb-0">-@totalOut.ToString("N0")</h4>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card border-0 shadow-sm h-100 text-center @(Model.Status == "Out of Stock" ? "border-danger" : Model.Status == "Low Stock" ? "border-warning" : "border-success") border-2">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                        <div class="icon-wrap mb-2 mx-auto" style="background:#e8f0fe;">
                            <i class="bi bi-archive" style="color:#4f7cff;"></i>
                        </div>
                        <div class="text-muted small">Current</div>
                        <h4 class="fw-bold @(Model.Status == "Out of Stock" ? "text-danger" : Model.Status == "Low Stock" ? "text-warning" : "text-success") mb-0">
                            @Model.Quantity.ToString("N0")
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Date Filter -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3 d-flex gap-2 align-items-center flex-wrap">
        <i class="bi bi-calendar-range text-muted"></i>
        <input type="date" id="fromDate" class="form-control form-control-sm" style="width:150px;" />
        <span class="text-muted small">to</span>
        <input type="date" id="toDate" class="form-control form-control-sm" style="width:150px;" />
        <button class="btn btn-sm btn-primary" onclick="filterByDate()">
            <i class="bi bi-filter me-1"></i>Filter
        </button>
        <button class="btn btn-sm btn-light border" onclick="clearDateFilter()">Clear</button>
        <span class="ms-auto text-muted small">
            Total: <strong>@Model.Movements.Count</strong> movements
        </span>
    </div>
</div>

<!-- Movements Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="movementsTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="170">Date & Time</th>
                        <th width="160">Type</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">Before</th>
                        <th class="text-center">After</th>
                        <th>Reference</th>
                        <th>Note / Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Movements.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2"></i>
                                <p class="mt-2">No movement history found.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model.Movements.OrderByDescending(x => x.MovementDate))
                    {
                        var (cls, icon, label) = GetTypeStyle(m.MovementType);
                        var isIncoming = m.NewQuantity >= m.PreviousQuantity;
                        var diff = m.NewQuantity - m.PreviousQuantity;

                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold small">@m.MovementDate.ToString("dd MMM yyyy")</div>
                                <div class="text-muted" style="font-size:.72rem;">@m.MovementDate.ToString("HH:mm:ss")</div>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-@cls bg-opacity-15 text-@cls px-2 py-1">
                                    <i class="bi @icon me-1"></i>@label
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="fw-bold @(isIncoming ? "text-success" : "text-danger")">
                                    @(isIncoming ? "+" : "-")@m.Quantity.ToString("N0")
                                </span>
                            </td>
                            <td class="text-center text-muted small">
                                @m.PreviousQuantity.ToString("N0")
                            </td>
                            <td class="text-center">
                                <span class="fw-bold @(m.NewQuantity <= 0 ? "text-danger" : "text-dark")">
                                    @m.NewQuantity.ToString("N0")
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(m.ReferenceNumber))
                                {
                                    <code class="small">@m.ReferenceNumber</code>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-muted small">@(m.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Adjust Modal (reused from Index) -->
<div class="modal fade" id="adjustModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-sliders me-2 text-warning"></i>Quick Adjustment</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="rounded p-3 mb-3" style="background:#f8f9ff;">
                    <div class="fw-semibold" id="adjProductName"></div>
                    <div class="text-muted small" id="adjVariantInfo"></div>
                    <div class="mt-1">Current: <strong id="adjCurrentQty" class="ms-1"></strong> pcs</div>
                </div>
                <input type="hidden" id="adjVarId" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">New Quantity <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <button class="btn btn-light border" type="button" onclick="$('#adjQty').val(Math.max(0, parseInt($('#adjQty').val())||0 - 1))"><i class="bi bi-dash"></i></button>
                        <input type="number" class="form-control text-center fw-bold" id="adjQty" min="0" />
                        <button class="btn btn-light border" type="button" onclick="$('#adjQty').val((parseInt($('#adjQty').val())||0) + 1)"><i class="bi bi-plus"></i></button>
                    </div>
                </div>
                <div>
                    <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="adjReasonText" rows="2" placeholder="Reason for adjustment..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning px-4" onclick="doAdjust()">
                    <i class="bi bi-check-lg me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(function() {
            initDataTable('#movementsTable', { order: [[0, 'desc']], pageLength: 25 });
        });

        function filterByDate() {
            const from = $('#fromDate').val();
            const to   = $('#toDate').val();
            const dt   = $('#movementsTable').DataTable();
            $.fn.dataTable.ext.search.push((settings, data) => {
                const rowDate = new Date(data[0]);
                if (from && rowDate < new Date(from)) return false;
                if (to   && rowDate > new Date(to))   return false;
                return true;
            });
            dt.draw();
        }

        function clearDateFilter() {
            $('#fromDate, #toDate').val('');
            $.fn.dataTable.ext.search.pop();
            $('#movementsTable').DataTable().draw();
        }

        function openAdjust(variantId, productName, size, color, qty) {
            $('#adjVarId').val(variantId);
            $('#adjProductName').text(productName);
            $('#adjVariantInfo').text(`${size} / ${color}`);
            $('#adjCurrentQty').text(qty);
            $('#adjQty').val(qty);
            $('#adjReasonText').val('');
            new bootstrap.Modal('#adjustModal').show();
            setTimeout(() => $('#adjQty').focus().select(), 400);
        }

        function doAdjust() {
            const variantId = $('#adjVarId').val();
            const qty       = $('#adjQty').val();
            const reason    = $('#adjReasonText').val().trim();
            if (!reason) { toastr.error('Reason required.'); return; }
            $.post('/Stock/Adjust', {
                ProductVariantId: variantId, NewQuantity: qty, Reason: reason,
                __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
            }, d => {
                if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 900); }
                else toastr.error(d.message);
            });
        }
    </script>

    <style>
        .badge.bg-purple, .text-purple {
            background: #f3e5f5 !important;
            color: #7b1fa2 !important;
        }
    </style>
}