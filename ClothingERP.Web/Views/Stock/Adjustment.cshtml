@{
    ViewData["Title"] = "Stock Adjustment";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-sliders me-2 text-warning"></i>Stock Adjustment</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Stock</a></li>
                <li class="breadcrumb-item active">Adjustment</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back to Stock</a>
</div>
@if ((bool)ViewBag.IsAdmin)
{
    <div class="mb-3">
        <label class="form-label fw-semibold">Branch</label>
        <select id="branchSelect" class="form-select" style="max-width:280px;">
            @foreach (var b in (IEnumerable<dynamic>)ViewBag.Branches)
            {
                <option value="@b.Id" selected="@(b.Id == (int)ViewBag.CurrentBranchId)">@b.Name</option>
            }
        </select>
    </div>
}
else
{
    <input type="hidden" id="branchSelect" value="@ViewBag.CurrentBranchId" />
}
<div class="row g-4">
    <!-- ── Left: Adjustment Form ────────────────────────────────────────── -->
    <div class="col-lg-7">

        <!-- Search Section -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-search me-2 text-primary"></i>Find Product</span>
            </div>
            <div class="card-body p-4">
                <!-- Barcode Search -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Scan Barcode or Enter SKU</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-upc-scan text-primary"></i></span>
                        <input type="text" id="barcodeInput" class="form-control"
                               placeholder="Scan or type barcode / SKU..."
                               autofocus autocomplete="off" />
                        <button class="btn btn-primary" type="button" onclick="searchBarcode()">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <small class="text-muted">Press Enter to search</small>
                </div>

                <!-- OR keyword search -->
                <div class="position-relative">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <hr class="flex-grow-1" /><span class="text-muted small px-2">or search by name</span><hr class="flex-grow-1" />
                    </div>
                    <input type="text" id="keywordInput" class="form-control"
                           placeholder="Type product name..."
                           autocomplete="off" oninput="searchKeyword(this.value)" />
                    <div id="searchDropdown" class="position-absolute w-100 bg-white border rounded shadow-sm"
                         style="top:100%;z-index:100;max-height:250px;overflow-y:auto;display:none;"></div>
                </div>
            </div>
        </div>

        <!-- Product Info Card (hidden until found) -->
        <div id="productInfoCard" class="card border-0 shadow-sm mb-4 border-start border-3 border-warning" style="display:none;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between">
                <span class="fw-semibold"><i class="bi bi-box me-2 text-warning"></i>Selected Product</span>
                <button class="btn btn-sm btn-light" onclick="clearProduct()">
                    <i class="bi bi-x me-1"></i>Clear
                </button>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <div style="width:60px;height:60px;border-radius:12px;background:#fff3e0;display:flex;align-items:center;justify-content:center;font-size:1.8rem;">
                            <i class="bi bi-box text-warning"></i>
                        </div>
                    </div>
                    <div class="col">
                        <h5 class="fw-bold mb-1" id="pInfoName">—</h5>
                        <div class="d-flex gap-3 flex-wrap">
                            <span><code id="pInfoSku" class="small"></code></span>
                            <span class="badge bg-secondary" id="pInfoSize">—</span>
                            <span id="pInfoColorWrap" class="d-flex align-items-center gap-1">
                                <div id="pInfoColorDot" style="width:14px;height:14px;border-radius:3px;border:1px solid #dee2e6;"></div>
                                <span id="pInfoColorName" class="small">—</span>
                            </span>
                        </div>
                        <div class="mt-1">
                            <code class="small text-muted" id="pInfoBarcode">—</code>
                        </div>
                    </div>
                    <div class="col-auto text-end">
                        <div class="text-muted small">Current Stock</div>
                        <div class="fw-bold fs-3 lh-1" id="pInfoCurrentQty">0</div>
                        <div class="text-muted small">pcs</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Adjustment Form (hidden until product selected) -->
        <div id="adjustFormCard" class="card border-0 shadow-sm" style="display:none;">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-pencil-square me-2 text-primary"></i>Adjustment Details</span>
            </div>
            <div class="card-body p-4">
                <input type="hidden" id="adjVariantId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Current Quantity</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-archive"></i></span>
                            <input type="number" class="form-control bg-light fw-bold" id="currentQtyDisplay" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">New Quantity <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <button class="btn btn-light border" type="button" onclick="adjDelta(-1)">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <input type="number" class="form-control text-center fw-bold fs-5" id="newQtyInput"
                                   min="0" step="1" oninput="updateDiff()" />
                            <button class="btn btn-light border" type="button" onclick="adjDelta(1)">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Difference display -->
                <div id="diffDisplay" class="alert py-2 mt-3" style="display:none;">
                    <i class="bi bi-arrow-left-right me-2"></i>
                    Adjustment: <strong id="diffValue">0</strong> pcs
                    (<span id="diffType">No change</span>)
                </div>

                <!-- Quick set buttons -->
                <div class="d-flex gap-1 flex-wrap mt-2 mb-3">
                    <span class="text-muted small align-self-center me-1">Quick Set:</span>
                    @foreach (var n in new[] { 0, 5, 10, 25, 50, 100 })
                    {
                        <button class="btn btn-sm btn-light border" type="button"
                                onclick="setQty(@n)">
                            @n
                        </button>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                    <select class="form-select mb-2" id="reasonSelect"
                            onchange="if(this.value) $('#reasonText').val(this.value)">
                        <option value="">— Choose quick reason —</option>
                        <option>Physical count correction</option>
                        <option>Damaged goods write-off</option>
                        <option>Opening balance entry</option>
                        <option>Transfer from other location</option>
                        <option>Found during stock audit</option>
                        <option>System error correction</option>
                    </select>
                    <textarea class="form-control" id="reasonText" rows="2"
                              placeholder="Type or select reason above..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-warning px-5" onclick="submitAdjustment()">
                        <i class="bi bi-check-circle me-1"></i>Apply Adjustment
                    </button>
                    <button type="button" class="btn btn-light border" onclick="clearProduct()">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Right: Recent Adjustments ────────────────────────────────────── -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Adjustments</span>
            </div>
            <div class="card-body p-0" id="recentAdjustments">
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-2"></i>
                    <p class="mt-2 small">Adjustments will appear here</p>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ── Barcode Search ─────────────────────────────────────────────────────────
        document.getElementById('barcodeInput').addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); searchBarcode(); }
        });

        async function searchBarcode() {
            const barcode = $('#barcodeInput').val().trim();
            if (!barcode) return;
            const data = await fetch(`/Stock/SearchByBarcode?barcode=${encodeURIComponent(barcode)}&branchId=${$('#branchSelect').val()}`).then(r => r.json());
            if (data) { populateProduct(data); $('#barcodeInput').val(''); }
            else { toastr.error('Product not found for barcode: ' + barcode); }
        }

        // ── Keyword Search (autocomplete) ──────────────────────────────────────────
        let searchTimer;
        function searchKeyword(val) {
            clearTimeout(searchTimer);
            if (val.length < 2) { $('#searchDropdown').hide(); return; }
            searchTimer = setTimeout(async () => {
                const data = await fetch(`/Stock/SearchVariants?keyword=${encodeURIComponent(val)}&branchId=${$('#branchSelect').val()}`).then(r => r.json());
                const dd = $('#searchDropdown');
                if (!data.length) { dd.hide(); return; }
                dd.html(data.map(v => `
                    <div class="dropdown-item d-flex align-items-center gap-2 py-2" style="cursor:pointer;"
                         onclick="selectFromDropdown(${v.id}, '${v.productName}', '${v.productSKU}', '${v.sizeName}', '${v.colorName}', '${v.colorHex}', '${v.barcode}', ${v.stockQuantity})">
                        <div style="width:12px;height:12px;border-radius:3px;background:${v.colorHex || '#ccc'};border:1px solid #dee2e6;flex-shrink:0;"></div>
                        <div>
                            <div class="fw-semibold small">${v.productName}</div>
                            <div class="text-muted" style="font-size:.72rem;">${v.productSKU} · ${v.sizeName} · ${v.colorName} · Stock: ${v.stockQuantity}</div>
                        </div>
                    </div>
                `).join('')).show();
            }, 300);
        }

        function selectFromDropdown(id, name, sku, size, color, hex, barcode, qty) {
            populateProduct({ variantId: id, productName: name, sku, sizeName: size, colorName: color, colorHex: hex, barcode, currentQty: qty });
            $('#keywordInput').val('');
            $('#searchDropdown').hide();
        }

        // ── Populate Product Info ──────────────────────────────────────────────────
        function populateProduct(d) {
            $('#adjVariantId').val(d.variantId);
            $('#pInfoName').text(d.productName);
            $('#pInfoSku').text(d.sku);
            $('#pInfoSize').text(d.sizeName);
            $('#pInfoColorDot').css('background', d.colorHex || '#ccc');
            $('#pInfoColorName').text(d.colorName);
            $('#pInfoBarcode').text(d.barcode);
            $('#pInfoCurrentQty').text(d.currentQty);
            $('#currentQtyDisplay').val(d.currentQty);
            $('#newQtyInput').val(d.currentQty);
            updateDiff();
            $('#productInfoCard, #adjustFormCard').fadeIn(200);
            setTimeout(() => $('#newQtyInput').focus().select(), 300);
        }

        function clearProduct() {
            $('#productInfoCard, #adjustFormCard').hide();
            $('#barcodeInput').focus();
            $('#newQtyInput, #currentQtyDisplay').val('');
            $('#reasonText').val('');
            $('#reasonSelect').val('');
            $('#diffDisplay').hide();
        }

        // ── Quantity Helpers ───────────────────────────────────────────────────────
        function adjDelta(delta) {
            const val = parseInt($('#newQtyInput').val()) || 0;
            $('#newQtyInput').val(Math.max(0, val + delta));
            updateDiff();
        }

        function setQty(n) { $('#newQtyInput').val(n); updateDiff(); }

        function updateDiff() {
            const current = parseInt($('#currentQtyDisplay').val()) || 0;
            const newVal  = parseInt($('#newQtyInput').val());
            if (isNaN(newVal)) { $('#diffDisplay').hide(); return; }
            const diff = newVal - current;
            const el   = $('#diffDisplay');

            if (diff === 0) { el.removeClass('alert-danger alert-success alert-secondary').addClass('alert-secondary').show(); }
            else if (diff > 0) { el.removeClass('alert-danger alert-secondary').addClass('alert-success').show(); }
            else { el.removeClass('alert-success alert-secondary').addClass('alert-danger').show(); }

            $('#diffValue').text((diff >= 0 ? '+' : '') + diff);
            $('#diffType').text(diff > 0 ? 'Increase' : diff < 0 ? 'Decrease' : 'No change');
        }

        // ── Submit Adjustment ──────────────────────────────────────────────────────
        function submitAdjustment() {
            const variantId = $('#adjVariantId').val();
            const newQty    = $('#newQtyInput').val();
            const reason    = $('#reasonText').val().trim();

            if (!variantId) { toastr.error('No product selected.'); return; }
            if (newQty === '' || isNaN(parseInt(newQty))) { toastr.error('Enter valid quantity.'); return; }
            if (!reason) { toastr.error('Reason is required.'); return; }

            const btn = event.currentTarget;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

            $.post('/Stock/Adjust', {
                ProductVariantId: variantId, NewQuantity: newQty, Reason: reason,
                BranchId: $('#branchSelect').val(),
                __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
            }, d => {
                if (d.success) {
                    toastr.success(d.message);
                    addToRecentList(variantId, newQty, reason);
                    clearProduct();
                    $('#barcodeInput').focus();
                } else toastr.error(d.message);
            }).always(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Apply Adjustment';
            });
        }

        const recentList = [];

        function addToRecentList(variantId, qty, reason) {
            recentList.unshift({ variantId, qty, reason, time: new Date().toLocaleTimeString() });
            const container = $('#recentAdjustments');
            container.html(recentList.slice(0, 10).map(r => `
                <div class="d-flex align-items-center gap-3 px-4 py-3 border-bottom">
                    <div class="icon-wrap" style="background:#fff3e0;width:36px;height:36px;">
                        <i class="bi bi-sliders" style="color:#f57c00;font-size:.9rem;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold small">Variant #${r.variantId}</div>
                        <div class="text-muted" style="font-size:.72rem;">${r.reason}</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold">${r.qty} pcs</div>
                        <div class="text-muted" style="font-size:.7rem;">${r.time}</div>
                    </div>
                </div>
            `).join(''));
        }

        // ── Close dropdown on outside click ───────────────────────────────────────
        $(document).on('click', e => {
            if (!$(e.target).closest('#keywordInput, #searchDropdown').length)
                $('#searchDropdown').hide();
        });
    </script>
}
