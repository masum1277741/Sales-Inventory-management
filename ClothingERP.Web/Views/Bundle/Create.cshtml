@model CreateProductBundleDto
@{
    ViewData["Title"] = "Create Bundle Offer";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-boxes me-2 text-primary"></i>Create Bundle Offer</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Bundles</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<form asp-action="Create" method="post" id="bundleForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Bundle Details</span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bundle Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Summer Combo Pack" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bundle Price (USD) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="BundlePrice" id="bundlePrice" class="form-control" type="number" step="0.01" oninput="recalcSavings()" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" checked />
                                <label class="form-check-label">Active immediately</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Start Date (optional)</label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">End Date (optional)</label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                        </div>
                    </div>

                    <!-- Savings Preview -->
                    <div class="mt-4 p-3 rounded" style="background:var(--clz-cream);border:1px solid var(--border);">
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Regular Price (sum of items)</span>
                            <span class="fw-bold" id="regularPriceDisplay">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small mt-1">
                            <span class="text-muted">Customer Saves</span>
                            <span class="fw-bold text-success" id="savingsDisplay">$0.00 (0%)</span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save Bundle
                    </button>
                </div>
            </div>
        </div>

        <!-- Item Picker -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between">
                    <span class="fw-semibold"><i class="bi bi-box-seam me-2 text-primary"></i>Bundle Items</span>
                    <span class="badge bg-primary" id="itemCountBadge">0</span>
                </div>
                <div class="card-body p-3">
                    <div class="position-relative mb-3">
                        <input type="text" id="itemSearch" class="form-control"
                               placeholder="Search product to add..." autocomplete="off" />
                        <div id="itemDropdown" class="position-absolute w-100 bg-white border rounded shadow"
                             style="z-index:1000;max-height:260px;overflow-y:auto;display:none;top:100%;"></div>
                    </div>

                    <div id="itemsList">
                        <div class="text-center text-muted py-4" id="emptyItemsMsg">
                            <i class="bi bi-search d-block mb-2" style="font-size:1.8rem;"></i>
                            <small>কমপক্ষে ২টা product/variant যোগ করুন</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const items = []; // {variantId, name, size, color, price, qty, stock}
        let searchTimer;

        document.getElementById('itemSearch').addEventListener('input', function() {
            clearTimeout(searchTimer);
            const val = this.value.trim();
            if (val.length < 2) { $('#itemDropdown').hide(); return; }
            searchTimer = setTimeout(async () => {
                const data = await fetch(`/Bundle/SearchVariants?keyword=${encodeURIComponent(val)}`).then(r => r.json());
                const dd = $('#itemDropdown');
                if (!data.length) { dd.hide(); return; }
                dd.html(data.map(v => `
                    <div class="p-2 border-bottom" style="cursor:pointer;"
                         onmousedown="event.preventDefault();addItem(${JSON.stringify(v).replace(/"/g,'&quot;')})">
                        <div class="fw-semibold small">${v.productName}</div>
                        <div class="text-muted" style="font-size:.72rem;">${v.sizeName} · ${v.colorName} · $${v.retailPrice} · Stock: ${v.stock}</div>
                    </div>`).join('')).show();
            }, 250);
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('#itemSearch, #itemDropdown')) $('#itemDropdown').hide();
        });

        function addItem(v) {
            if (items.some(i => i.variantId === v.variantId)) { toastr.warning('এই item ইতিমধ্যে যোগ করা হয়েছে।'); return; }
            items.push({ variantId: v.variantId, name: v.productName, size: v.sizeName, color: v.colorName, price: v.retailPrice, qty: 1, stock: v.stock });
            document.getElementById('itemSearch').value = '';
            $('#itemDropdown').hide();
            renderItems();
        }

        function removeItem(idx) { items.splice(idx, 1); renderItems(); }
        function setQty(idx, val) { items[idx].qty = Math.max(1, parseInt(val) || 1); renderItems(); }

        function renderItems() {
            const list = document.getElementById('itemsList');
            document.getElementById('itemCountBadge').textContent = items.length;

            if (!items.length) {
                list.innerHTML = `<div class="text-center text-muted py-4"><i class="bi bi-search d-block mb-2" style="font-size:1.8rem;"></i><small>কমপক্ষে ২টা product/variant যোগ করুন</small></div>`;
                recalcSavings();
                return;
            }

            list.innerHTML = items.map((it, i) => `
                <div class="d-flex align-items-center gap-2 p-2 mb-2 rounded" style="background:var(--clz-cream);">
                    <div class="flex-grow-1">
                        <div class="fw-semibold small">${it.name}</div>
                        <div class="text-muted" style="font-size:.7rem;">${it.size} · ${it.color} · $${it.price}/each</div>
                    </div>
                    <input type="number" class="form-control form-control-sm" style="width:55px;" value="${it.qty}" min="1"
                           onchange="setQty(${i}, this.value)" />
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(${i})">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <input type="hidden" name="Items[${i}].ProductVariantId" value="${it.variantId}" />
                <input type="hidden" name="Items[${i}].Quantity" value="${it.qty}" />
            `).join('');

            recalcSavings();
        }

        function recalcSavings() {
            const regular = items.reduce((s, i) => s + i.price * i.qty, 0);
            const bundlePrice = parseFloat(document.getElementById('bundlePrice').value) || 0;
            const savings = regular - bundlePrice;
            const pct = regular > 0 ? (savings / regular * 100) : 0;

            document.getElementById('regularPriceDisplay').textContent = '$' + regular.toFixed(2);
            document.getElementById('savingsDisplay').textContent = `$${savings.toFixed(2)} (${pct.toFixed(0)}%)`;
            document.getElementById('savingsDisplay').className = 'fw-bold ' + (savings >= 0 ? 'text-success' : 'text-danger');
        }

        document.getElementById('bundleForm').addEventListener('submit', function(e) {
            if (items.length < 2) {
                e.preventDefault();
                toastr.error('কমপক্ষে ২টা item যোগ করুন।');
            }
        });
    </script>
}