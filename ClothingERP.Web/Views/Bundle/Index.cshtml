@model IEnumerable<ProductBundleListDto>
@{
    ViewData["Title"] = "Combo & Bundle Offers"; var items = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-boxes me-2 text-primary"></i>Combo & Bundle Offers</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Bundles</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Create Bundle
    </a>
</div>

<div class="row g-3">
    @foreach (var b in items)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="fw-bold mb-0">@b.Name</h6>
                        @if (b.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>

                    <div class="d-flex align-items-baseline gap-2 mb-1">
                        <span class="fs-4 fw-bold" style="color:var(--clz-gold-deep);">$@b.BundlePrice.ToString("N2")</span>
                        <span class="text-muted text-decoration-line-through small">$@b.RegularPrice.ToString("N2")</span>
                    </div>
                    <div class="small text-success fw-semibold mb-3">
                        Save $@b.SavingsAmount.ToString("N2") (@b.SavingsPercent.ToString("N0")%)
                    </div>

                    <div class="d-flex justify-content-between small text-muted mb-3">
                        <span><i class="bi bi-box-seam me-1"></i>@b.ItemCount items</span>
                        <span class="@(b.AvailableStock > 0 ? "text-success" : "text-danger") fw-semibold">
                            @(b.AvailableStock > 0 ? $"{b.AvailableStock} sellable" : "Out of stock")
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <button class="btn btn-sm btn-outline-secondary" onclick="toggleStatus(@b.Id)">
                            <i class="bi bi-toggle2-@(b.IsActive ? "on" : "off")"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" onclick="delBundle(@b.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!items.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-boxes d-block mb-2" style="font-size:2.5rem;"></i>
                    এখনো কোনো bundle তৈরি করা হয়নি।
                    <div class="mt-3"><a asp-action="Create" class="btn btn-primary btn-sm">প্রথম Bundle তৈরি করুন</a></div>
                </div>
            </div>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const tok = () => $('[name=__RequestVerificationToken]').val();

        function delBundle(id) {
            Swal.fire({ title:'Delete Bundle?', icon:'warning', showCancelButton:true, confirmButtonText:'Delete' })
            .then(r => { if (r.isConfirmed) {
                $.post('/Bundle/Delete', { id, __RequestVerificationToken: tok() }, d => {
                    if (d.success) location.reload(); else toastr.error(d.message);
                });
            }});
        }

        function toggleStatus(id) {
            $.post('/Bundle/ToggleStatus', { id, __RequestVerificationToken: tok() }, d => {
                if (d.success) location.reload(); else toastr.error(d.message);
            });
        }
    </script>
}