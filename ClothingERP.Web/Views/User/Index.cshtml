@model IEnumerable<UserDto>
@{
    ViewData["Title"] = "User Management";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>User Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Users</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Add User
    </a>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#e8f0fe;"><i class="bi bi-people" style="color:#4f7cff;"></i></div>
                <div><div class="text-muted small">Total Users</div><h4 class="mb-0 fw-bold">@Model.Count()</h4></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#e8f5e9;"><i class="bi bi-person-check" style="color:#43a047;"></i></div>
                <div><div class="text-muted small">Active</div><h4 class="mb-0 fw-bold text-success">@Model.Count(u => u.IsActive)</h4></div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap" style="background:#fce4ec;"><i class="bi bi-person-x" style="color:#e53935;"></i></div>
                <div><div class="text-muted small">Inactive</div><h4 class="mb-0 fw-bold text-danger">@Model.Count(u => !u.IsActive)</h4></div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="usersTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" width="45">#</th>
                        <th>User</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-center" width="120">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var u in Model)
                    {
                        <tr id="user-row-@u.Id">
                            <td class="ps-4 text-muted small">@(sn++)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(u.ProfileImage))
                                    {
                                        <img src="@u.ProfileImage" class="rounded-circle" width="38" height="38" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="user-avatar-sm">@u.FullName[0].ToString().ToUpper()</div>
                                    }
                                    <div>
                                        <div class="fw-semibold small">@u.FullName</div>
                                        <div class="text-muted" style="font-size:.75rem;">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><code class="small">@u.Username</code></td>
                            <td>
                                <span class="badge rounded-pill px-2 py-1" style="background:#e8f0fe;color:#4f7cff;">
                                    @u.RoleName
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-2 py-1 @(u.IsActive ? "bg-success" : "bg-danger") bg-opacity-15 @(u.IsActive ? "text-success" : "text-danger")">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.4rem;vertical-align:middle;"></i>
                                    @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-muted small">
                                @(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd MMM, HH:mm") : "—")
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border dropdown-toggle" data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@u.Id">
                                                <i class="bi bi-pencil me-2 text-primary"></i>Edit
                                            </a>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" onclick="openResetPassword(@u.Id, '@u.FullName')">
                                                <i class="bi bi-key me-2 text-warning"></i>Reset Password
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" onclick="toggleUserStatus(@u.Id)">
                                                <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check") me-2 @(u.IsActive ? "text-warning" : "text-success")"></i>
                                                @(u.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <button class="dropdown-item text-danger" onclick="deleteUser(@u.Id, '@u.FullName')">
                                                <i class="bi bi-trash me-2"></i>Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-key me-2 text-warning"></i>Reset Password</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted small mb-3">Reset password for: <strong id="resetUserName"></strong></p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input type="password" id="newPwd" class="form-control" placeholder="Min 6 characters" />
                    </div>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold small">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-shield-check"></i></span>
                        <input type="password" id="confirmPwd" class="form-control" placeholder="Re-enter password" />
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning px-4" onclick="submitResetPassword()">
                    <i class="bi bi-check-lg me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(function () { initDataTable('#usersTable'); });

        let _resetUserId = 0;

        function openResetPassword(id, name) {
            _resetUserId = id;
            $('#resetUserName').text(name);
            $('#newPwd, #confirmPwd').val('');
            new bootstrap.Modal(document.getElementById('resetPwdModal')).show();
        }

        function submitResetPassword() {
            const pwd  = $('#newPwd').val().trim();
            const conf = $('#confirmPwd').val().trim();
            if (pwd.length < 6)  { toastr.error('Min 6 characters required.'); return; }
            if (pwd !== conf)     { toastr.error('Passwords do not match.');     return; }

            $.post('/User/ResetPassword', {
                id: _resetUserId, newPassword: pwd,
                __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
            }, d => {
                if (d.success) {
                    bootstrap.Modal.getInstance(document.getElementById('resetPwdModal')).hide();
                    toastr.success(d.message);
                } else { toastr.error(d.message); }
            });
        }

        function toggleUserStatus(id) {
            $.post('/User/ToggleStatus', { id, __RequestVerificationToken: $('[name=__RequestVerificationToken]').val() },
                d => { if (d.success) { toastr.success(d.message); setTimeout(() => location.reload(), 900); } else toastr.error(d.message); });
        }

        function deleteUser(id, name) {
            Swal.fire({ title: 'Delete User?', text: `Delete "${name}"? This cannot be undone.`,
                icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Delete' })
            .then(r => { if (r.isConfirmed) {
                $.post('/User/Delete', { id, __RequestVerificationToken: $('[name=__RequestVerificationToken]').val() },
                    d => { if (d.success) { toastr.success(d.message); $(`#user-row-${id}`).fadeOut(400); } else toastr.error(d.message); });
            }});
        }
    </script>

    <style>
        .user-avatar-sm {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #4f7cff;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .9rem;
            flex-shrink: 0;
        }
    </style>
}