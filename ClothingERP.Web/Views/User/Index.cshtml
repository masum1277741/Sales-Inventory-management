@model IEnumerable<ClothingERP.Application.DTOs.UserListDto>
@{
    ViewData["Title"] = "Users"; var users = Model.ToList();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>Users</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Users</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Add User
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="userTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Branch(es)</th>
                        <th class="text-center">Status</th>
                        <th class="text-center" width="100">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr id="user-@u.Id">
                            <td class="ps-4 fw-semibold">@u.FullName</td>
                            <td class="small text-muted">@u.Username</td>
                            <td><span class="badge bg-primary">@u.RoleName</span></td>
                            <td class="small">
                              
                                @(u.BranchNames ?? "—")
                            </td>
                            <td class="text-center">
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {

                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="Edit" asp-route-id="@u.Id"
                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (u.Id != int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"))
                                    {
                                        <button class="btn btn-sm btn-outline-secondary"
                                                onclick="toggleUser(@u.Id)"
                                                title="@(u.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi bi-toggle2-@(u.IsActive ? "on" : "off")"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people d-block mb-2" style="font-size:2rem;"></i>
                                কোনো user পাওয়া যায়নি।
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        $(function () { initDataTable('#userTable', { order: [[0, 'asc']] }); });

        function toggleUser(id) {
            $.post('/User/ToggleStatus', { id, __RequestVerificationToken: $('[name=__RequestVerificationToken]').val() }, d => {
                if (d.success) { toastr.success(d.message); location.reload(); }
                else toastr.error(d.message);
            });
        }
    </script>
}