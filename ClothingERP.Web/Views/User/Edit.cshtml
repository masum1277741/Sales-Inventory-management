@model EditUserDto
@{
    ViewData["Title"] = "Edit User";
    var branches = (IEnumerable<BranchDto>)ViewBag.Branches;
    var branchList = branches.ToList();
    var assignedIds = (List<int>)(ViewBag.AssignedBranchIds ?? new List<int>());
    var defaultBranchId = (int)(ViewBag.DefaultBranchId ?? 0);
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-person-gear me-2 text-primary"></i>Edit User</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-person me-2 text-primary"></i>User Details</span>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                            <select asp-for="RoleId" class="form-select"
                                    asp-items="@((SelectList)ViewBag.Roles)">
                                <option value="">-- Select Role --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">New Password</label>
                            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Leave blank to keep current" />
                            <small class="text-muted">পরিবর্তন করতে না চাইলে খালি রাখুন।</small>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                <label class="form-check-label fw-semibold">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Branch Assignment -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-shop-window me-2 text-primary"></i>Branch Access</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-2 mb-3">
                        @foreach (var b in branchList)
                        {
                            <div class="col-md-6">
                                <div class="form-check border rounded p-3 @(assignedIds.Contains(b.Id) ? "border-primary bg-light" : "")">
                                    <input class="form-check-input branch-check"
                                           type="checkbox" name="BranchIds" value="@b.Id"
                                           id="branch_@b.Id"
                                    @(assignedIds.Contains(b.Id) ? "checked" : "")
                                           onchange="updateDefaultOptions()" />
                                    <label class="form-check-label fw-semibold w-100" for="branch_@b.Id">
                                        @b.Name
                                        @if (b.IsMainBranch)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Main</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div id="defaultBranchWrap">
                        <label class="form-label fw-semibold">Default Branch</label>
                        <select name="DefaultBranchId" id="defaultBranchSelect" class="form-select">
                            <option value="">-- Select Default --</option>
                            @foreach (var b in branchList.Where(b => assignedIds.Contains(b.Id)))
                            {
                                <option value="@b.Id" selected="@(b.Id == defaultBranchId)">@b.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i>Save Changes
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const allBranches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                    branchList.Select(b => new { id = b.Id, name = b.Name })));

        function updateDefaultOptions() {
            const checked = document.querySelectorAll('.branch-check:checked');
            const select  = document.getElementById('defaultBranchSelect');
            const currentVal = select.value;

            select.innerHTML = '<option value="">-- Select Default --</option>';
            checked.forEach(cb => {
                const b = allBranches.find(x => x.id === parseInt(cb.value));
                if (b) {
                    const opt = document.createElement('option');
                    opt.value = b.id; opt.textContent = b.name;
                    if (String(b.id) === currentVal) opt.selected = true;
                    select.appendChild(opt);
                }
            });
            if (checked.length === 1) select.value = checked[0].value;
        }

        document.addEventListener('DOMContentLoaded', updateDefaultOptions);
    </script>
}
