@model ForecastSummaryDto
@{
    ViewData["Title"] = "AI Demand Forecasting";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>AI Demand Forecasting</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Demand Forecasting</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Settings" class="btn btn-light border"><i class="bi bi-sliders me-1"></i>Settings</a>
</div>

<!-- Search Box -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="position-relative">
            <input type="text" id="productSearch" class="form-control" placeholder="কোনো specific প্রোডাক্টের forecast দেখতে নাম লিখুন..." autocomplete="off" />
            <div id="searchDropdown" class="position-absolute w-100 bg-white border rounded shadow"
                 style="z-index:999;display:none;top:100%;max-height:280px;overflow-y:auto;"></div>
        </div>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="text-muted small">বিশ্লেষণ করা প্রোডাক্ট</div>
            <h4 class="fw-bold mb-0">@Model.TotalProductsAnalyzed</h4>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card border-start border-3 border-success">
            <div class="text-muted small">যথেষ্ট ডাটা আছে</div>
            <h4 class="fw-bold mb-0" style="color:#065f46;">@Model.SufficientDataCount</h4>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="text-muted small">পদ্ধতি</div>
            <h6 class="fw-bold mb-0">Holt-Winters Smoothing</h6>
            <small class="text-muted">Trend + Weekly Seasonality</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top Growing -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-arrow-up-circle me-2 text-success"></i>Top Growing Products</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.TopGrowing.Any())
                {
                    <div class="text-center py-4 text-muted small">এখনো যথেষ্ট ডাটা নেই।</div>
                }
                @foreach (var m in Model.TopGrowing)
                {
                    <a asp-action="Details" asp-route-variantId="@m.ProductVariantId"
                       class="d-flex align-items-center gap-3 p-3 border-bottom text-decoration-none text-dark">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px;background:#d1fae5;color:#065f46;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@m.ProductName</div>
                            <div class="text-muted" style="font-size:.72rem;">@m.SizeName · @m.ColorName</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-success">+@m.TrendPercentage.ToString("N1")%</div>
                            <div class="text-muted" style="font-size:.7rem;">@m.PredictedDemandNext30Days.ToString("N0")/30d</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Top Declining -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold"><i class="bi bi-arrow-down-circle me-2 text-danger"></i>Top Declining Products</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.TopDeclining.Any())
                {
                    <div class="text-center py-4 text-muted small">এখনো যথেষ্ট ডাটা নেই।</div>
                }
                @foreach (var m in Model.TopDeclining)
                {
                    <a asp-action="Details" asp-route-variantId="@m.ProductVariantId"
                       class="d-flex align-items-center gap-3 p-3 border-bottom text-decoration-none text-dark">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px;background:#fee2e2;color:#7f1d1d;">
                            <i class="bi bi-graph-down-arrow"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@m.ProductName</div>
                            <div class="text-muted" style="font-size:.72rem;">@m.SizeName · @m.ColorName</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-danger">@m.TrendPercentage.ToString("N1")%</div>
                            <div class="text-muted" style="font-size:.7rem;">@m.PredictedDemandNext30Days.ToString("N0")/30d</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimer;
        document.getElementById('productSearch').addEventListener('input', function () {
            clearTimeout(searchTimer);
            const val = this.value.trim();
            if (val.length < 2) { $('#searchDropdown').hide(); return; }
            searchTimer = setTimeout(async () => {
                const data = await fetch(`/Forecast/SearchProducts?keyword=${encodeURIComponent(val)}`).then(r => r.json());
                const dd = $('#searchDropdown');
                if (!data.length) { dd.html('<div class="p-3 text-muted small">কোনো ফলাফল পাওয়া যায়নি।</div>').show(); return; }
                dd.html(data.map(m => `
                    <a href="/Forecast/Details?variantId=${m.productVariantId}" class="d-block p-2 border-bottom text-decoration-none text-dark">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="fw-semibold small">${m.productName}</div>
                                <div class="text-muted" style="font-size:.7rem;">${m.sizeName} · ${m.colorName}</div>
                            </div>
                            <div class="fw-bold ${m.trendPercentage >= 0 ? 'text-success' : 'text-danger'}">
                                ${m.trendPercentage >= 0 ? '+' : ''}${m.trendPercentage.toFixed(1)}%
                            </div>
                        </div>
                    </a>`).join('')).show();
            }, 300);
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('#productSearch, #searchDropdown')) $('#searchDropdown').hide();
        });
    </script>
}