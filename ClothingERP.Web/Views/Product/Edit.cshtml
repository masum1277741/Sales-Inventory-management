@model UpdateProductDto
@{
    ViewData["Title"]  = "Edit Product";
    var p              = (ProductDto)ViewBag.Product;
    var categories     = (IEnumerable<CategoryDto>)ViewBag.Categories;
    var subCategories  = (IEnumerable<SubCategoryDto>)ViewBag.SubCategories;
    var brands         = (IEnumerable<BrandDto>)ViewBag.Brands;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit — @p.Name</h4>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol></nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary">
            <i class="bi bi-layers me-1"></i>Manage Variants
        </a>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@p.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Basic Information</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-muted">SKU</label>
                            <input class="form-control bg-light font-monospace" value="@p.SKU" disabled />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select select2" onchange="loadSubCats(this.value)">
                                @foreach (var c in categories) {
                                    @if(c.Id==Model.CategoryId)
                                    {
                                        <option value="@c.Id" selected>@c.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SubCategoryId" class="form-label fw-semibold">Sub-Category <span class="text-danger">*</span></label>
                            <select asp-for="SubCategoryId" class="form-select select2" id="subCatSelect">
                                @foreach (var s in subCategories) {
                                    @if(s.Id==Model.SubCategoryId)
                                    {
                                        <option value="@s.Id" selected>@s.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BrandId" class="form-label fw-semibold">Brand <span class="text-danger">*</span></label>
                            <select asp-for="BrandId" class="form-select select2">
                                @foreach (var b in brands) {
                                    @if(b.Id==Model.BrandId)
                                    {
                                        <option value="@b.Id" selected>@b.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-currency-dollar me-2 text-success"></i>Pricing</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="CostPrice" class="form-label fw-semibold">Cost Price <span class="text-danger">*</span></label>
                            <div class="input-group"><span class="input-group-text bg-light">৳</span><input asp-for="CostPrice" class="form-control" type="number" step="0.01" /></div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RetailPrice" class="form-label fw-semibold">Retail Price <span class="text-danger">*</span></label>
                            <div class="input-group"><span class="input-group-text bg-light">৳</span><input asp-for="RetailPrice" class="form-control" type="number" step="0.01" /></div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WholesalePrice" class="form-label fw-semibold">Wholesale Price</label>
                            <div class="input-group"><span class="input-group-text bg-light">৳</span><input asp-for="WholesalePrice" class="form-control" type="number" step="0.01" /></div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SpecialPrice" class="form-label fw-semibold">Special Price</label>
                            <div class="input-group"><span class="input-group-text bg-light">৳</span><input asp-for="SpecialPrice" class="form-control" type="number" step="0.01" /></div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TaxRate" class="form-label fw-semibold">Tax Rate (%)</label>
                            <div class="input-group"><input asp-for="TaxRate" class="form-control" type="number" step="0.01" /><span class="input-group-text bg-light">%</span></div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReorderPoint" class="form-label fw-semibold">Reorder Point</label>
                            <input asp-for="ReorderPoint" class="form-control" type="number" min="0" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-image me-2 text-primary"></i>Product Image</span>
                </div>
                <div class="card-body p-4 text-center">
                    <div style="width:100%;height:180px;border:2px dashed #dee2e6;border-radius:12px;overflow:hidden;background:#fafafa;cursor:pointer;" onclick="$('#imgInput').click()">
                        <img id="imgPreview" src="@(Model.ImagePath ?? "")"
                             style="width:100%;height:100%;object-fit:contain;@(string.IsNullOrEmpty(Model.ImagePath)?"display:none;":"")" />
                        @if (string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div style="padding:40px 0;"><i class="bi bi-cloud-upload" style="font-size:2rem;color:#aaa;"></i><p class="text-muted small mt-2">Click to upload</p></div>
                        }
                    </div>
                    <input type="file" id="imgInput" name="productImage" accept="image/*" class="d-none"
                           onchange="previewImg(this)" />
                    <button type="button" class="btn btn-sm btn-light border mt-2" onclick="$('#imgInput').click()">
                        <i class="bi bi-camera me-1"></i>Change Image
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Product</label>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 d-grid gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Save Changes</button>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-light border">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
$(function() {
    $('select.form-select.select2').select2({ theme:'bootstrap-5', width:'100%' });
});
async function loadSubCats(catId) {
    if (!catId) return;
    const data = await fetch(`/Product/GetSubCategories/${catId}`).then(r => r.json());
    const opts = data.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
    $('#subCatSelect').html(opts).trigger('change');
}
function previewImg(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { $('#imgPreview').attr('src', e.target.result).show(); };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}