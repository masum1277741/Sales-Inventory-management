@model CreateProductDto
@{
    ViewData["Title"] = "Add Product";
    var categories = (IEnumerable<CategoryDto>)ViewBag.Categories;
    var subCategories = (IEnumerable<SubCategoryDto>)ViewBag.SubCategories;
    var brands = (IEnumerable<BrandDto>)ViewBag.Brands;
    var sizes = (IEnumerable<SizeDto>)ViewBag.Sizes;
    var colors = (IEnumerable<ColorDto>)ViewBag.Colors;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0"><i class="bi bi-plus-square me-2 text-primary"></i>Add New Product</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
                <li class="breadcrumb-item active">Add Product</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="variantsJson" name="variantsJson" />

    <div class="row g-4">
        <!-- ── Left Column ───────────────────────────────────────────────── -->
        <div class="col-lg-8">

            <!-- Basic Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Basic Information</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select select2" id="catSelect">
                                <option value="">— Select —</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SubCategoryId" class="form-label fw-semibold">Sub-Category <span class="text-danger">*</span></label>
                            <select asp-for="SubCategoryId" class="form-select select2" id="subCatSelect">
                                <option value="">— Select Category First —</option>
                                @foreach (var s in subCategories)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SubCategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BrandId" class="form-label fw-semibold">Brand <span class="text-danger">*</span></label>
                            <select asp-for="BrandId" class="form-select select2">
                                <option value="">— Select —</option>
                                @foreach (var b in brands)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional product description"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pricing -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-currency-dollar me-2 text-success"></i>Pricing & Settings</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="CostPrice" class="form-label fw-semibold">
                                Cost Price <span class="text-danger">*</span>
                                <span class="text-muted small ms-1">(USD)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-success">$</span>
                                <input asp-for="CostPrice" class="form-control" type="number"
                                       step="0.01" placeholder="0.00" id="CostPrice"
                                       oninput="convertFrom('CostPrice','USD')" />
                            </div>
                            <small id="currency-preview-CostPrice"
                                   class="text-muted d-none"
                                   style="font-size:.72rem;display:none;"></small>
                            <span asp-validation-for="CostPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RetailPrice" class="form-label fw-semibold">
                                Retail Price <span class="text-danger">*</span>
                                <span class="text-muted small ms-1">(USD)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-primary">$</span>
                                <input asp-for="RetailPrice" class="form-control" type="number"
                                       step="0.01" placeholder="0.00" id="RetailPrice"
                                       oninput="convertFrom('RetailPrice','USD')" />
                            </div>
                            <small id="currency-preview-RetailPrice"
                                   class="text-muted"
                                   style="font-size:.72rem;display:none;"></small>
                            <span asp-validation-for="RetailPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WholesalePrice" class="form-label fw-semibold">Wholesale Price
                                <span class="text-danger">*</span>
                                <span class="text-muted small ms-1">(USD)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">৳</span>
                                <input asp-for="WholesalePrice" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SpecialPrice" class="form-label fw-semibold">Special Price</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">৳</span>
                                <input asp-for="SpecialPrice" class="form-control" type="number" step="0.01" placeholder="Optional" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TaxRate" class="form-label fw-semibold">Tax Rate (%)</label>
                            <div class="input-group">
                                <input asp-for="TaxRate" class="form-control" type="number" step="0.01" placeholder="0" />
                                <span class="input-group-text bg-light">%</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReorderPoint" class="form-label fw-semibold">Reorder Point</label>
                            <input asp-for="ReorderPoint" class="form-control" type="number" value="5" min="0" />
                            <small class="text-muted">Low stock alert threshold</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Variants -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-layers me-2 text-primary"></i>Product Variants
                        <span class="badge bg-primary ms-1" id="varCount">0</span>
                    </span>
                    <small class="text-muted">Add size-color combinations</small>
                </div>
                <div class="card-body p-4">
                    <!-- Add Variant Row -->
                    <div class="row g-2 align-items-end mb-3 p-3 rounded" style="background:#f8f9ff;">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Size <span class="text-danger">*</span></label>
                            <select class="form-select select2-mini" id="varSize">
                                <option value="">Size</option>
                                @foreach (var s in sizes.OrderBy(x => x.SortOrder))
                                {
                                    <option value="@s.Id" data-name="@s.Name">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Color <span class="text-danger">*</span></label>
                            <select class="form-select select2-mini" id="varColor">
                                <option value="">Color</option>
                                @foreach (var c in colors.OrderBy(x => x.Name))
                                {
                                    <option value="@c.Id" data-name="@c.Name" data-hex="@c.HexCode">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold small">Cost Override</label>
                            <input type="number" class="form-control form-control-sm" id="varCost" placeholder="৳ Optional" step="0.01" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold small">Retail Override</label>
                            <input type="number" class="form-control form-control-sm" id="varRetail" placeholder="৳ Optional" step="0.01" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-success w-100" onclick="addVariant()">
                                <i class="bi bi-plus-lg me-1"></i>Add
                            </button>
                        </div>
                    </div>

                    <!-- Variants Table -->
                    <div class="table-responsive" id="variantsSection" style="display:none;">
                        <table class="table table-bordered table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Size</th>
                                    <th>Color</th>
                                    <th class="text-end">Cost Override</th>
                                    <th class="text-end">Retail Override</th>
                                    <th class="text-center" width="60">Remove</th>
                                </tr>
                            </thead>
                            <tbody id="variantsTbody"></tbody>
                        </table>
                    </div>

                    <p class="text-muted small mt-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Barcodes are auto-generated for each variant. Leave price overrides blank to use product's default price.
                    </p>
                </div>
            </div>
        </div>

        <!-- ── Right Column ──────────────────────────────────────────────── -->
        <div class="col-lg-4">

            <!-- Image Upload -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-image me-2 text-primary"></i>Product Image</span>
                </div>
                <div class="card-body p-4 text-center">
                    <div id="imgPreviewBox" style="width:100%;height:180px;border:2px dashed #dee2e6;border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;background:#fafafa;overflow:hidden;"
                         onclick="$('#imgInput').click()">
                        <div id="imgPlaceholder">
                            <i class="bi bi-cloud-upload" style="font-size:2rem;color:#aaa;"></i>
                            <p class="text-muted small mt-2 mb-0">Click to upload image</p>
                            <p class="text-muted" style="font-size:.7rem;">JPG, PNG, WEBP (max 2MB)</p>
                        </div>
                        <img id="imgPreview" src="" style="display:none;width:100%;height:100%;object-fit:contain;" />
                    </div>
                    <input type="file" id="imgInput" name="productImage" accept="image/*" class="d-none"
                           onchange="previewImg(this)" />
                    <button type="button" class="btn btn-sm btn-light border mt-2" onclick="$('#imgInput').click()">
                        <i class="bi bi-camera me-1"></i>Choose Image
                    </button>
                </div>
            </div>

            <!-- Settings -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold"><i class="bi bi-gear me-2 text-primary"></i>Settings</span>
                </div>
                <div class="card-body p-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Product</label>
                    </div>
                    <small class="text-muted">Inactive products won't appear in sales</small>
                </div>
            </div>

            <!-- Save -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Create Product
                    </button>
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            // ── Select2 Initialize ────────────────────────────────────────────────
            $('#catSelect').select2({ theme: 'bootstrap-5', width: '100%' });
            $('#subCatSelect').select2({ theme: 'bootstrap-5', width: '100%' });
            $('[name="BrandId"]').select2({ theme: 'bootstrap-5', width: '100%' });
            $('.select2-mini').select2({ theme: 'bootstrap-5', width: '100%' });

       
            $('#catSelect').on('change', function () {
                loadSubCats($(this).val());
            });
        });

        // ── Sub-category dynamic load ─────────────────────────────────────────────
        async function loadSubCats(catId) {
            const $sub = $('#subCatSelect');

          
            $sub.empty().append('<option value="">Loading...</option>').trigger('change');

            if (!catId) {
                $sub.empty()
                    .append('<option value="">— Select Category First —</option>')
                    .trigger('change');
                return;
            }

            try {
           
                const res  = await fetch(`/Product/GetSubCategories?categoryId=${encodeURIComponent(catId)}`);

                if (!res.ok) throw new Error('Network error: ' + res.status);

                const data = await res.json();

          
                $sub.empty().append('<option value="">— Select Sub-Category —</option>');

                if (data.length === 0) {
                    $sub.append('<option value="" disabled>No sub-categories found</option>');
                } else {
                    data.forEach(s => {
                     
                        $sub.append(new Option(s.name, s.id));
                    });
                }

                $sub.trigger('change');

            } catch (err) {
                console.error('SubCategory load error:', err);
                $sub.empty()
                    .append('<option value="">— Error loading sub-categories —</option>')
                    .trigger('change');
                toastr.error('Failed to load sub-categories');
            }
        }

        // ── Image Preview ─────────────────────────────────────────────────────────
        function previewImg(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    $('#imgPreview').attr('src', e.target.result).show();
                    $('#imgPlaceholder').hide();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ── Variants ──────────────────────────────────────────────────────────────
        const variants = [];

        function addVariant() {
            const sizeEl    = document.getElementById('varSize');
            const colorEl   = document.getElementById('varColor');
            const sizeId    = parseInt(sizeEl.value);
            const colorId   = parseInt(colorEl.value);
            const sizeName  = sizeEl.options[sizeEl.selectedIndex]?.getAttribute('data-name');
            const colorName = colorEl.options[colorEl.selectedIndex]?.getAttribute('data-name');
            const colorHex  = colorEl.options[colorEl.selectedIndex]?.getAttribute('data-hex');
            const cost      = parseFloat($('#varCost').val())   || null;
            const retail    = parseFloat($('#varRetail').val()) || null;

            if (!sizeId || !colorId) { toastr.warning('Select both Size and Color.'); return; }

            if (variants.some(v => v.sizeId === sizeId && v.colorId === colorId)) {
                toastr.error('This Size + Color combination already added.');
                return;
            }

            variants.push({
                sizeId, colorId, sizeName, colorName, colorHex,
                costPriceOverride:   cost,
                retailPriceOverride: retail
            });
            renderVariants();
            $('#varCost, #varRetail').val('');
        }

        function removeVariant(idx) {
            variants.splice(idx, 1);
            renderVariants();
        }

        function renderVariants() {
            const tbody = $('#variantsTbody');
            tbody.empty();

            variants.forEach((v, i) => {
                tbody.append(`
                    <tr>
                        <td><span class="badge bg-secondary">${v.sizeName}</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:16px;height:16px;border-radius:4px;
                                            background:${v.colorHex || '#ccc'};
                                            border:1px solid #dee2e6;"></div>
                                ${v.colorName}
                            </div>
                        </td>
                        <td class="text-end small">
                            ${v.costPriceOverride
                                ? '৳' + v.costPriceOverride
                                : '<span class="text-muted">Default</span>'}
                        </td>
                        <td class="text-end small">
                            ${v.retailPriceOverride
                                ? '৳' + v.retailPriceOverride
                                : '<span class="text-muted">Default</span>'}
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    onclick="removeVariant(${i})">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>`);
            });

            $('#varCount').text(variants.length);
            $('#variantsSection').toggle(variants.length > 0);

            // Hidden field update 
            $('#variantsJson').val(JSON.stringify(
                variants.map(v => ({
                    sizeId:              v.sizeId,
                    colorId:             v.colorId,
                    costPriceOverride:   v.costPriceOverride,
                    retailPriceOverride: v.retailPriceOverride
                }))
            ));
        }
    
        const RATE_BDT = @(ViewBag.RateBDT ?? 110m);
        const RATE_MVR = @(ViewBag.RateMVR ?? 15.42m);

        // ══ Converters ════════════════════════════════════════════════════
        function convertFrom(sourceField, sourceCurrency) {
            const val = parseFloat(document.getElementById(sourceField).value) || 0;

            let usd, bdt, mvr;
            if (sourceCurrency === 'USD') {
                usd = val;
                bdt = val * RATE_BDT;
                mvr = val * RATE_MVR;
            } else if (sourceCurrency === 'BDT') {
                usd = val / RATE_BDT;
                bdt = val;
                mvr = usd * RATE_MVR;
            } else { // MVR
                usd = val / RATE_MVR;
                bdt = usd * RATE_BDT;
                mvr = val;
            }

            const display = document.getElementById('currency-preview-' + sourceField);
            if (display) {
                const others = [];
                if (sourceCurrency !== 'USD') others.push(`$${usd.toFixed(2)}`);
                if (sourceCurrency !== 'BDT') others.push(`৳${bdt.toFixed(0)}`);
                if (sourceCurrency !== 'MVR') others.push(`Rf${mvr.toFixed(2)}`);
                display.textContent = others.join(' / ');
                display.style.display = val > 0 ? 'block' : 'none';
            }
        }
    </script>
}